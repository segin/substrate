# libFuzzer dictionary for libdemangle.
#
# Format: each line is `name="token"` where `name` is just a label
# (libfuzzer ignores it) and `token` is the byte sequence to inject.
# Mutation operators that pick from the dictionary will splice these
# in, dramatically increasing the rate at which the fuzzer constructs
# inputs that drive into deep parser branches.
#
# Coverage targets: the small alphabet of grammar codes for each of
# the three schemes the dispatcher can route to.

# ---- Scheme prefixes ---------------------------------------------------
prefix_itanium="_Z"
prefix_itanium_nested="_ZN"
prefix_rust_v0="_R"
prefix_rust_legacy_n="_ZN"
prefix_rust_legacy_h="17h"
prefix_rust_legacy_close="E"
prefix_dlang="_D"
prefix_dlang_runtime="_d_"
prefix_objc_method=" -["
prefix_objc_class=" +["

# ---- Itanium C++ ABI grammar codes -------------------------------------
itanium_pointer="P"
itanium_lvalue_ref="R"
itanium_rvalue_ref="O"
itanium_const="K"
itanium_volatile="V"
itanium_restrict="r"
itanium_array="A"
itanium_function="F"
itanium_member_ptr="M"
itanium_complex="C"
itanium_imaginary="G"
itanium_substitution="S_"
itanium_substitution_indexed="S0_"
itanium_substitution_std="St"
itanium_substitution_alloc="Sa"
itanium_substitution_basic_string="Sb"
itanium_substitution_string="Ss"
itanium_substitution_istream="Si"
itanium_substitution_ostream="So"
itanium_substitution_iostream="Sd"
itanium_template_param="T_"
itanium_template_param0="T0_"
itanium_template_args_open="I"
itanium_template_args_close="E"
itanium_pack_open="J"
itanium_pack_close="E"
itanium_decltype="Dt"
itanium_pack_expansion="Dp"
itanium_lambda="Ul"
itanium_unnamed="Ut"
itanium_local_name="Z"
itanium_special_vtable="TV"
itanium_special_vtt="TT"
itanium_special_typeinfo="TI"
itanium_special_typeinfo_name="TS"
itanium_ctor_complete="C1"
itanium_ctor_base="C2"
itanium_dtor_complete="D1"
itanium_dtor_base="D2"

# Itanium primitive type letters
itanium_void="v"
itanium_int="i"
itanium_uint="j"
itanium_long="l"
itanium_ulong="m"
itanium_longlong="x"
itanium_ulonglong="y"
itanium_int128="n"
itanium_uint128="o"
itanium_short="s"
itanium_ushort="t"
itanium_char="c"
itanium_schar="a"
itanium_uchar="h"
itanium_bool="b"
itanium_float="f"
itanium_double="d"
itanium_long_double="e"
itanium_float128="g"
itanium_wchar_t="w"
itanium_char32="Di"
itanium_char16="Ds"
itanium_char8="Du"
itanium_nullptr="Dn"
itanium_ellipsis="z"

# Itanium operators (a representative spread)
itanium_op_new="nw"
itanium_op_delete="dl"
itanium_op_plus="pl"
itanium_op_minus="mi"
itanium_op_multiply="ml"
itanium_op_divide="dv"
itanium_op_mod="rm"
itanium_op_arrow="pt"
itanium_op_subscript="ix"
itanium_op_call="cl"
itanium_op_assign="aS"
itanium_op_eq="eq"
itanium_op_lt="lt"

# Common short symbol names
itanium_name_main="4main"
itanium_name_stdvec="3std"

# ---- Rust v0 grammar codes (RFC 2603) ----------------------------------
rust_v0_namespace_value="N"
rust_v0_namespace_type="t"
rust_v0_namespace_closure="C"
rust_v0_namespace_shim="S"
rust_v0_namespace_named="N"
rust_v0_inherent_impl="M"
rust_v0_trait_impl="X"
rust_v0_trait_def="Y"
rust_v0_generic="I"
rust_v0_end="E"
rust_v0_underscore="_"
rust_v0_punycode="u"
rust_v0_disambiguator_s="s"
rust_v0_lifetime="L"
rust_v0_anon_lifetime="L_"
rust_v0_backref="B"
rust_v0_backref0="B_"
rust_v0_const="K"
rust_v0_str="e"
rust_v0_array="A"
rust_v0_slice="S"
rust_v0_tuple_open="T"
rust_v0_ref="R"
rust_v0_mut_ref="Q"
rust_v0_ptr_const="P"
rust_v0_ptr_mut="O"
rust_v0_func="F"
rust_v0_dyn_trait="D"
rust_v0_continued="L"
rust_v0_namespace_static="V"

# Rust v0 primitive types
rust_v0_bool="b"
rust_v0_char="c"
rust_v0_str_prim="e"
rust_v0_unit="u"
rust_v0_isize="i"
rust_v0_i8="a"
rust_v0_i16="s"
rust_v0_i32="l"
rust_v0_i64="x"
rust_v0_i128="n"
rust_v0_usize="j"
rust_v0_u8="h"
rust_v0_u16="t"
rust_v0_u32="m"
rust_v0_u64="y"
rust_v0_u128="o"
rust_v0_f32="f"
rust_v0_f64="d"
rust_v0_never="z"
rust_v0_placeholder="p"

# ---- D language grammar codes ------------------------------------------
dlang_template_open="__T"
dlang_template_arg_type="T"
dlang_template_arg_value="V"
dlang_template_arg_symbol="S"
dlang_template_arg_tuple="X"
dlang_template_arg_variadic="Y"
dlang_template_close="Z"
dlang_qualifier_const="C"
dlang_qualifier_immutable="y"
dlang_qualifier_shared="O"
dlang_qualifier_inout="N"
dlang_function="F"
dlang_function_p="P"
dlang_function_d="D"
dlang_function_y="Y"
dlang_function_z="Z"
dlang_attr_pure="N"
dlang_attr_nothrow="N"
dlang_attr_property="N"
dlang_attr_safe="N"
dlang_typeinfo="T"
dlang_classinfo="__ClassZ"
dlang_vtable="__vtblZ"
dlang_init="__initZ"
dlang_modctor="__modctor"
dlang_moddtor="__moddtor"
dlang_back_ref="Q"
dlang_lambda="__lambda"
dlang_unittest="__unittest"
dlang_aggr="__aggr"

# D primitive types
dlang_void="v"
dlang_byte="g"
dlang_ubyte="h"
dlang_short="s"
dlang_ushort="t"
dlang_int="i"
dlang_uint="k"
dlang_long="l"
dlang_ulong="m"
dlang_cent="c"
dlang_ucent="u"
dlang_float="f"
dlang_double="d"
dlang_real="e"
dlang_bool="b"
dlang_char="a"
dlang_wchar="u"
dlang_dchar="w"

# ---- Common length-prefix patterns -------------------------------------
length_1="1"
length_3="3"
length_5="5"
length_8="8"
length_10="10"
length_16="16"
length_24="24"
length_32="32"
length_huge="999"
length_overflow="99999999999999999999"

# ---- Rust legacy escapes ($u20$ → space, $LT$ → <, etc.) --------------
escape_lt="$LT$"
escape_gt="$GT$"
escape_lp="$LP$"
escape_rp="$RP$"
escape_amp="$BP$"
escape_space="$u20$"
escape_dollar="$RF$"
escape_dot=".."

# ---- Common identifier fragments ---------------------------------------
ident_std="3std"
ident_core="4core"
ident_alloc="5alloc"
ident_main="4main"
ident_test="4test"
