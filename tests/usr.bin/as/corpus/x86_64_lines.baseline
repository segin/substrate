# Lines of x86_64_lines.txt that this assembler and GNU as assemble differently.
# Written by gnu-diff.py --write-baseline; see test_gnu_differential.sh.
.L1: | movq .L1(%rip),%rax
.data | lv: .long 0 | .text | movl lv(%rip),%eax
.data | .long 0 | lv: .long 0 | .text | movl $5,lv(%rip)
.data | .long 0 | lv: .long 0 | .text | movq $lv,%rax
.data | .long 0 | lv: .long 0 | .text | movabs $lv,%rax
.data | .long 0 | lv: .long 0 | .text | call lv
.section .rodata | .long 0 | lv: .long 0 | .text | leaq lv+4(%rip),%rax
int $sym
ret $sym
in $sym,%al
out %al,$sym
