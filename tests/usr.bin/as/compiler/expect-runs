# The combinations of test_compiler_output.sh that must run: one to a
# line, written as the test prints it ("-m64 -O2").  A line is added when
# its combination runs both here and on the CI host, and is never taken
# out to make the test pass.
#
# All of 64 bits, and of 32 bits what is not optimised.
-m32 -O0
-m64 -O0
-m64 -O1
-m64 -O2
-m64 -Os
-m64 -O2 -fPIC
-m64 -O2 -fno-pie -fno-asynchronous-unwind-tables
-m64 -O2 -fno-pie -msse2 -mfpmath=sse
-m64 -O2 -fcf-protection=full
-m64 -O2 -fcf-protection=none
