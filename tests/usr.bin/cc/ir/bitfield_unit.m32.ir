module "ir/bitfield_unit.c" {
  target ilp32;
  stage legal;

  func @set_b : fn(i32, i32) -> i64 {
  entry:
    %v0 = param i32 0;
    %v1 = param i32 1;
    %v2 = stackalloc i32 4;
    store i32 4, %v0, %v2;
    %v3 = stackalloc i32 4;
    store i32 4, %v1, %v3;
    %v4 = load i32 4, %v3;
    %v5 = zload i32 4, %v2;
    %v6 = const i32 1;
    %v7 = add i32 %v5, %v6;
    %v8 = const i32 7;
    %v9 = and i32 %v4, %v8;
    %v10 = zload i8 1, %v7;
    %v11 = const i32 -8;
    %v12 = and i32 %v10, %v11;
    %v13 = or i32 %v12, %v9;
    store i32 1, %v13, %v7;
    %v14 = zload i8 1, %v7;
    %v15 = const i32 7;
    %v16 = and i32 %v14, %v15;
    %v17 = shl i32 %v16, 29;
    %v18 = ashr i32 %v17, 29;
    %v19 = const i32 0;
    ret i32 %v19;
  }

  func @set_f : fn(i32, i32) -> i64 {
  entry:
    %v0 = param i32 0;
    %v1 = param i32 1;
    %v2 = stackalloc i32 4;
    store i32 4, %v0, %v2;
    %v3 = stackalloc i32 4;
    %v4 = const i32 4294967295;
    %v5 = and i32 %v1, %v4;
    store i32 4, %v5, %v3;
    %v6 = zload i32 4, %v3;
    %v7 = zload i32 4, %v2;
    %v8 = const i32 1;
    %v9 = add i32 %v7, %v8;
    %v10 = const i32 4294967295;
    %v11 = and i32 %v6, %v10;
    %v12 = const i32 255;
    %v13 = and i32 %v11, %v12;
    %v14 = zload i8 1, %v9;
    %v15 = const i32 -256;
    %v16 = and i32 %v14, %v15;
    %v17 = or i32 %v16, %v13;
    store i32 1, %v17, %v9;
    %v18 = zload i8 1, %v9;
    %v19 = const i32 255;
    %v20 = and i32 %v18, %v19;
    %v21 = const i32 4294967295;
    %v22 = and i32 %v20, %v21;
    %v23 = const i32 0;
    ret i32 %v23;
  }

  func @set_g : fn(i32, i32) -> i64 {
  entry:
    %v0 = param i32 0;
    %v1 = param i32 1;
    %v2 = stackalloc i32 4;
    store i32 4, %v0, %v2;
    %v3 = stackalloc i32 4;
    %v4 = const i32 4294967295;
    %v5 = and i32 %v1, %v4;
    store i32 4, %v5, %v3;
    %v6 = zload i32 4, %v3;
    %v7 = zload i32 4, %v2;
    %v8 = const i32 2;
    %v9 = add i32 %v7, %v8;
    %v10 = const i32 4294967295;
    %v11 = and i32 %v6, %v10;
    %v12 = const i32 4095;
    %v13 = and i32 %v11, %v12;
    %v14 = zload i16 2, %v9;
    %v15 = const i32 -4096;
    %v16 = and i32 %v14, %v15;
    %v17 = or i32 %v16, %v13;
    store i32 2, %v17, %v9;
    %v18 = zload i16 2, %v9;
    %v19 = const i32 4095;
    %v20 = and i32 %v18, %v19;
    %v21 = const i32 4294967295;
    %v22 = and i32 %v20, %v21;
    %v23 = const i32 0;
    ret i32 %v23;
  }

  func @get_b : fn(i32) -> i64 {
  entry:
    %v0 = param i32 0;
    %v1 = stackalloc i32 4;
    store i32 4, %v0, %v1;
    %v2 = zload i32 4, %v1;
    %v3 = const i32 1;
    %v4 = add i32 %v2, %v3;
    %v5 = zload i8 1, %v4;
    %v6 = const i32 7;
    %v7 = and i32 %v5, %v6;
    %v8 = shl i32 %v7, 29;
    %v9 = ashr i32 %v8, 29;
    ret i32 %v9;
  }
}
