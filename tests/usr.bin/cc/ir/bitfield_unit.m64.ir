module "ir/bitfield_unit.c" {
  target lp64;
  stage legal;

  func @set_b : fn(i64, i32) -> i64 {
  entry:
    %v0 = param i64 0;
    %v1 = param i32 1;
    %v2 = stackalloc i64 8;
    store i64 8, %v0, %v2;
    %v3 = stackalloc i64 4;
    %v4 = shl i64 %v1, 32;
    %v5 = ashr i32 %v4, 32;
    store i32 4, %v5, %v3;
    %v6 = load i32 4, %v3;
    %v7 = zload i64 8, %v2;
    %v8 = const i64 1;
    %v9 = add i64 %v7, %v8;
    %v10 = shl i64 %v6, 32;
    %v11 = ashr i32 %v10, 32;
    %v12 = const i64 7;
    %v13 = and i64 %v11, %v12;
    %v14 = zload i8 1, %v9;
    %v15 = const i64 -8;
    %v16 = and i64 %v14, %v15;
    %v17 = or i64 %v16, %v13;
    store i64 1, %v17, %v9;
    %v18 = zload i8 1, %v9;
    %v19 = const i64 7;
    %v20 = and i64 %v18, %v19;
    %v21 = shl i64 %v20, 61;
    %v22 = ashr i64 %v21, 61;
    %v23 = shl i64 %v22, 32;
    %v24 = ashr i32 %v23, 32;
    ret void;
  }

  func @set_f : fn(i64, i32) -> i64 {
  entry:
    %v5 = undef i32;
    %v11 = undef i32;
    %v0 = param i64 0;
    %v1 = param i32 1;
    %v2 = stackalloc i64 8;
    store i64 8, %v0, %v2;
    %v3 = stackalloc i64 4;
    %v4 = const i64 4294967295;
    set i32 %v5, %v1;
    store i32 4, %v5, %v3;
    %v6 = zload i32 4, %v3;
    %v7 = zload i64 8, %v2;
    %v8 = const i64 1;
    %v9 = add i64 %v7, %v8;
    %v10 = const i64 4294967295;
    set i32 %v11, %v6;
    %v12 = const i64 255;
    %v13 = and i64 %v11, %v12;
    %v14 = zload i8 1, %v9;
    %v15 = const i64 -256;
    %v16 = and i64 %v14, %v15;
    %v17 = or i64 %v16, %v13;
    store i64 1, %v17, %v9;
    %v18 = zload i8 1, %v9;
    %v19 = const i64 255;
    %v20 = and i64 %v18, %v19;
    %v21 = const i64 4294967295;
    %v22 = and i32 %v20, %v21;
    ret void;
  }

  func @set_g : fn(i64, i32) -> i64 {
  entry:
    %v5 = undef i32;
    %v11 = undef i32;
    %v0 = param i64 0;
    %v1 = param i32 1;
    %v2 = stackalloc i64 8;
    store i64 8, %v0, %v2;
    %v3 = stackalloc i64 4;
    %v4 = const i64 4294967295;
    set i32 %v5, %v1;
    store i32 4, %v5, %v3;
    %v6 = zload i32 4, %v3;
    %v7 = zload i64 8, %v2;
    %v8 = const i64 2;
    %v9 = add i64 %v7, %v8;
    %v10 = const i64 4294967295;
    set i32 %v11, %v6;
    %v12 = const i64 4095;
    %v13 = and i64 %v11, %v12;
    %v14 = zload i16 2, %v9;
    %v15 = const i64 -4096;
    %v16 = and i64 %v14, %v15;
    %v17 = or i64 %v16, %v13;
    store i64 2, %v17, %v9;
    %v18 = zload i16 2, %v9;
    %v19 = const i64 4095;
    %v20 = and i64 %v18, %v19;
    %v21 = const i64 4294967295;
    %v22 = and i32 %v20, %v21;
    ret void;
  }

  func @get_b : fn(i64) -> i64 {
  entry:
    %v0 = param i64 0;
    %v1 = stackalloc i64 8;
    store i64 8, %v0, %v1;
    %v2 = zload i64 8, %v1;
    %v3 = const i64 1;
    %v4 = add i64 %v2, %v3;
    %v5 = zload i8 1, %v4;
    %v6 = const i64 7;
    %v7 = and i64 %v5, %v6;
    %v8 = shl i64 %v7, 61;
    %v9 = ashr i64 %v8, 61;
    %v10 = shl i64 %v9, 32;
    %v11 = ashr i32 %v10, 32;
