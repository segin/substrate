module "ir/arith.c" {
  target lp64;
  stage legal;

  func @narrow : fn(i32, i32) -> i64 {
  entry:
    %v0 = param i32 0;
    %v1 = param i32 1;
    %v2 = stackalloc i64 4;
    %v3 = shl i64 %v0, 32;
    %v4 = ashr i32 %v3, 32;
    store i32 4, %v4, %v2;
    %v5 = stackalloc i64 4;
    %v6 = shl i64 %v1, 32;
    %v7 = ashr i32 %v6, 32;
    store i32 4, %v7, %v5;
    %v8 = load i32 4, %v2;
    %v9 = load i32 4, %v5;
    %v10 = shl i64 %v8, 32;
    %v11 = ashr i32 %v10, 32;
    %v12 = shl i64 %v9, 32;
    %v13 = ashr i32 %v12, 32;
    %v14 = mul i64 %v11, %v13;
    %v15 = shl i64 %v14, 32;
    %v16 = ashr i32 %v15, 32;
    %v17 = const i32 7;
    %v18 = shl i64 %v16, 32;
    %v19 = ashr i32 %v18, 32;
    %v20 = shl i64 %v17, 32;
    %v21 = ashr i32 %v20, 32;
    %v22 = add i64 %v19, %v21;
    %v23 = shl i64 %v22, 32;
    %v24 = ashr i32 %v23, 32;
    %v25 = const i64 255;
    %v26 = and i8 %v24, %v25;
    %v27 = const i64 255;
    %v28 = and i8 %v26, %v27;
    ret i8 %v28;
  }

  func @shifts : fn(i32, i32) -> i64 {
  entry:
    %v0 = param i32 0;
    %v1 = param i32 1;
    %v2 = stackalloc i64 4;
    %v3 = shl i64 %v0, 32;
    %v4 = ashr i32 %v3, 32;
    store i32 4, %v4, %v2;
    %v5 = stackalloc i64 4;
    %v6 = const i64 4294967295;
    %v7 = and i32 %v1, %v6;
    store i32 4, %v7, %v5;
    %v8 = load i32 4, %v2;
    %v9 = const i32 3;
    %v10 = shl i64 %v8, 32;
    %v11 = ashr i32 %v10, 32;
    %v12 = shl i64 %v9, 32;
    %v13 = ashr i32 %v12, 32;
    %v14 = shl i64 %v11, %v13;
    %v15 = shl i64 %v14, 32;
    %v16 = ashr i32 %v15, 32;
    %v17 = zload i32 4, %v5;
    %v18 = const i32 2;
    %v19 = const i64 4294967295;
    %v20 = and i32 %v17, %v19;
    %v21 = const i64 4294967295;
    %v22 = and i32 %v18, %v21;
    %v23 = lshr i64 %v20, %v22;
    %v24 = const i64 4294967295;
    %v25 = and i32 %v23, %v24;
    %v26 = shl i64 %v25, 32;
    %v27 = ashr i32 %v26, 32;
    %v28 = shl i64 %v16, 32;
    %v29 = ashr i32 %v28, 32;
    %v30 = shl i64 %v27, 32;
    %v31 = ashr i32 %v30, 32;
    %v32 = add i64 %v29, %v31;
    %v33 = shl i64 %v32, 32;
    %v34 = ashr i32 %v33, 32;
    %v35 = load i32 4, %v2;
    %v36 = const i32 1;
    %v37 = shl i64 %v35, 32;
    %v38 = ashr i32 %v37, 32;
    %v39 = shl i64 %v36, 32;
    %v40 = ashr i32 %v39, 32;
    %v41 = ashr i64 %v38, %v40;
    %v42 = shl i64 %v41, 32;
    %v43 = ashr i32 %v42, 32;
    %v44 = shl i64 %v34, 32;
    %v45 = ashr i32 %v44, 32;
    %v46 = shl i64 %v43, 32;
    %v47 = ashr i32 %v46, 32;
    %v48 = add i64 %v45, %v47;
    %v49 = shl i64 %v48, 32;
    %v50 = ashr i32 %v49, 32;
    %v51 = shl i64 %v50, 32;
    %v52 = ashr i32 %v51, 32;
    ret i32 %v52;
  }

  func @cmp : fn(i32, i32, i64) -> i64 {
  entry:
    %v0 = param i32 0;
    %v1 = param i32 1;
    %v2 = param i64 2;
    %v3 = stackalloc i64 4;
    %v4 = shl i64 %v0, 32;
    %v5 = ashr i32 %v4, 32;
    store i32 4, %v5, %v3;
    %v6 = stackalloc i64 4;
    %v7 = const i64 4294967295;
    %v8 = and i32 %v1, %v7;
    store i32 4, %v8, %v6;
    %v9 = stackalloc i64 8;
    store i64 8, %v2, %v9;
    %v10 = load i32 4, %v3;
    %v11 = const i32 0;
    %v12 = shl i64 %v10, 32;
    %v13 = ashr i32 %v12, 32;
    %v14 = shl i64 %v11, 32;
    %v15 = ashr i32 %v14, 32;
    %v16 = icmp slt i32 %v13, %v15;
    %v17 = zload i32 4, %v6;
    %v18 = const i32 5;
    %v19 = const i64 4294967295;
    %v20 = and i32 %v17, %v19;
    %v21 = const i64 4294967295;
    %v22 = and i32 %v18, %v21;
    %v23 = icmp ult i32 %v20, %v22;
    %v24 = shl i64 %v16, 32;
    %v25 = ashr i32 %v24, 32;
    %v26 = shl i64 %v23, 32;
    %v27 = ashr i32 %v26, 32;
    %v28 = add i64 %v25, %v27;
    %v29 = shl i64 %v28, 32;
    %v30 = ashr i32 %v29, 32;
    %v31 = load i64 8, %v9;
    %v32 = load i32 4, %v3;
    %v33 = shl i64 %v32, 32;
    %v34 = ashr i64 %v33, 32;
    %v35 = icmp sge i64 %v31, %v34;
    %v36 = shl i64 %v30, 32;
    %v37 = ashr i32 %v36, 32;
    %v38 = shl i64 %v35, 32;
    %v39 = ashr i32 %v38, 32;
    %v40 = add i64 %v37, %v39;
    %v41 = shl i64 %v40, 32;
    %v42 = ashr i32 %v41, 32;
    %v43 = shl i64 %v42, 32;
    %v44 = ashr i32 %v43, 32;
    ret i32 %v44;
  }
}
