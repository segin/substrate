module "ir/calls.c" {
  target lp64;
  stage legal;

  func @twice : fn(i32) -> i64 {
  entry:
    %v0 = param i32 0;
    %v1 = stackalloc i64 4;
    %v2 = shl i64 %v0, 32;
    %v3 = ashr i32 %v2, 32;
    store i32 4, %v3, %v1;
    %v4 = load i32 4, %v1;
    %v5 = load i32 4, %v1;
    %v6 = shl i64 %v4, 32;
    %v7 = ashr i32 %v6, 32;
    %v8 = shl i64 %v5, 32;
    %v9 = ashr i32 %v8, 32;
    %v10 = add i64 %v7, %v9;
    %v11 = shl i64 %v10, 32;
    %v12 = ashr i32 %v11, 32;
    %v13 = shl i64 %v12, 32;
    %v14 = ashr i32 %v13, 32;
    ret i32 %v14;
  }

  func @calls : fn(i64, i32) -> i64 {
  entry:
    %v0 = param i64 0;
    %v1 = param i32 1;
    %v2 = stackalloc i64 8;
    store i64 8, %v0, %v2;
    %v3 = stackalloc i64 4;
    %v4 = shl i64 %v1, 32;
    %v5 = ashr i32 %v4, 32;
    store i32 4, %v5, %v3;
    %v6 = str i64 "\22\5c045\5c144\5c012\22";
    %v7 = load i32 4, %v3;
    %v8 = call.va i32 @printf(%v6, %v7);
    %v9 = load i32 4, %v3;
    %v10 = shl i64 %v9, 32;
    %v11 = ashr i32 %v10, 32;
    %v12 = call i32 @twice(%v11);
    %v13 = zload i64 8, %v2;
    %v14 = load i32 4, %v3;
    %v15 = call.va i32 %v13(%v14);
    %v16 = load i32 4, %v3;
    %v17 = shl i64 %v16, 32;
    %v18 = ashr i32 %v17, 32;
    %v19 = call i32 @twice(%v18);
    %v20 = shl i64 %v15, 32;
    %v21 = ashr i32 %v20, 32;
    %v22 = shl i64 %v19, 32;
    %v23 = ashr i32 %v22, 32;
    %v24 = add i64 %v21, %v23;
    %v25 = shl i64 %v24, 32;
    %v26 = ashr i32 %v25, 32;
    %v27 = shl i64 %v26, 32;
    %v28 = ashr i32 %v27, 32;
    ret i32 %v28;
  }
}
