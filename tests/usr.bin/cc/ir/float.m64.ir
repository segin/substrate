module "ir/float.c" {
  target lp64;

  func @avg : fn(i32, i32) -> f64 {
  entry:
    %v0 = param i32 0;
    %v1 = param i32 1;
    %v2 = stackalloc i64 4;
    %v3 = shl i64 %v0, 32;
    %v4 = ashr i32 %v3, 32;
    store i32 4, %v4, %v2;
    %v5 = stackalloc i64 4;
    %v6 = shl i64 %v1, 32;
    %v7 = ashr i32 %v6, 32;
    store i32 4, %v7, %v5;
    %v8 = load i32 4, %v2;
    %v9 = load i32 4, %v5;
    %v10 = shl i64 %v8, 32;
    %v11 = ashr i32 %v10, 32;
    %v12 = shl i64 %v9, 32;
    %v13 = ashr i32 %v12, 32;
    %v14 = add i64 %v11, %v13;
    %v15 = shl i64 %v14, 32;
    %v16 = ashr i32 %v15, 32;
    %v17 = sitofp f64 %v16;
    %v18 = fconst f64 2;
    %v19 = fdiv f64 %v17, %v18;
    ret f64 %v19;
  }

  func @trunc_f : fn(f32) -> i64 {
  entry:
    %v0 = param f32 0;
    %v1 = stackalloc i64 4;
    %v2 = fround32 f64 %v0;
    store f64 4, %v2, %v1;
    %v3 = load f32 4, %v1;
    %v4 = fptosi i64 %v3;
    %v5 = shl i64 %v4, 32;
    %v6 = ashr i32 %v5, 32;
    %v7 = shl i64 %v6, 32;
    %v8 = ashr i32 %v7, 32;
    ret i32 %v8;
  }

  func @to_ul : fn(f64) -> i64 {
  entry:
    %v0 = param f64 0;
    %v1 = stackalloc i64 8;
    store f64 8, %v0, %v1;
    %v2 = load f64 8, %v1;
    %v3 = fptoui i64 %v2;
    ret i64 %v3;
  }

  func @fless : fn(f64, f32) -> i64 {
  entry:
    %v0 = param f64 0;
    %v1 = param f32 1;
    %v2 = stackalloc i64 8;
    store f64 8, %v0, %v2;
    %v3 = stackalloc i64 4;
    %v4 = fround32 f64 %v1;
    store f64 4, %v4, %v3;
    %v5 = load f64 8, %v2;
    %v6 = load f32 4, %v3;
    %v7 = fcmp olt f64 %v5, %v6;
    %v8 = shl i64 %v7, 32;
    %v9 = ashr i32 %v8, 32;
    ret i32 %v9;
  }
}
