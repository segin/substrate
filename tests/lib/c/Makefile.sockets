# tests/lib/sockets/Makefile
#
# Portable POSIX test program for AF_UNIX SOCK_STREAM.  Builds and
# runs on Linux / FreeBSD / macOS with the host toolchain; cross-
# builds against substrate's libc + libpthread when CROSS is set.
#
# Host build (default):
#     make
#     ./torture_unix
#
# Substrate cross build (drops binary at ./torture_unix and is
# picked up by build-rootfs.sh for /tmp on the image):
#     make CROSS=/opt/substrate/bin/i386-unknown-substrate-

CROSS  ?=
# Substrate's stage-1 toolchain ships $(CROSS)gcc; host toolchains
# usually have plain `cc`.  Pick the right driver automatically.
ifeq ($(CROSS),)
  CC      = cc
else
  CC      = $(CROSS)gcc
endif
CFLAGS  = -Wall -Wextra -O2 -g

# Substrate cross-build: match the userland baseline (i486+) so
# 4-byte atomics inline rather than calling __sync_*_4 stubs that
# substrate libgcc.a doesn't ship.  Force dynamic linking against
# libpthread.so.0 — same rationale as tests/lib/pthread/Makefile.
ifneq ($(CROSS),)
  CFLAGS += -march=i486 -mtune=i486
  LDFLAGS += -Wl,--copy-dt-needed-entries -Wl,-rpath-link,/opt/substrate/i386-unknown-substrate/lib
  PTHREAD = -L../../../lib/pthread -l:libpthread.so.0
  # -I../../../sys is needed because <sys/syscall.h> in our
  # userspace tree pulls in <arch/i386/syscall.h>, which lives at
  # sys/arch/i386/syscall.h (shared between kernel and userland).
  PTHREAD_INC = -I../../../include -I../../../sys -I../../../lib/pthread
else
  PTHREAD = -pthread
  PTHREAD_INC =
endif

TESTS = torture_unix torture_afunix_poll torture_malloc torture_evdev \
        torture_x11_shape torture_sigalrm torture_heap_stdio

all: $(TESTS)

torture_unix: torture_unix.c
	$(CC) $(CFLAGS) $(LDFLAGS) $(PTHREAD_INC) $< $(PTHREAD) -o $@

torture_afunix_poll: torture_afunix_poll.c
	$(CC) $(CFLAGS) $(LDFLAGS) $(PTHREAD_INC) $< $(PTHREAD) -o $@

# Heap allocator torture — no pthread needed; tests substrate's
# libc malloc against host libc as a baseline.
torture_malloc: torture_malloc.c
	$(CC) $(CFLAGS) $(LDFLAGS) $< -o $@

# evdev /dev/input/event0 ioctl + grab/ungrab torture.  No pthread.
torture_evdev: torture_evdev.c
	$(CC) $(CFLAGS) $(LDFLAGS) $< -o $@

# Minimal X-server-shape AF_UNIX handshake torture (mimics the
# Xfbdev <-> xtrace dance — listen, poll, accept, read setup
# request, write reply, close).  Useful for ruling out the
# kernel poll/accept layer when X-server-side issues are suspected.
torture_x11_shape: torture_x11_shape.c
	$(CC) $(CFLAGS) $(LDFLAGS) $< -o $@

# SIGALRM / setitimer / alarm torture.  12 scenarios covering
# oneshot, periodic, EINTR, SA_RESTART, mask-in-handler, pending
# coalescing, storm bound, alarm() roundtrip, getitimer, siglongjmp,
# progress-under-storm, accept-eintr.  Designed to pin down which
# part of substrate's signal pipeline (sendsig, sigreturn, mask
# restore, kern_setitimer accounting) might explain Xfbdev's
# SIGALRM-loop trace.
torture_sigalrm: torture_sigalrm.c
	$(CC) $(CFLAGS) $(LDFLAGS) $< -o $@

# Combined libc heap + stdio stress.  Aimed at the substrate libc
# allocator + stdio interaction that produced the Xfbdev "calloc
# inside XkmInsureSize -> NULL deref in split_block" and the
# "fread -> memcpy(dst=0x1)" crashes.  Eight scenarios cover the
# split_block edge cases, fgets line reads, realloc grow/shrink,
# fopen/fclose churn, ungetc, the XKB allocation shape, an
# alloc-free-alloc cycle on the 144-byte size class, and a big-
# buffer fread.
torture_heap_stdio: torture_heap_stdio.c
	$(CC) $(CFLAGS) $(LDFLAGS) $< -o $@

clean:
	rm -f $(TESTS)

.PHONY: all clean
