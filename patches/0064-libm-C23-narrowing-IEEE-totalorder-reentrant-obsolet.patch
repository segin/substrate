+    test_gamma();
+    test_pow10();
+    test_narrowing();
+    test_totalorder();
+    test_canonicalize();
+    test_getpayload();
+    test_setpayload();
+    test_setpayloadsig();
+    test_lgammaf_r();
+    test_lgammal_r();
