+/* ---- AF_UNIX datagrams ----------------------------------------------- */
+
+static void g_dgram_unix(void) {
+    int sp[2];
+    if (socketpair(AF_UNIX, SOCK_DGRAM, 0, sp) != 0) {
+        for (int i = 0; i < 8; i++) ck(0, "AF_UNIX/DGRAM socketpair unsupported");
+        return;
+    }
+    ck(1, "socketpair(AF_UNIX/DGRAM)");
+    char b[64];
+    ck(send(sp[0], "ux-dgram", 8, 0) == 8, "unix dgram send 0->1");
+    ssize_t r = recv(sp[1], b, sizeof(b), 0);
+    ck(r == 8 && memcmp(b, "ux-dgram", 8) == 0, "unix dgram recv content");
+    ck(send(sp[1], "rev", 3, 0) == 3, "unix dgram send 1->0");
+    r = recv(sp[0], b, sizeof(b), 0);
+    ck(r == 3 && memcmp(b, "rev", 3) == 0, "unix dgram reverse content");
+    send(sp[0], "A", 1, 0);
+    send(sp[0], "BB", 2, 0);
+    int n = 0, sz[2] = { 0, 0 };
+    for (int i = 0; i < 2; i++) {
+        if (!(poll1(sp[1], POLLIN, 1000) & POLLIN)) break;
+        ssize_t q = recv(sp[1], b, sizeof(b), 0); if (q >= 0) sz[n++] = (int)q;
+    }
+    ck(n == 2 && sz[0] == 1 && sz[1] == 2, "unix dgram boundaries preserved");
+    int ok = 0;
+    for (int i = 0; i < 16; i++) {
+        unsigned char v = (unsigned char)i, g = 0xff;
+        send(sp[0], &v, 1, 0);
+        if ((poll1(sp[1], POLLIN, 1000) & POLLIN) && recv(sp[1], &g, 1, 0) == 1 && g == v) ok++;
+    }
+    ck(ok == 16, "unix dgram 16 round-trip");
+    close(sp[0]); close(sp[1]);
+}
