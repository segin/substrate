+static int tcp6_pair(int *cfd, int *sfd) {
+    int L = socket(AF_INET6, SOCK_STREAM, 0);
+    if (L < 0) return -1;
+    int one = 1; setsockopt(L, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+    struct sockaddr_in6 a; lo6(&a, 0);
+    if (bind(L, (struct sockaddr *)&a, sizeof(a)) < 0) { close(L); return -1; }
+    socklen_t al = sizeof(a); getsockname(L, (struct sockaddr *)&a, &al);
+    if (listen(L, 8) < 0) { close(L); return -1; }
+    int c = socket(AF_INET6, SOCK_STREAM, 0);
+    if (connect(c, (struct sockaddr *)&a, sizeof(a)) < 0) { close(L); close(c); return -1; }
+    int s = accept(L, NULL, NULL); close(L);
+    if (s < 0) { close(c); return -1; }
+    *cfd = c; *sfd = s; return 0;
+}
+
+static void g_ipv6(void) {
+    if (!v6_ok()) {
+        for (int i = 0; i < 18; i++) ck(1, "IPv6 not configured on host — point skipped");
+        return;
+    }
+    int c, s;
+    ck(tcp6_pair(&c, &s) == 0, "IPv6 tcp pair");
+    struct sockaddr_in6 pa; socklen_t pl = sizeof(pa);
+    ck(getpeername(s, (struct sockaddr *)&pa, &pl) == 0 && pa.sin6_family == AF_INET6,
+       "IPv6 getpeername");
+    ck(memcmp(&pa.sin6_addr, &in6addr_loopback, 16) == 0, "IPv6 peer is ::1");
+    char b[32] = {0};
+    ck(write(c, "v6hello", 7) == 7, "IPv6 write");
+    ck(read_all(s, b, 7) == 7 && memcmp(b, "v6hello", 7) == 0, "IPv6 read content");
+    ck(write(s, "back", 4) == 4, "IPv6 reverse write");
+    memset(b, 0, sizeof(b));
+    ck(read_all(c, b, 4) == 4 && memcmp(b, "back", 4) == 0, "IPv6 reverse read");
+    enum { N6 = 64 * 1024 };
+    char *o = malloc(N6), *in = malloc(N6);
+    for (int i = 0; i < N6; i++) o[i] = (char)(i * 13 + 5);
+    set_nb(c, 1); set_nb(s, 1);
+    int wn = 0, rn = 0;
+    while (rn < N6) {
+        if (wn < N6) { ssize_t w = write(c, o + wn, N6 - wn); if (w > 0) wn += (int)w; }
+        ssize_t r = read(s, in + rn, N6 - rn);
+        if (r > 0) rn += (int)r;
+        else if (r < 0 && errno != EAGAIN && errno != EWOULDBLOCK) break;
+    }
+    set_nb(c, 0); set_nb(s, 0);
+    ck(wn == N6 && rn == N6 && memcmp(o, in, N6) == 0, "IPv6 64K transfer intact");
+    free(o); free(in);
+    ck((poll1(s, POLLOUT, 1000) & POLLOUT) != 0, "IPv6 connected POLLOUT");
+    write(c, "x", 1);
+    ck((poll1(s, POLLIN, 2000) & POLLIN) != 0, "IPv6 POLLIN after write");
+    read(s, b, 1);
+    ck(shutdown(c, SHUT_WR) == 0, "IPv6 shutdown(SHUT_WR)");
+    ck(read(s, b, 4) == 0, "IPv6 EOF after shutdown");
+    close(c); close(s);
+
+    int ua = socket(AF_INET6, SOCK_DGRAM, 0), ub = socket(AF_INET6, SOCK_DGRAM, 0);
+    struct sockaddr_in6 aa, bb; lo6(&aa, 0); lo6(&bb, 0);
+    ck(bind(ua, (struct sockaddr *)&aa, sizeof(aa)) == 0, "IPv6 udp bind a");
+    ck(bind(ub, (struct sockaddr *)&bb, sizeof(bb)) == 0, "IPv6 udp bind b");
+    socklen_t l6 = sizeof(aa); getsockname(ua, (struct sockaddr *)&aa, &l6);
+    ck(sendto(ub, "V6U", 3, 0, (struct sockaddr *)&aa, sizeof(aa)) == 3, "IPv6 udp sendto");
+    if (poll1(ua, POLLIN, 2000) & POLLIN) {
+        ssize_t r = recv(ua, b, sizeof(b), 0);
+        ck(r == 3 && memcmp(b, "V6U", 3) == 0, "IPv6 udp recv content");
+    } else ck(0, "IPv6 udp recv (timeout)");
+    sendto(ub, "1", 1, 0, (struct sockaddr *)&aa, sizeof(aa));
+    sendto(ub, "22", 2, 0, (struct sockaddr *)&aa, sizeof(aa));
+    int n6 = 0, sz6[2] = { 0, 0 };
+    for (int i = 0; i < 2; i++) {
+        if (!(poll1(ua, POLLIN, 2000) & POLLIN)) break;
+        ssize_t r = recv(ua, b, sizeof(b), 0); if (r > 0) sz6[n6++] = (int)r;
+    }
+    ck(n6 == 2 && sz6[0] == 1 && sz6[1] == 2, "IPv6 udp boundaries");
+    int ok6 = 0;
+    for (int i = 0; i < 16; i++) {
+        unsigned char v = (unsigned char)i, g = 0xff;
+        sendto(ub, &v, 1, 0, (struct sockaddr *)&aa, sizeof(aa));
+        if ((poll1(ua, POLLIN, 1000) & POLLIN) && recv(ua, &g, 1, 0) == 1 && g == v) ok6++;
+    }
+    ck(ok6 == 16, "IPv6 udp 16 round-trip");
+    close(ua); close(ub);
+}
