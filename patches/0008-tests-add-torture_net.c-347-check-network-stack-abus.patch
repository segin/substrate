+/* ---- scatter/gather: writev/readv + sendmsg/recvmsg ------------------ */
+
+static void g_iov(void) {
+    int c, s;
+    if (tcp_pair(&c, &s) != 0) { for (int i = 0; i < 9; i++) ck(0, "iov: pair failed"); return; }
+    struct iovec wv[3];
+    wv[0].iov_base = (void *)"AA";   wv[0].iov_len = 2;
+    wv[1].iov_base = (void *)"BBB";  wv[1].iov_len = 3;
+    wv[2].iov_base = (void *)"CCCC"; wv[2].iov_len = 4;
+    ck(writev(c, wv, 3) == 9, "writev 3 iovs = 9 bytes");
+    char tmp[9];
+    ck(read_all(s, tmp, 9) == 9, "gathered read 9 bytes");
+    ck(memcmp(tmp, "AABBBCCCC", 9) == 0, "writev content correct");
+
+    write(s, "DDEEEFFFF", 9);
+    char p0[2], p1[3], p2[4];
+    struct iovec rv[3];
+    rv[0].iov_base = p0; rv[0].iov_len = 2;
+    rv[1].iov_base = p1; rv[1].iov_len = 3;
+    rv[2].iov_base = p2; rv[2].iov_len = 4;
+    poll1(c, POLLIN, 2000);
+    ck(readv(c, rv, 3) == 9, "readv scatter 9 bytes");
+    ck(memcmp(p0, "DD", 2) == 0 && memcmp(p1, "EEE", 3) == 0 && memcmp(p2, "FFFF", 4) == 0,
+       "readv scatter content");
+
+    struct msghdr mh; memset(&mh, 0, sizeof(mh));
+    struct iovec sv[2];
+    sv[0].iov_base = (void *)"msg"; sv[0].iov_len = 3;
+    sv[1].iov_base = (void *)"hdr"; sv[1].iov_len = 3;
+    mh.msg_iov = sv; mh.msg_iovlen = 2;
+    ck(sendmsg(c, &mh, 0) == 6, "sendmsg 2 iovs = 6");
+    char m[6];
+    ck(read_all(s, m, 6) == 6 && memcmp(m, "msghdr", 6) == 0, "sendmsg content");
+
+    write(c, "recvme", 6);
+    struct msghdr rh; memset(&rh, 0, sizeof(rh));
+    char r0[3], r1[3];
+    struct iovec riv[2];
+    riv[0].iov_base = r0; riv[0].iov_len = 3;
+    riv[1].iov_base = r1; riv[1].iov_len = 3;
+    rh.msg_iov = riv; rh.msg_iovlen = 2;
+    poll1(s, POLLIN, 2000);
+    ck(recvmsg(s, &rh, 0) == 6, "recvmsg 2 iovs = 6");
+    ck(memcmp(r0, "rec", 3) == 0 && memcmp(r1, "vme", 3) == 0, "recvmsg scatter content");
+    close(c); close(s);
+}
