+/* ---- varied-size stream storm (stress + correctness) ----------------- */
+
+static void g_tcp_storm(void) {
+    int c, s;
+    if (tcp_pair(&c, &s) != 0) { for (int i = 0; i < 100; i++) ck(0, "tcp storm pair failed"); return; }
+    set_nb(c, 1); set_nb(s, 1);
+    char *out = malloc(1500), *in = malloc(1500);
+    for (int it = 0; it < 100; it++) {
+        int len = 1 + (it * 37) % 1400;
+        for (int i = 0; i < len; i++) out[i] = (char)((it * 7 + i * 13) & 0xff);
+        int wn = 0, rn = 0, stuck = 0;
+        while (rn < len && stuck < 100000) {
+            if (wn < len) { ssize_t w = write(c, out + wn, len - wn);
+                            if (w > 0) { wn += (int)w; stuck = 0; }
+                            else if (w < 0 && errno != EAGAIN && errno != EWOULDBLOCK) break; }
+            ssize_t rd = read(s, in + rn, len - rn);
+            if (rd > 0) { rn += (int)rd; stuck = 0; }
+            else if (rd < 0 && errno != EAGAIN && errno != EWOULDBLOCK) break;
+            else stuck++;
+        }
+        ck(rn == len && memcmp(out, in, len) == 0, "tcp storm: varied-size echo intact");
+    }
+    free(out); free(in);
+    close(c); close(s);
+}
+
+/* ---- varied-size datagram storm -------------------------------------- */
+
+static void g_udp_storm(void) {
+    int a = socket(AF_INET, SOCK_DGRAM, 0);
+    int b = socket(AF_INET, SOCK_DGRAM, 0);
+    struct sockaddr_in aa, ba; lo4(&aa, 0); lo4(&ba, 0);
+    if (bind(a, (struct sockaddr *)&aa, sizeof(aa)) < 0 ||
+        bind(b, (struct sockaddr *)&ba, sizeof(ba)) < 0) {
+        for (int i = 0; i < 48; i++) ck(0, "udp storm bind failed");
+        close(a); close(b); return;
+    }
+    socklen_t l = sizeof(aa); getsockname(a, (struct sockaddr *)&aa, &l);
+    char *out = malloc(1400), *in = malloc(1400);
+    for (int it = 0; it < 48; it++) {
+        int len = 1 + (it * 29) % 1200;
+        for (int i = 0; i < len; i++) out[i] = (char)((it * 11 + i * 7) & 0xff);
+        sendto(b, out, len, 0, (struct sockaddr *)&aa, sizeof(aa));
+        int good = 0;
+        if (poll1(a, POLLIN, 1500) & POLLIN) {
+            ssize_t r = recv(a, in, 1400, 0);
+            good = (r == len && memcmp(out, in, len) == 0);
+        }
+        ck(good, "udp storm: varied-size datagram intact");
+    }
+    free(out); free(in);
+    close(a); close(b);
+}
