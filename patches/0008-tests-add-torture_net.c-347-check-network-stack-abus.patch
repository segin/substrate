+/* ---- IPv6 (loopback ::1) --------------------------------------------- */
+
+static int v6_ok(void) {
+    int f = socket(AF_INET6, SOCK_STREAM, 0);
+    if (f < 0) return 0;
+    struct sockaddr_in6 a;
+    memset(&a, 0, sizeof(a));
+    a.sin6_family = AF_INET6;
+    a.sin6_addr = in6addr_loopback;
+    a.sin6_port = 0;
+    int ok = (bind(f, (struct sockaddr *)&a, sizeof(a)) == 0);
+    close(f);
+    return ok;
+}
+
+static void lo6(struct sockaddr_in6 *a, unsigned short port) {
+    memset(a, 0, sizeof(*a));
+    a->sin6_family = AF_INET6;
+    a->sin6_addr = in6addr_loopback;
+    a->sin6_port = htons(port);
+}
