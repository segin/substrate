diff --git a/patches/0013-etc-rc.d-add-16-ttdbserver-fixes-CDE-TT_ERR_NO_MATCH.patch b/patches/0013-etc-rc.d-add-16-ttdbserver-fixes-CDE-TT_ERR_NO_MATCH.patch
new file mode 100644
index 00000000..43d2cbb3
--- /dev/null
+++ b/patches/0013-etc-rc.d-add-16-ttdbserver-fixes-CDE-TT_ERR_NO_MATCH.patch
@@ -0,0 +1,108 @@
+From ebb5a600508702df6d5b4cfef82bf5c568833260 Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Tue, 9 Jun 2026 11:38:26 -0500
+Subject: [PATCH 13/83] =?UTF-8?q?etc/rc.d:=20add=2016-ttdbserver=20?=
+ =?UTF-8?q?=E2=80=94=20fixes=20CDE=20TT=5FERR=5FNO=5FMATCH?=
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+CDE apps (dtstyle, dtcm, dtfile, ...) resolve their ToolTalk message
+patterns through a type database that ttsession loads at session start.
+Substrate started rpcbind (15-rpcbind) but never started rpc.ttdbserver
+and never compiled the CDE ptypes, so ttsession had zero ptypes
+registered: every ToolTalk request returned TT_ERR_NO_MATCH and the apps
+printed "Cannot communicate with the session manager" and exited.
+
+16-ttdbserver (sequenced after rpcbind, before 60-sdm) starts
+rpc.ttdbserver and compiles /usr/dt/appconfig/tttypes/*.ptype into the
+ToolTalk type DB so the types are live before dtsession starts.
+
+The compile runs with DISPLAY unset on purpose: with DISPLAY set but no X
+server up yet, tt_type_comp's ToolTalk init blocks ~20s per file trying to
+reach the X-display session before falling back (this is the "tt_type_comp
+hang" — it always completes, just slowly).  With DISPLAY unset it uses the
+host session and compiles all ptypes in ~3s.
+
+Verified headless: with this rc.d the type names compile correctly (the
+%C/%S printf fix makes them legible) and dtsession/dtwm/ttsession come up
+with a clean errorlog — no more NO_MATCH / "cannot communicate".
+
+Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
+---
+ etc/rc.d/16-ttdbserver | 63 ++++++++++++++++++++++++++++++++++++++++++
+ 1 file changed, 63 insertions(+)
+ create mode 100755 etc/rc.d/16-ttdbserver
+
+diff --git a/etc/rc.d/16-ttdbserver b/etc/rc.d/16-ttdbserver
+new file mode 100755
+index 00000000..ed1142ad
+--- /dev/null
++++ b/etc/rc.d/16-ttdbserver
+@@ -0,0 +1,63 @@
++#!/bin/sh
++# /etc/rc.d/16-ttdbserver — CDE ToolTalk database server + type database.
++#
++# ToolTalk clients (dtsession, dtfile, dtstyle, dtcm, ...) resolve their
++# message patterns ("ptypes") through a type database served by
++# rpc.ttdbserver and loaded by ttsession.  With neither the server running
++# NOR the CDE ptypes compiled, every ToolTalk request fails with
++# TT_ERR_NO_MATCH and the apps print "Cannot communicate with the session
++# manager" and exit.
++#
++# Runs after 15-rpcbind (rpc.ttdbserver registers its RPC service with the
++# portmapper) and before 60-sdm (so the types are loaded by the time
++# dtsession starts ttsession).
++#
++# NOTE on the compile: tt_type_comp must run with DISPLAY UNSET.  With
++# DISPLAY set but no X server up yet, its ToolTalk init blocks ~20s per
++# file trying to reach the X-display session before falling back — so
++# compiling all ptypes at boot would otherwise add minutes of dead time.
++# With DISPLAY unset it uses the host session and compiles all of them in
++# a few seconds.
++
++TTDB=/usr/dt/bin/rpc.ttdbserver
++TTC=/usr/dt/bin/tt_type_comp
++PIDFILE=/var/run/ttdbserver.pid
++TTPATH=/root/.tt
++
++case "${1:-start}" in
++    start)
++        if [ -x "$TTDB" ]; then
++            mkdir -p /var/run
++            "$TTDB" > /var/log/ttdbserver.log 2>&1 &
++            echo $! > "$PIDFILE"
++        fi
++        # Compile the CDE ptypes into the ToolTalk type DB.  tt_type_comp -m
++        # merges idempotently, so re-running each boot is cheap (a few
++        # seconds total) and avoids depending on the DB's on-disk path.
++        if [ -x "$TTC" ]; then
++            ( unset DISPLAY
++              export HOME=/root TTPATH="$TTPATH"
++              mkdir -p "$TTPATH"
++              for f in /usr/dt/appconfig/tttypes/*.ptype; do
++                  # dtinfo*.ptype use #include and don't compile; skip them.
++                  case "$f" in *dtinfo*) continue ;; esac
++                  "$TTC" -sd user -m "$f" > /dev/null 2>&1
++              done )
++        fi
++        ;;
++    stop)
++        kill "$(cat $PIDFILE 2>/dev/null)" 2>/dev/null
++        ;;
++    status)
++        if [ -x "$TTC" ] && ( unset DISPLAY; HOME=/root TTPATH="$TTPATH" \
++                "$TTC" -sd user -p 2>/dev/null | grep -q '^ptype' ); then
++            echo "ttdbserver: ToolTalk types loaded"
++        else
++            echo "ttdbserver: no types"
++        fi
++        ;;
++    restart)
++        $0 stop
++        $0 start
++        ;;
++esac
+-- 
+2.54.0
+
diff --git a/patches/0014-kernel-dtcm-no-longer-freezes-the-UI-preemptible-USB.patch b/patches/0014-kernel-dtcm-no-longer-freezes-the-UI-preemptible-USB.patch
new file mode 100644
index 00000000..d20af8f9
--- /dev/null
+++ b/patches/0014-kernel-dtcm-no-longer-freezes-the-UI-preemptible-USB.patch
@@ -0,0 +1,103 @@
+From 217ebe72fb33cfcfe1b4a2cb943c18a436ca376c Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Tue, 9 Jun 2026 13:36:52 -0500
+Subject: [PATCH 14/83] =?UTF-8?q?kernel:=20dtcm=20no=20longer=20freezes=20?=
+ =?UTF-8?q?the=20UI=20=E2=80=94=20preemptible=20USB=20poll=20wait=20+=20gu?=
+ =?UTF-8?q?ard=20signals=20to=20user=20mode?=
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+Opening dtcm (or any sustained activity) could freeze the entire desktop.
+gdb showed the CPU monopolised by usb_hid_poll_thread busy-spinning in
+uhci_poll_td: it pause-loops up to the 5s transfer deadline, and the HID
+poll kthread runs with interrupts DISABLED (switch_to doesn't save/restore
+EFLAGS, so a kthread that never re-enables IF stays IF=0).  With interrupts
+off the timer can't fire, nothing preempts the spin, and a wedged HID
+transfer starves the X server and its clients — dtcm/Xfbdev sit READY but
+never run.
+
+Fix, two parts:
+- uhci.c: run uhci_poll_td's completion wait with interrupts enabled
+  (intr_disable/intr_enable around the loop, intr_restore on exit) so the
+  timer tick can preempt it; the controller still completes the TD via DMA.
+- idt.c: only call signal_handle_pending() when the interrupt came from
+  user mode.  Enabling preemption of the kthread exposed a latent crash:
+  the timer IRQ would preempt the kthread, and on return the unguarded
+  signal_handle_pending(regs) ran for a kernel-mode frame whose `regs`
+  pointer had been clobbered across the sched_yield -> page-fault panic in
+  signal_handle_pending (regs->cs deref).  Signals are only ever delivered
+  on return to user mode, so the kernel-frame call was always a no-op
+  anyway; gating it on is_usermode removes both the crash and a needless
+  deref. (This is why the kthread defensively ran with IF=0 before.)
+
+Verified: dtcm opens, the desktop reaches steady state with the CPU idle
+(swapper/hlt) instead of monopolised, no panic.
+
+Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
+---
+ sys/arch/i386/idt.c    |  4 ++--
+ sys/drivers/usb/uhci.c | 16 ++++++++++++++--
+ 2 files changed, 16 insertions(+), 4 deletions(-)
+
+diff --git a/sys/arch/i386/idt.c b/sys/arch/i386/idt.c
+index 4633cf8b..0ab20dfa 100644
+--- a/sys/arch/i386/idt.c
++++ b/sys/arch/i386/idt.c
+@@ -242,7 +242,7 @@ void isr_handler(registers_t *regs) {
+         } else if (!current_thread && is_usermode) {
+             sched_yield();
+         }
+-        signal_handle_pending(regs);
++        if (is_usermode) signal_handle_pending(regs);  /* not for kernel-mode IRQs */
+         return;
+     }
+ 
+@@ -540,5 +540,5 @@ void isr_handler(registers_t *regs) {
+         outb(0x20, 0x20);
+     }
+ 
+-    signal_handle_pending(regs);
++    if (is_usermode) signal_handle_pending(regs);  /* not for kernel-mode IRQs */
+ }
+diff --git a/sys/drivers/usb/uhci.c b/sys/drivers/usb/uhci.c
+index 79393717..a89f2a88 100644
+--- a/sys/drivers/usb/uhci.c
++++ b/sys/drivers/usb/uhci.c
+@@ -22,6 +22,7 @@
+ #include <sys/dma.h>
+ #include <sys/irq.h>
+ #include <sys/lock.h>
++#include <intr.h>
+ #include <vm/vm_kmem.h>
+ #include <string.h>
+ 
+@@ -409,12 +410,23 @@ static int uhci_poll_td(uhci_hc_t *hc, struct uhci_td *td,
+     (void)hc;
+ 
+     while (td && walk_budget--) {
+-        /* Poll until this TD is no longer active */
++        /* Poll until this TD is no longer active.  Run the wait with
++         * interrupts ENABLED so the timer tick can preempt us.  The HID poll
++         * kthread runs with IF=0 (switch_to doesn't save/restore EFLAGS), so a
++         * bare pause-spin here is never preempted: a wedged transfer would
++         * monopolise the CPU for the full 5 s timeout and freeze the whole UI
++         * (opening dtcm reproduced it).  Enabling interrupts lets the X server
++         * and its clients keep running while the controller works. */
++        uint32_t _saved_if = intr_disable();
++        intr_enable();
+         while (td->ctrl_status & UHCI_TD_CTRL_ACTIVE) {
+-            if ((uint64_t)get_uptime_ms() > deadline)
++            if ((uint64_t)get_uptime_ms() > deadline) {
++                intr_restore(_saved_if);
+                 return USB_XFER_TIMEOUT;
++            }
+             __asm__ volatile("pause");
+         }
++        intr_restore(_saved_if);
+ 
+         /* Check for errors */
+         if (td->ctrl_status & UHCI_TD_CTRL_STALLED) {
+-- 
+2.54.0
+
diff --git a/patches/0015-fonts-port-B-H-Lucida-install-CDE-dt-aliases-fixes-d.patch b/patches/0015-fonts-port-B-H-Lucida-install-CDE-dt-aliases-fixes-d.patch
new file mode 100644
index 00000000..e2f73dbb
--- /dev/null
+++ b/patches/0015-fonts-port-B-H-Lucida-install-CDE-dt-aliases-fixes-d.patch
@@ -0,0 +1,201 @@
+From 7414c0a7d3e600ca5db92ebdce56af1a22315e30 Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Tue, 9 Jun 2026 15:57:04 -0500
+Subject: [PATCH 15/83] =?UTF-8?q?fonts:=20port=20B&H=20Lucida=20+=20instal?=
+ =?UTF-8?q?l=20CDE=20-dt-*=20aliases=20=E2=80=94=20fixes=20dtcm=20freezing?=
+ =?UTF-8?q?=20the=20desktop?=
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+Opening dtcm froze the whole UI: the mouse cursor still moved but clicks
+and keystrokes were dead.  Root cause (found via gdb + the Xfbdev log):
+
+dtcm builds Motif FontSets from -b&h-lucida* and the CDE logical -dt-*
+font names.  Neither was installed — there was no font-bh port (only
+adobe + misc), and the CDE programs/fontaliases/{mixed,fixed}.alias were
+never staged.  The FontSet build fails, and drawing text with the broken
+set makes Xfbdev (the X server) SEGFAULT.  The server dies *holding the
+evdev keyboard+mouse grab*, the ungrab fails (error 9), so the input
+devices stay grabbed — cursor moves (hardware) but nothing receives
+events.  That is the "stuck, mouse moves, clicks/keys do nothing" freeze.
+
+Fix:
+- contrib/font-bh-lucida/: new port for the X.Org B&H Lucida /
+  LucidaTypewriter bitmap fonts (75 + 100 dpi), deriving ISO8859-1
+  variants like font-adobe.
+- build-rootfs.sh finalize_x_fonts(): after the contrib overlays,
+  regenerate ONE merged fonts.dir per X font dir (adobe + bh share
+  100dpi/75dpi) and install the CDE {mixed,fixed}.alias as fonts.alias so
+  -dt-* resolves to the adobe fonts.
+
+Verified headless: dtcm now starts and stays up, the "Cannot convert ...
+to type FontSet" errors are gone, and Xfbdev no longer crashes.
+
+Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
+---
+ build-rootfs.sh                            | 31 +++++++++++++++
+ contrib/font-bh-lucida/README.SUBSTRATE.md | 11 ++++++
+ contrib/font-bh-lucida/build.sh            | 46 ++++++++++++++++++++++
+ contrib/font-bh-lucida/fetch.sh            | 29 ++++++++++++++
+ 4 files changed, 117 insertions(+)
+ create mode 100644 contrib/font-bh-lucida/README.SUBSTRATE.md
+ create mode 100755 contrib/font-bh-lucida/build.sh
+ create mode 100755 contrib/font-bh-lucida/fetch.sh
+
+diff --git a/build-rootfs.sh b/build-rootfs.sh
+index 1b462adf..034f679d 100755
+--- a/build-rootfs.sh
++++ b/build-rootfs.sh
+@@ -195,6 +195,35 @@ build_components() {
+     done
+ }
+ 
++finalize_x_fonts() {
++    # Adobe + B&H Lucida fonts both stage into X11/100dpi and 75dpi, each
++    # with its own fonts.dir — regenerate ONE merged fonts.dir per dir from
++    # every BDF present, and install the CDE -dt-* font aliases.  dtcm (and
++    # other CDE apps) build FontSets from -dt-* / -b&h-lucida*; a font that
++    # the set can't resolve makes Xfbdev SEGFAULT (it dies holding the evdev
++    # grab -> frozen desktop), so all the referenced fonts + aliases must
++    # be present.
++    _cde_alias="$TOP/contrib/cde/build/cdesktopenv/cde/programs/fontaliases"
++    for _d in 100dpi 75dpi misc; do
++        _dst="$DIST/usr/share/fonts/X11/$_d"
++        [ -d "$_dst" ] || continue
++        : > "$_dst/fonts.dir.tmp"; _n=0
++        for _f in "$_dst"/*.bdf; do
++            [ -f "$_f" ] || continue
++            _bn=$(basename "$_f")
++            _xlfd=$(sed -n 's/^FONT[[:space:]][[:space:]]*\(.*\)$/\1/p' "$_f" | head -1)
++            [ -n "$_xlfd" ] || continue
++            printf '%s\t%s\n' "$_bn" "$_xlfd" >> "$_dst/fonts.dir.tmp"; _n=$((_n+1))
++        done
++        { printf '%d\n' "$_n"; cat "$_dst/fonts.dir.tmp"; } > "$_dst/fonts.dir"
++        cp -a "$_dst/fonts.dir" "$_dst/fonts.scale"; rm -f "$_dst/fonts.dir.tmp"
++        if [ -f "$_cde_alias/mixed.alias" ]; then
++            cat "$_cde_alias/mixed.alias" "$_cde_alias/fixed.alias" 2>/dev/null > "$_dst/fonts.alias" ||                 cp "$_cde_alias/mixed.alias" "$_dst/fonts.alias"
++        fi
++        echo "Finalized X fonts in $_d: $_n entries + CDE -dt-* aliases"
++    done
++}
++
+ install_to_dist() {
+     echo "Installing kernel to dist/boot and dist/vmunix..."
+     cp "$TOP/sys/kernel.bin" "$DIST/boot/"
+@@ -436,6 +465,8 @@ install_to_dist() {
+         echo "  (skipped contrib/gcc stage 2: $GCC_STAGE2_STAGING does not exist)"
+     fi
+ 
++    finalize_x_fonts
++
+     # /bin/sh -> /usr/bin/zsh.  Substrate's POSIX shell is zsh in
+     # sh-emulation mode; the in-tree bin/sh/ is intentionally not
+     # built (see CLAUDE.md).  Every shebang line (rc.d scripts,
+diff --git a/contrib/font-bh-lucida/README.SUBSTRATE.md b/contrib/font-bh-lucida/README.SUBSTRATE.md
+new file mode 100644
+index 00000000..e987311c
+--- /dev/null
++++ b/contrib/font-bh-lucida/README.SUBSTRATE.md
+@@ -0,0 +1,11 @@
++# font-bh-lucida (X.Org B&H Lucida bitmap fonts)
++
++Provides `-b&h-lucida*` / `-b&h-lucidatypewriter*` (75dpi + 100dpi).
++CDE's dtcm requests these as a FontSet; without them the FontSet build
++fails and drawing the broken set **segfaults Xfbdev**, which dies holding
++the evdev keyboard/mouse grab → the whole desktop freezes (cursor still
++moves, clicks/keys dead).  Source-only patch series; `fetch.sh` downloads
+++ SHA-verifies the four upstream tarballs, `build.sh` stages the BDFs
++(deriving ISO8859-1 variants, same as font-adobe).  The merged per-dir
++`fonts.dir` and the CDE `-dt-*` `fonts.alias` are installed by
++`build-rootfs.sh`'s `finalize_x_fonts` step (adobe + bh share 100dpi/75dpi).
+diff --git a/contrib/font-bh-lucida/build.sh b/contrib/font-bh-lucida/build.sh
+new file mode 100755
+index 00000000..c7bec0f3
+--- /dev/null
++++ b/contrib/font-bh-lucida/build.sh
+@@ -0,0 +1,46 @@
++#!/bin/sh
++# contrib/font-bh-lucida/build.sh — stage the B&H Lucida BDF fonts.
++# Mirrors contrib/font-adobe-100dpi: libXfont reads BDF directly (no
++# bdftopcf), and the 1.0.4 BDFs are ISO10646-1, so we derive ISO8859-1
++# single-byte variants for the en_US.UTF-8 fontset's Latin slot.  The
++# final per-directory fonts.dir is regenerated at image-assembly time
++# (build-rootfs.sh finalize_x_fonts) since adobe + bh share 100dpi/75dpi.
++set -eu
++HERE="$(cd "$(dirname "$0")" && pwd)"
++if [ -z "${SUBSTRATE_TOP:-}" ]; then
++  p="${HERE}"; while [ "${p}" != "/" ] && [ ! -f "${p}/AGENTS.md" ] && [ ! -f "${p}/CLAUDE.md" ]; do p=$(dirname "${p}"); done
++  SUBSTRATE_TOP="${p}"
++fi
++: "${DESTDIR:=${SUBSTRATE_TOP}/dist-font-bh-lucida}"
++B="${HERE}/build"
++[ -d "${B}/font-bh-100dpi-1.0.4" ] || { echo "build.sh: run ./fetch.sh first" >&2; exit 1; }
++
++derive_iso8859_1() {
++  awk '
++  function flush(){ if(buf!=""){ if(enc>=0 && enc<=255){ printf "%s", buf; n++ } buf=""; enc=-999 } }
++  BEGIN{ inchar=0; enc=-999; buf="" }
++  /^STARTCHAR/{ inchar=1; buf=$0 ORS; next }
++  inchar && /^ENCODING/{ enc=$2; buf=buf $0 ORS; next }
++  /^ENDCHAR/{ if(inchar){ buf=buf $0 ORS; flush(); inchar=0 } else print; next }
++  inchar{ buf=buf $0 ORS; next }
++  /^FONT /{ line=$0; sub(/-ISO10646-1[ \t\r]*$/,"-ISO8859-1",line); print line; next }
++  /^CHARSET_REGISTRY/{ print "CHARSET_REGISTRY \"ISO8859\""; next }
++  /^CHARSET_ENCODING/{ print "CHARSET_ENCODING \"1\""; next }
++  /^CHARS /{ print "CHARS PLACEHOLDER"; next }
++  { print }' "$1" > "$2.raw"
++  realn=$(grep -c '^STARTCHAR' "$2.raw"); sed "s/^CHARS PLACEHOLDER/CHARS ${realn}/" "$2.raw" > "$2"; rm -f "$2.raw"
++}
++
++rm -rf "${DESTDIR}"
++for dpi in 100dpi 75dpi; do
++  DST="${DESTDIR}/usr/share/fonts/X11/${dpi}"; mkdir -p "${DST}"
++  for pkg in "font-bh-${dpi}-1.0.4" "font-bh-lucidatypewriter-${dpi}-1.0.4"; do
++    for f in "${B}/${pkg}"/*.bdf; do
++      [ -f "$f" ] || continue; bn=$(basename "$f"); cp -a "$f" "${DST}/${bn}"
++      grep -qE '^FONT .*-ISO10646-1[[:space:]]*$' "${DST}/${bn}" && \
++        derive_iso8859_1 "${DST}/${bn}" "${DST}/${bn%.bdf}-iso8859-1.bdf" || true
++    done
++  done
++  echo "==> staged ${dpi}: $(ls "${DST}"/*.bdf | wc -l) BDFs"
++done
++echo "==> font-bh-lucida staged at ${DESTDIR}"
+diff --git a/contrib/font-bh-lucida/fetch.sh b/contrib/font-bh-lucida/fetch.sh
+new file mode 100755
+index 00000000..c5a5545d
+--- /dev/null
++++ b/contrib/font-bh-lucida/fetch.sh
+@@ -0,0 +1,29 @@
++#!/bin/sh
++# contrib/font-bh-lucida/fetch.sh — X.Org B&H Lucida bitmap fonts
++# (Lucida, LucidaBright, LucidaSans, LucidaTypewriter), 75dpi + 100dpi.
++# CDE's dtcm (and other CDE apps) request -b&h-lucida* fontsets; without
++# them the FontSet build fails and drawing the broken set CRASHES Xfbdev
++# (taking the evdev grab down with it -> frozen desktop).  Source-only
++# fetch; build.sh stages the BDFs.
++set -eu
++HERE="$(cd "$(dirname "$0")" && pwd)"
++BUILD_DIR="${HERE}/build"; mkdir -p "${BUILD_DIR}"; cd "${BUILD_DIR}"
++base="https://www.x.org/releases/individual/font"
++# tarball  sha256
++set -- \
++  font-bh-100dpi-1.0.4                  fd8f5efe8491faabdd2744808d3d4eafdae5c83e617017c7fddd2716d049ab1e \
++  font-bh-75dpi-1.0.4                   6026d8c073563dd3cbb4878d0076eed970debabd21423b3b61dd90441b9e7cda \
++  font-bh-lucidatypewriter-100dpi-1.0.4 76ec09eda4094a29d47b91cf59c3eba229c8f7d1ca6bae2abbb3f925e33de8f2 \
++  font-bh-lucidatypewriter-75dpi-1.0.4  864e2c39ac61f04f693fc2c8aaaed24b298c2cd40283cec12eee459c5635e8f5
++while [ $# -ge 2 ]; do
++  name="$1"; sha="$2"; shift 2
++  t="${name}.tar.xz"
++  if [ ! -f "$t" ]; then
++    [ "${1:-}" = "--no-network" ] && { echo "fetch: $t missing" >&2; exit 1; }
++    echo "==> Fetching ${base}/${t}"
++    if command -v curl >/dev/null 2>&1; then curl -fSL -o "$t" "${base}/${t}"; else wget -O "$t" "${base}/${t}"; fi
++  fi
++  echo "${sha}  ${t}" | sha256sum -c -
++  [ -d "${name}" ] || tar xf "$t"
++done
++echo "==> font-bh-lucida ready"
+-- 
+2.54.0
+
diff --git a/patches/0016-build-rootfs-finalize_x_fonts-appends-CDE-aliases-do.patch b/patches/0016-build-rootfs-finalize_x_fonts-appends-CDE-aliases-do.patch
new file mode 100644
index 00000000..12fc80c2
--- /dev/null
+++ b/patches/0016-build-rootfs-finalize_x_fonts-appends-CDE-aliases-do.patch
@@ -0,0 +1,27 @@
+From 4079e4ed3f7374ad529b9ab268ff9537b5d09d3b Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
