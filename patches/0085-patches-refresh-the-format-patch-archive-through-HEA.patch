+-        if (remaining > 0) *s = '\0';
++
++    if (size > 0 && str) {
++        if (o.remaining > 0) *o.s = '\0';
+         else str[size - 1] = '\0';
+     }
+-    return len;
++    return (int)o.len;
+ }
+ 
