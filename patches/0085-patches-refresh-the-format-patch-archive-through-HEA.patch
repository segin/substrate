+new file mode 100755
+index 00000000..857655ec
+--- /dev/null
++++ b/scripts/sync-sysroot.sh
+@@ -0,0 +1,101 @@
++#!/bin/sh
++#
++# sync-sysroot.sh — mirror built libraries + headers into the cross
++# toolchain sysroot so the cross compiler's regular -lfoo / #include <foo.h>
++# search finds them.
++#
++# Two sources are mirrored:
++#   1. contrib ports        — every dist-<pkg>/usr/{lib,include} at the repo
++#                             root (the staged output of contrib/<pkg>/build.sh)
++#   2. substrate native libs — lib/<X>/libX.{so.0,a}, usr.lib/<X>/libX.{so.0,a},
++#                             and the top-level include/ public headers
++#
++# Headers are mirrored both into $SYSROOT/include and into every GCC
++# include-fixed snapshot (fixincludes wins over the sysroot, so a header that
++# lives only in the sysroot is invisible to the compiler).
++#
++# Idempotent and standalone: it reconstructs the sysroot from existing dist-*
++# outputs WITHOUT a rebuild, so CI / automation can run it any time the
++# sysroot is fresh or stale.  build.sh also sources this file and calls the
++# same functions during a build, so there is a single source of truth.
++#
++# Usage:
++#   scripts/sync-sysroot.sh                # mirror ALL dist-* + native libs
++#   scripts/sync-sysroot.sh libpng cairo   # mirror only these dist-<pkg>
++#   STAGE1_PREFIX=/opt/substrate scripts/sync-sysroot.sh
++#
++# Env:
++#   STAGE1_PREFIX   cross toolchain prefix         (default /opt/substrate)
++#   SUBSTRATE_TOP   repo root                       (default: this script's ..)
++
++: "${SUBSTRATE_TOP:=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
++: "${STAGE1_PREFIX:=/opt/substrate}"
++SYSROOT="${STAGE1_PREFIX}/i386-unknown-substrate"
++
++# Copy a directory tree of headers into every GCC include-fixed snapshot.
++_mirror_to_fixinc() {
++    srcinc="$1"
++    fixinc="${STAGE1_PREFIX}/lib/gcc/i386-unknown-substrate"
++    [ -d "$fixinc" ] || return 0
++    for ver in "$fixinc"/*/include-fixed; do
++        [ -d "$ver" ] || continue
++        cp -a "$srcinc/." "$ver/" 2>/dev/null || true
++    done
++}
++
++# Mirror one contrib port's dist-<pkg>/usr/{lib,include} into the sysroot.
++sync_to_sysroot() {
++    pkg="$1"
++    distdir="${SUBSTRATE_TOP}/dist-${pkg}"
++    [ -d "$distdir/usr/lib" ] || [ -d "$distdir/usr/include" ] || return 0
++    if [ -d "$distdir/usr/lib" ]; then
++        mkdir -p "$SYSROOT/lib"
++        cp -a "$distdir/usr/lib/." "$SYSROOT/lib/" 2>/dev/null || true
++    fi
++    if [ -d "$distdir/usr/include" ]; then
++        mkdir -p "$SYSROOT/include"
++        cp -a "$distdir/usr/include/." "$SYSROOT/include/" 2>/dev/null || true
++        _mirror_to_fixinc "$distdir/usr/include"
++    fi
++}
++
++# Mirror substrate's own libs (lib/, usr.lib/) and public headers (include/).
++sync_native_libs_to_sysroot() {
++    [ -d "$SYSROOT/lib" ] || return 0
++    for dir in "${SUBSTRATE_TOP}"/lib/*/ "${SUBSTRATE_TOP}"/usr.lib/*/; do
++        [ -d "$dir" ] || continue
++        name=$(basename "$dir")
++        [ -f "$dir/lib$name.so.0" ] && cp "$dir/lib$name.so.0" "$SYSROOT/lib/" 2>/dev/null || true
++        [ -f "$dir/lib$name.a"    ] && cp "$dir/lib$name.a"    "$SYSROOT/lib/" 2>/dev/null || true
++    done
++    if [ -d "${SUBSTRATE_TOP}/include" ]; then
++        cp -a "${SUBSTRATE_TOP}/include/." "$SYSROOT/include/" 2>/dev/null || true
++        _mirror_to_fixinc "${SUBSTRATE_TOP}/include"
++    fi
++}
++
++# Mirror every dist-<pkg> found at the repo root, then the native libs.
++sync_all_to_sysroot() {
++    n=0
++    for distdir in "${SUBSTRATE_TOP}"/dist-*/; do
++        [ -d "$distdir" ] || continue
++        pkg=$(basename "$distdir"); pkg=${pkg#dist-}
++        sync_to_sysroot "$pkg"
++        n=$((n + 1))
++    done
++    sync_native_libs_to_sysroot
++    echo "sync-sysroot: mirrored $n contrib dist tree(s) + native libs into $SYSROOT"
++}
++
++# Run only when executed directly (not when sourced by build.sh, where $0 is
++# build.sh).  POSIX-portable check on the invoked basename.
++case "${0##*/}" in
++sync-sysroot.sh)
++    if [ "$#" -gt 0 ]; then
++        for p in "$@"; do sync_to_sysroot "$p"; done
++        echo "sync-sysroot: mirrored $* into $SYSROOT"
++    else
++        sync_all_to_sysroot
++    fi
++    ;;
++esac
+-- 
+2.54.0
+
diff --git a/patches/0082-build-dereference-symlinked-headers-when-mirroring-t.patch b/patches/0082-build-dereference-symlinked-headers-when-mirroring-t.patch
new file mode 100644
index 00000000..31faccb2
--- /dev/null
+++ b/patches/0082-build-dereference-symlinked-headers-when-mirroring-t.patch
@@ -0,0 +1,69 @@
+From 66b4abb7995c5180d7a4fbe84dac4aa3b3a76320 Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Fri, 12 Jun 2026 08:45:51 -0500
+Subject: [PATCH 82/83] build: dereference symlinked headers when mirroring to
+ the sysroot
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+sync-sysroot.sh copied include/ with `cp -a`, which preserves symlinks —
+so include/pthread.h (a symlink to ../lib/pthread/pthread.h) landed in the
+sysroot as a DANGLING link the cross compiler couldn't open
+("pthread.h: No such file or directory"), breaking any build that pulls in
+glib's gthread.h (e.g. the GTK+2 apps).  Use `cp -aL` for the header trees
+so symlinked headers materialise as real files, while the lib trees keep
+`cp -a` to preserve the .so version symlinks.
+
+Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
+---
+ scripts/sync-sysroot.sh | 13 ++++++++++---
+ 1 file changed, 10 insertions(+), 3 deletions(-)
+
+diff --git a/scripts/sync-sysroot.sh b/scripts/sync-sysroot.sh
+index 857655ec..61c5ed87 100755
+--- a/scripts/sync-sysroot.sh
++++ b/scripts/sync-sysroot.sh
+@@ -33,13 +33,17 @@
+ SYSROOT="${STAGE1_PREFIX}/i386-unknown-substrate"
+ 
+ # Copy a directory tree of headers into every GCC include-fixed snapshot.
++# -L dereferences symlinks: a header that is a symlink in the source tree
++# (e.g. include/pthread.h -> ../lib/pthread/pthread.h) must become a REAL
++# file in the sysroot, otherwise it lands as a dangling link the compiler
++# cannot open ("pthread.h: No such file or directory").
+ _mirror_to_fixinc() {
+     srcinc="$1"
+     fixinc="${STAGE1_PREFIX}/lib/gcc/i386-unknown-substrate"
+     [ -d "$fixinc" ] || return 0
+     for ver in "$fixinc"/*/include-fixed; do
+         [ -d "$ver" ] || continue
+-        cp -a "$srcinc/." "$ver/" 2>/dev/null || true
++        cp -aL "$srcinc/." "$ver/" 2>/dev/null || true
+     done
+ }
+ 
+@@ -54,7 +58,8 @@ sync_to_sysroot() {
+     fi
+     if [ -d "$distdir/usr/include" ]; then
+         mkdir -p "$SYSROOT/include"
+-        cp -a "$distdir/usr/include/." "$SYSROOT/include/" 2>/dev/null || true
++        # -L: materialise symlinked headers as real files (see _mirror_to_fixinc).
++        cp -aL "$distdir/usr/include/." "$SYSROOT/include/" 2>/dev/null || true
+         _mirror_to_fixinc "$distdir/usr/include"
+     fi
+ }
+@@ -69,7 +74,9 @@ sync_native_libs_to_sysroot() {
+         [ -f "$dir/lib$name.a"    ] && cp "$dir/lib$name.a"    "$SYSROOT/lib/" 2>/dev/null || true
+     done
+     if [ -d "${SUBSTRATE_TOP}/include" ]; then
+-        cp -a "${SUBSTRATE_TOP}/include/." "$SYSROOT/include/" 2>/dev/null || true
++        # -L: substrate's include/ has symlinked headers (pthread.h ->
++        # ../lib/pthread/pthread.h); materialise them as real files.
++        cp -aL "${SUBSTRATE_TOP}/include/." "$SYSROOT/include/" 2>/dev/null || true
+         _mirror_to_fixinc "${SUBSTRATE_TOP}/include"
+     fi
+ }
+-- 
+2.54.0
+
diff --git a/patches/0083-contrib-hexchat-enable-SSL-OpenSSL-3.x-opaque-struct.patch b/patches/0083-contrib-hexchat-enable-SSL-OpenSSL-3.x-opaque-struct.patch
new file mode 100644
index 00000000..0132f676
--- /dev/null
+++ b/patches/0083-contrib-hexchat-enable-SSL-OpenSSL-3.x-opaque-struct.patch
@@ -0,0 +1,169 @@
+From a2fda31db4e831b8b7ff5d8bc512acce2cbe0871 Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Fri, 12 Jun 2026 08:45:51 -0500
+Subject: [PATCH 83/83] contrib/hexchat: enable SSL (OpenSSL 3.x opaque-struct
+ migration)
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+HexChat was built --disable-openssl, so it had no SSL despite OpenSSL 3.x
+being in the stack — secure IRC (ircs://) didn't work.  Enable it:
+
+- build.sh: --disable-openssl -> --enable-openssl; add
+  -Wno-error=deprecated-declarations (OpenSSL 3.x deprecates several APIs
+  HexChat 2.10.2 still uses; they work, just warn).
+- patches/0001-openssl-1.1-3.x-compat.patch: HexChat 2.10.2 (2014) reaches
+  into SSL/SSL_CTX/SSL_SESSION/X509/X509_STORE_CTX directly, which OpenSSL
+  1.1+/3.x made opaque.  Migrate to accessors: X509_PUBKEY_get0_param +
+  X509_get_signature_nid (ssl.c cert info), unconditional
+  SSL_set_connect_state (HexChat is always an SSL client),
+  X509_STORE_CTX_get_current_cert (server.c verify cb), and
+  SSL_get_session + SSL_SESSION_get_time (server.c handshake timeout).
+- fetch.sh: apply the patch series after extraction (idempotent), matching
+  the zlib/etc. convention, so a fresh fetch.sh + build.sh reproduces the
+  SSL-enabled build.
+
+The rebuilt binary links libssl.so.3 + libcrypto.so.3 (verified), and a
+fresh pristine extract + the patch reproduces the working source
+byte-identically.  Staged into rootfs.img.
+
+Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
+---
+ contrib/hexchat/build.sh                      |  5 +-
+ contrib/hexchat/fetch.sh                      | 17 +++++
+ .../patches/0001-openssl-1.1-3.x-compat.patch | 62 +++++++++++++++++++
+ contrib/hexchat/series                        |  1 +
+ 4 files changed, 83 insertions(+), 2 deletions(-)
+ create mode 100644 contrib/hexchat/patches/0001-openssl-1.1-3.x-compat.patch
+ create mode 100644 contrib/hexchat/series
+
+diff --git a/contrib/hexchat/build.sh b/contrib/hexchat/build.sh
+index c88ccb59..eb1ac1d3 100755
+--- a/contrib/hexchat/build.sh
++++ b/contrib/hexchat/build.sh
+@@ -21,7 +21,8 @@ export PYTHON=python3
+ export LDFLAGS="${LDFLAGS} -ldl"
+ export CFLAGS="-march=i486 -mtune=i486 -O2 -g -std=gnu11 \
+   -Wno-error=incompatible-pointer-types -Wno-error=int-conversion \
+-  -Wno-error=implicit-function-declaration -Wno-error=return-mismatch -Wno-error=format"
++  -Wno-error=implicit-function-declaration -Wno-error=return-mismatch -Wno-error=format \
++  -Wno-error=deprecated-declarations"
+ 
+ substrate_libtool_fix "${TREE_DIR}/configure"
+ # HexChat hardcodes source-relative paths for its generators
+@@ -33,7 +34,7 @@ make distclean >/dev/null 2>&1 || true
+ "${TREE_DIR}/configure" \
+     --host=i386-unknown-substrate \
+     --prefix=/usr --libdir=/usr/lib --includedir=/usr/include --sysconfdir=/etc \
+-    --enable-gtkfe --disable-openssl --enable-ipv6 \
++    --enable-gtkfe --enable-openssl --enable-ipv6 \
+     --disable-gtktest --disable-glibtest \
+     --disable-dbus --disable-libnotify --disable-libproxy \
+     --disable-perl --disable-python --disable-plugin \
+diff --git a/contrib/hexchat/fetch.sh b/contrib/hexchat/fetch.sh
+index 87c89a9a..c7491766 100755
+--- a/contrib/hexchat/fetch.sh
++++ b/contrib/hexchat/fetch.sh
+@@ -14,6 +14,23 @@ if [ ! -f "${TARBALL}" ]; then
+ fi
+ if [ "${SHA256}" != "REPLACE" ]; then echo "${SHA256}  ${TARBALL}" | sha256sum -c -; fi
+ [ -d "${TREE_DIR}" ] || { echo "==> Extracting"; tar xf "${TARBALL}"; }
++
++# Apply the substrate patch series (idempotent: skip already-applied).
++if [ -f "${HERE}/series" ]; then
++    cd "${TREE_DIR}"
++    while IFS= read -r p; do
++        case "$p" in ''|'#'*) continue ;; esac
++        if [ ! -f "${HERE}/patches/${p}" ]; then
++            echo "fetch.sh: missing patch ${p}" >&2; exit 1
++        fi
++        if patch -p1 --dry-run -s -R < "${HERE}/patches/${p}" >/dev/null 2>&1; then
++            echo "==> Patch ${p} already applied"; continue
++        fi
++        echo "==> Applying ${p}"; patch -p1 < "${HERE}/patches/${p}"
++    done < "${HERE}/series"
++    cd "${BUILD_DIR}"
++fi
++
+ . "${HERE}/../substrate-autotools.sh"
+ substrate_config_sub_fix "${TREE_DIR}"
+ echo "==> hexchat ${VERSION} ready at ${TREE_DIR}"
+diff --git a/contrib/hexchat/patches/0001-openssl-1.1-3.x-compat.patch b/contrib/hexchat/patches/0001-openssl-1.1-3.x-compat.patch
+new file mode 100644
+index 00000000..c2a334fb
+--- /dev/null
++++ b/contrib/hexchat/patches/0001-openssl-1.1-3.x-compat.patch
+@@ -0,0 +1,62 @@
++--- a/src/common/ssl.c
+++++ b/src/common/ssl.c
++@@ -177,8 +177,15 @@
++ 	broke_oneline (cert_info->subject, cert_info->subject_word);
++ 	broke_oneline (cert_info->issuer, cert_info->issuer_word);
++ 
++-	alg = OBJ_obj2nid (peer_cert->cert_info->key->algor->algorithm);
++-	sign_alg = OBJ_obj2nid (peer_cert->sig_alg->algorithm);
+++	/* OpenSSL 1.1+/3.x made X509 opaque; use accessors instead of
+++	 * reaching into ->cert_info / ->sig_alg directly. */
+++	{
+++		ASN1_OBJECT *palg = NULL;
+++		X509_PUBKEY_get0_param (&palg, NULL, NULL, NULL,
+++								X509_get_X509_PUBKEY (peer_cert));
+++		alg = OBJ_obj2nid (palg);
+++	}
+++	sign_alg = X509_get_signature_nid (peer_cert);
++ 	ASN1_TIME_snprintf (notBefore, sizeof (notBefore),
++ 							  X509_get_notBefore (peer_cert));
++ 	ASN1_TIME_snprintf (notAfter, sizeof (notAfter),
++@@ -303,10 +310,10 @@
++ 		__SSL_critical_error ("SSL_new");
++ 
++ 	SSL_set_fd (ssl, sd);
++-	if (ctx->method == SSLv23_client_method())
++-		SSL_set_connect_state (ssl);
++-	else
++-	        SSL_set_accept_state(ssl);
+++	/* SSL_CTX is opaque in OpenSSL 1.1+/3.x so we can no longer inspect
+++	 * ctx->method.  HexChat is always an SSL *client* for IRC, so always
+++	 * enter connect state. */
+++	SSL_set_connect_state (ssl);
++ 
++ 	return (ssl);
++ }
++--- a/src/common/server.c
+++++ b/src/common/server.c
++@@ -607,9 +607,11 @@
++ 	char buf[512];
++ 
++ 
++-	X509_NAME_oneline (X509_get_subject_name (ctx->current_cert), subject,
+++	X509 *current_cert = X509_STORE_CTX_get_current_cert (ctx);
+++
+++	X509_NAME_oneline (X509_get_subject_name (current_cert), subject,
++ 							 sizeof (subject));
++-	X509_NAME_oneline (X509_get_issuer_name (ctx->current_cert), issuer,
+++	X509_NAME_oneline (X509_get_issuer_name (current_cert), issuer,
++ 							 sizeof (issuer));
++ 
++ 	snprintf (buf, sizeof (buf), "* Subject: %s", subject);
++@@ -774,7 +776,9 @@
++ 		return (0);					  /* remove it (0) */
++ 	} else
++ 	{
++-		if (serv->ssl->session && serv->ssl->session->time + SSLTMOUT < time (NULL))
+++		/* SSL_SESSION is opaque in OpenSSL 1.1+/3.x; use accessors. */
+++		SSL_SESSION *sess = SSL_get_session (serv->ssl);
+++		if (sess && SSL_SESSION_get_time (sess) + SSLTMOUT < time (NULL))
++ 		{
++ 			snprintf (buf, sizeof (buf), "SSL handshake timed out");
++ 			EMIT_SIGNAL (XP_TE_CONNFAIL, serv->server_session, buf, NULL,
+diff --git a/contrib/hexchat/series b/contrib/hexchat/series
+new file mode 100644
+index 00000000..67e016e0
+--- /dev/null
++++ b/contrib/hexchat/series
+@@ -0,0 +1 @@
++0001-openssl-1.1-3.x-compat.patch
