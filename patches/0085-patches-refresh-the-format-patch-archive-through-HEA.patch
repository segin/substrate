@@ -0,0 +1,196 @@
+From 1b071b71dcb996dd738d34b9fdda739185704e09 Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Wed, 10 Jun 2026 13:42:20 -0500
+Subject: [PATCH 50/83] =?UTF-8?q?=F0=9F=A7=AA=20[testing]=20add=20missing?=
+ =?UTF-8?q?=20sysctl=20error=20tests=20and=20fix=20pointer=20truncation=20?=
+ =?UTF-8?q?(#1264)?=
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+Adds a test to `tests/lib/c/test_sysctl.c` to verify that `sysctl` correctly
+handles and translates the return value from the underlying syscall when it
+fails (returning -1 and setting errno appropriately).
+
+During test implementation, an issue was discovered and fixed in
+`lib/c/src/sysctl_helpers.c`: arguments passed to `_syscall6` were
+being cast to `(int)`, which truncates pointers on 64-bit platforms
+and causes segmentation faults. The definition of `_syscall6` and
+the calls were updated to safely use `intptr_t`.
+
+Additionally, the test file was refactored to `#include` the actual
+source file rather than relying on inline duplicates of the functions,
+ensuring real implementations are tested.
+
+Co-authored-by: google-labs-jules[bot] <161369871+google-labs-jules[bot]@users.noreply.github.com>
+Co-authored-by: segin <480709+segin@users.noreply.github.com>
+---
+ lib/c/src/sysctl_helpers.c |   4 +-
+ tests/lib/c/test_sysctl.c  | 100 +++++++++++++------------------------
+ 2 files changed, 37 insertions(+), 67 deletions(-)
+
+diff --git a/lib/c/src/sysctl_helpers.c b/lib/c/src/sysctl_helpers.c
+index c01dde10..d52fd1ba 100644
+--- a/lib/c/src/sysctl_helpers.c
++++ b/lib/c/src/sysctl_helpers.c
+@@ -5,7 +5,7 @@
+ #include <string.h>
+ #include <stdint.h>
+ 
+-extern int64_t _syscall6(int, int, int, int, int, int, int);
++extern int64_t _syscall6(int, intptr_t, intptr_t, intptr_t, intptr_t, intptr_t, intptr_t);
+ #define SYS_SYSCTL 243 // Matches sys/syscall.h syscall table
+ 
+ int sysctl(int *name, unsigned int namelen, void *oldp, size_t *oldlenp, void *newp, size_t newlen) {
+@@ -17,7 +17,7 @@ int sysctl(int *name, unsigned int namelen, void *oldp, size_t *oldlenp, void *n
+         errno = EINVAL;
+         return -1;
+     }
+-    int ret = (int)_syscall6(SYS_SYSCTL, (int)name, (int)namelen, (int)oldp, (int)oldlenp, (int)newp, (int)newlen);
++    int ret = (int)_syscall6(SYS_SYSCTL, (intptr_t)name, (intptr_t)namelen, (intptr_t)oldp, (intptr_t)oldlenp, (intptr_t)newp, (intptr_t)newlen);
+     if (ret < 0) {
+         errno = -ret;
+         return -1;
+diff --git a/tests/lib/c/test_sysctl.c b/tests/lib/c/test_sysctl.c
+index 8b90e040..225458f7 100644
+--- a/tests/lib/c/test_sysctl.c
++++ b/tests/lib/c/test_sysctl.c
+@@ -32,9 +32,20 @@ static int mock_errno  = 22; /* EINVAL */
+ static void *mock_last_newp = NULL;
+ static size_t mock_last_newlen = 0;
+ 
+-int64_t _syscall6(int num, int a1, int a2, int a3, int a4, int a5, int a6) {
+-	(void)num; (void)a1; (void)a2; (void)a3; (void)a4; (void)a5; (void)a6;
+-	if(mock_result < 0) errno = mock_errno;
++int64_t _syscall6(int num, intptr_t a1, intptr_t a2, intptr_t a3, intptr_t a4, intptr_t a5, intptr_t a6) {
++	if (num == 243) { /* SYS_SYSCTL */
++		mock_last_newp = (void *)(intptr_t)a5;
++		mock_last_newlen = (size_t)a6;
++		int *name = (int *)(intptr_t)a1;
++		unsigned int namelen = (unsigned int)a2;
++		void *oldp = (void *)(intptr_t)a3;
++		size_t *oldlenp = (size_t *)(intptr_t)a4;
++
++		if (oldlenp && !oldp && namelen == 2 && name && name[0] == 0 && name[1] == 3) {
++			*oldlenp = 2 * sizeof(int); /* Mock sysctlnametomib length response */
++		}
++	}
++
+ 	return mock_result;
+ }
+ 
+@@ -46,76 +57,25 @@ static void reset_mock(int result, int err) {
+ 	mock_last_newlen = 0;
+ }
+ 
+-/* ---- Inline implementations matching sysctl_helpers.c logic ---- */
++#include "../../../lib/c/src/sysctl_helpers.c"
+ 
+-#define SYS_SYSCTL 243
+-
+-int sysctl(int *name, unsigned int namelen, void *oldp, size_t *oldlenp, void *newp, size_t newlen) {
+-	if(!name || namelen < 1 || namelen > CTL_MAXNAME) { errno = 22; return -1; }
+-	if(newp && newlen == 0) { errno = 22; return -1; }
++/* wrappers in test that capture mock_last_newp after real function finishes */
++int test_sysctlbyname(const char *name, void *oldp, size_t *oldlenp, void *newp, size_t newlen) {
