diff --git a/patches/0025-ld.so-publish-environ-before-running-shared-library-.patch b/patches/0025-ld.so-publish-environ-before-running-shared-library-.patch
new file mode 100644
index 00000000..ab480e72
--- /dev/null
+++ b/patches/0025-ld.so-publish-environ-before-running-shared-library-.patch
@@ -0,0 +1,56 @@
+From 70974d511a3f66e45cb7639e7deb36790168b912 Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Tue, 9 Jun 2026 23:41:27 -0500
+Subject: [PATCH 25/83] ld.so: publish environ before running shared-library
+ constructors
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+crt0 assigns environ at program entry — AFTER ld.so's DT_INIT/init_array
+pass.  A constructor calling getenv() therefore walked a NULL environ.
+Normally latent (libc getenv tolerates it), it became a hard fault with
+dtksh: ksh93 interposes getenv(), the canonical-PLT rule binds every
+DSO's getenv to the exe's sh_getenv, and a CDE library constructor
+calling it crashed in oldgetenv before main (TRAP backtrace: ld.so init
+chain -> lib ctor -> getenv -> sh_getenv -> oldgetenv, addr 0x0).
+
+glibc's rtld sets __environ before constructors; do the same: resolve
+the canonical `environ` and store envp (from the kernel-built stack)
+right before ld_run_init_arrays().
+
+Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
+---
+ sbin/ld.so/ld_main.c | 16 ++++++++++++++++
+ 1 file changed, 16 insertions(+)
+
+diff --git a/sbin/ld.so/ld_main.c b/sbin/ld.so/ld_main.c
+index 11bde090..2d2181f7 100644
+--- a/sbin/ld.so/ld_main.c
++++ b/sbin/ld.so/ld_main.c
+@@ -566,6 +566,22 @@ ld_u32 ld_main(ld_u32 *initial_stack) {
+         for (;;) {}
+     }
+ 
++    /* glibc-rtld parity: publish `environ` BEFORE any constructor runs.
++     * crt0 only assigns it at program entry, which happens after the
++     * DT_INIT/init_array pass below — so a shared-library constructor
++     * calling getenv() (or an interposing getenv, e.g. ksh93/dtksh's
++     * sh_getenv) would otherwise walk a NULL environ and fault.
++     * ld_resolve returns the canonical symbol (the program's copy when
++     * it defines/copies one), which is the same object crt0 assigns. */
++    {
++        ld_u32 envaddr = ld_resolve("environ");
++        if (envaddr) {
++            ld_u32 argc = initial_stack[0];
++            char **envp = (char **)(initial_stack + 1 + argc + 1);
++            *(char ***)envaddr = envp;
++        }
++    }
++
+     /* Run constructors in dependency order: deepest deps first
+      * (= reverse of load order, since the program is at the head
+      * and its deepest dependency is at the tail). */
+-- 
+2.54.0
+
diff --git a/patches/0026-libc-add-cfmakeraw-3.patch b/patches/0026-libc-add-cfmakeraw-3.patch
new file mode 100644
index 00000000..14122d19
--- /dev/null
+++ b/patches/0026-libc-add-cfmakeraw-3.patch
@@ -0,0 +1,131 @@
+From 9a50eac0bfdcc2ddb564510fc82987227d8b7344 Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Tue, 9 Jun 2026 23:41:27 -0500
+Subject: [PATCH 26/83] libc: add cfmakeraw(3)
+
+BSD/glibc termios helper that configures a struct termios for raw mode
+(no input mangling, no OPOST, no echo/canonical/signals, 8-bit chars,
+VMIN=1/VTIME=0).  Needed by ksh93's pty builtin (the dtksh build) and
+common in ported software.  Man page included.
+
+Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
+---
+ include/termios.h        |  1 +
+ lib/c/src/posix_extra2.c | 13 ++++++++
+ usr.man/man3/cfmakeraw.3 | 68 ++++++++++++++++++++++++++++++++++++++++
+ 3 files changed, 82 insertions(+)
+ create mode 100644 usr.man/man3/cfmakeraw.3
+
+diff --git a/include/termios.h b/include/termios.h
+index a6c1c272..8d6f21c0 100644
+--- a/include/termios.h
++++ b/include/termios.h
+@@ -234,6 +234,7 @@ speed_t cfgetispeed(const struct termios *termios_p);
+ speed_t cfgetospeed(const struct termios *termios_p);
+ int     cfsetispeed(struct termios *termios_p, speed_t speed);
+ int     cfsetospeed(struct termios *termios_p, speed_t speed);
++void    cfmakeraw(struct termios *termios_p);
+ 
+ int     tcdrain(int fd);
+ int     tcflow(int fd, int action);
+diff --git a/lib/c/src/posix_extra2.c b/lib/c/src/posix_extra2.c
+index a39fd1b8..c23c1346 100644
+--- a/lib/c/src/posix_extra2.c
++++ b/lib/c/src/posix_extra2.c
+@@ -48,6 +48,19 @@ int cfsetospeed(struct termios *t, speed_t speed) {
+     return 0;
+ }
+ 
++void cfmakeraw(struct termios *t) {
++    /* BSD/glibc raw mode: no input mangling, no output post-processing,
++     * no echo/canonical/signals, 8-bit chars, read returns per byte. */
++    t->c_iflag &= ~(IGNBRK | BRKINT | PARMRK | ISTRIP |
++                    INLCR | IGNCR | ICRNL | IXON);
++    t->c_oflag &= ~OPOST;
++    t->c_lflag &= ~(ECHO | ECHONL | ICANON | ISIG | IEXTEN);
++    t->c_cflag &= ~(CSIZE | PARENB);
++    t->c_cflag |= CS8;
++    t->c_cc[VMIN] = 1;
++    t->c_cc[VTIME] = 0;
++}
++
+ int tcdrain(int fd) {
+     /* TCSBRK with arg=1 = "drain output", per termios spec. */
+     return ioctl(fd, TCSBRK, (void *)(uintptr_t)1);
+diff --git a/usr.man/man3/cfmakeraw.3 b/usr.man/man3/cfmakeraw.3
+new file mode 100644
+index 00000000..d9f1e2f8
+--- /dev/null
++++ b/usr.man/man3/cfmakeraw.3
+@@ -0,0 +1,68 @@
++.TH CFMAKERAW 3 2026-06-09 "Substrate" "Substrate Programmer's Manual"
++.SH NAME
++cfmakeraw \- set terminal attributes structure to raw mode
++.SH LIBRARY
++Standard C library
++.RI ( libc ", " \-lc )
++.SH SYNOPSIS
++.nf
++.B #include <termios.h>
++.PP
++.BI "void cfmakeraw(struct termios *" termios_p );
++.fi
++.SH DESCRIPTION
++.BR cfmakeraw ()
++modifies the
++.I termios
++structure pointed to by
++.I termios_p
++so that a terminal configured with it via
++.BR tcsetattr (3)
++operates in \(lqraw\(rq mode: input is available byte by byte
++.RI ( "c_cc[VMIN] = 1" ,
++.IR "c_cc[VTIME] = 0" ),
++echoing, canonical line editing and signal generation are disabled, no
++input or output post-processing is performed, and characters pass through
++as 8-bit values with parity disabled.
++.PP
++Specifically, it clears
++.BR IGNBRK ,
++.BR BRKINT ,
++.BR PARMRK ,
++.BR ISTRIP ,
++.BR INLCR ,
++.BR IGNCR ,
++.BR ICRNL
++and
++.B IXON
++in
++.IR c_iflag ;
++.B OPOST
++in
++.IR c_oflag ;
++.BR ECHO ,
++.BR ECHONL ,
++.BR ICANON ,
++.B ISIG
++and
++.B IEXTEN
++in
++.IR c_lflag ;
++clears
++.B CSIZE
++and
++.B PARENB
++and sets
++.B CS8
++in
++.IR c_cflag .
++.SH RETURN VALUE
++None.
++.SH ERRORS
++None.
++.SH CONFORMING TO
++BSD; also provided by glibc and musl.  Not specified by POSIX.
++.SH SEE ALSO
++.BR tcgetattr (3),
++.BR tcsetattr (3),
++.BR termios (3)
+-- 
+2.54.0
+
diff --git a/patches/0027-cde-cross-build-dtksh-AST-package-mamake-harness-wit.patch b/patches/0027-cde-cross-build-dtksh-AST-package-mamake-harness-wit.patch
new file mode 100644
index 00000000..2fa48092
--- /dev/null
+++ b/patches/0027-cde-cross-build-dtksh-AST-package-mamake-harness-wit.patch
@@ -0,0 +1,246 @@
+From 70b0f18f911fed076da8e8267b54565364197d11 Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Tue, 9 Jun 2026 23:41:27 -0500
+Subject: [PATCH 27/83] =?UTF-8?q?cde:=20cross-build=20dtksh=20=E2=80=94=20?=
+ =?UTF-8?q?AST=20package/mamake=20harness=20with=20qemu-backed=20iffe=20pr?=
+ =?UTF-8?q?obes?=
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+ksh93's AST build system was deferred on "mamake/iffe detect the build
+host and produce x86-64 objects".  The full harness, now scripted:
+
+- src/cmd/INIT/cc.linux.i386: package's own per-HOSTTYPE compiler
+  intercept, generated by build.sh to exec the substrate cross gcc with
+  -std=gnu99 (AST is K&R-era; gcc16's C23 default rejects its
+  empty-paren forward decls and implicit printf in iffe probes).  The
+  HOSTTYPE= placeholder line matters: package sed-patches it on
+  install, and its re-run path leaves $cc unset when the installed
+  intercept compares equal to the INIT source.
+- mamake runs natively: bootstrapped once via `package make INIT`
+  (errors out late in the CDE-trimmed tree but builds mamake first);
+  bin/package is copied into arch/<host>/bin so package's EXECROOT
+  discovery finds the host tools and flips into its CROSS=1 mode.
+- iffe output{}/run probes EXECUTE ON SUBSTRATE: hosttools installs
+  crossexec (hosttools/crossexec.d/), which boots a private copy of
+  rootfs.img headlessly in qemu (per-drive snapshot), feeds the probe
+  binary in via a scratch ext2 disk, and relays stdout/exit status over
+  serial with @@IFFE@@ line-prefix framing — kernel serial noise can't
+  forge it, and the guest never writes a disk the host must re-read
+  (substrate's ext2 writeback makes host e2fsprogs reject the image).
+  IFFEFLAGS="-x linux.i386" routes iffe's execute() through it, so
+  ksh93's FEATURE headers reflect real substrate behavior.
+- lcgen (the one self-run generator outside iffe) is pre-built for the
+  host so mamake skips the cross compile and the ./lcgen run works.
+
+Skipped gracefully until a rootfs.img exists to derive the exec image
+from (fresh checkouts: bake an image, run build.sh again).
+
+Produces a working /usr/dt/bin/dtksh (verified on substrate via
+crossexec: dtksh -c pwd) plus ksh93 libshell/libast/libcmd/libdll,
+staged into dist-cde.  Also required: the ld.so environ-before-
+constructors fix and libc cfmakeraw(3), committed separately.
+
+Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
+---
+ contrib/cde/build.sh                          | 60 +++++++++++++++++--
+ contrib/cde/hosttools/build.sh                | 21 +++++++
+ contrib/cde/hosttools/crossexec.d/crossexec   | 47 +++++++++++++++
+ contrib/cde/hosttools/crossexec.d/iffe-run.sh | 14 +++++
+ 4 files changed, 137 insertions(+), 5 deletions(-)
+ create mode 100755 contrib/cde/hosttools/crossexec.d/crossexec
+ create mode 100644 contrib/cde/hosttools/crossexec.d/iffe-run.sh
+
+diff --git a/contrib/cde/build.sh b/contrib/cde/build.sh
+index e9972fc1..843f3bde 100755
+--- a/contrib/cde/build.sh
++++ b/contrib/cde/build.sh
+@@ -91,11 +91,10 @@ echo "==> configure"
+     --with-tcl="${SR}/usr/lib"
+ 
+ # Deferred programs — each blocks on a separate effort, not a substrate gap:
+-#   dtksh : ksh93's AST mamake/iffe detects the BUILD host
+-#           (HOSTTYPE=linux.i386-64) and compiles libast/libcmd/libshell for
+-#           x86-64 instead of the i386 cross target; the final link fails on
+-#           incompatible objects.  (Substrate side done: libc symbol surface +
+-#           libiconv plain names.)
++#   dtksh : handled below via the AST cross harness (INIT cc intercept,
++#           native mamake, iffe probes run on substrate through hosttools
++#           crossexec).  Skipped until a rootfs.img exists to derive the
++#           crossexec exec image from.
+ #   dtappbuilder,
+ #   ttsnoop : RUN dtcodegen (links Motif) at build time to generate *_ui.h.
+ #           Handled below when hosttools provides dtcodegen-host (built
+@@ -265,6 +264,54 @@ else
+     echo "==> no hosttools cde-tools — dtdocbook/dtinfo skipped"
+ fi
+ 
++# --- dtksh: ksh93 (AST package/mamake) cross-harness ------------------------
++# ksh93's build system compiles AND RUNS feature probes (iffe) and one table
++# generator (lcgen).  The harness: an INIT cc.linux.i386 intercept makes
++# every compile use the substrate cross gcc (-std=gnu99: AST is K&R-era and
++# gcc16's C23 default rejects its empty-paren decls and implicit printf);
++# mamake/mamprobe run natively (bootstrapped once via `package make INIT`);
++# iffe's output{}/run probes execute ON SUBSTRATE through hosttools'
++# qemu-backed crossexec (IFFEFLAGS="-x linux.i386").  Needs a baked
++# rootfs.img-derived exec image — skipped on fresh checkouts until then.
++EXEC_IMG="${SUBSTRATE_EXEC_IMG:-/tmp/sub-exec.img}"
++if [ -x "${HOSTTOOLS}/crossexec" ] && [ -f "${EXEC_IMG}" ]; then
++    echo "==> dtksh (ksh93 via crossexec feature probes)"
++    KSHROOT="programs/dtksh/ksh93"
++    # per-HOSTTYPE compiler intercept (placeholder HOSTTYPE= line: package
++    # sed-patches it on install, and re-runs require source != installed)
++    printf 'HOSTTYPE=\nexec %s/bin/i386-unknown-substrate-gcc -std=gnu99 "$@"\n' "${STAGE1_PREFIX}" \
++        > "${KSHROOT}/src/cmd/INIT/cc.linux.i386"
++    chmod +x "${KSHROOT}/src/cmd/INIT/cc.linux.i386"
++    # purge target binaries a previous flat run may have left where the
++    # HOST must execute (bin/, and the host-arch INIT bootstrap dir)
++    for _f in "${KSHROOT}"/bin/*; do
++        file "${_f}" 2>/dev/null | grep -q 'ELF 32-bit LSB executable, Intel i386' && rm -f "${_f}"
++    done
++    # native mamake bootstrap (once): `package make INIT` errors out late
++    # (the CDE-trimmed tree has no INIT package) but builds bin/mamake first
++    _NATARCH=$(cd "${KSHROOT}" && bin/package host type 2>/dev/null || echo linux.i386-64)
++    if [ ! -x "${KSHROOT}/arch/${_NATARCH}/bin/mamake" ]; then
++        ( cd "${KSHROOT}" && PATH="${HOSTTOOLS}:/usr/bin:${PATH}" bin/package make INIT >/dev/null 2>&1 || true )
++    fi
++    [ -x "${KSHROOT}/arch/${_NATARCH}/bin/mamake" ] || \
++        { echo "build.sh: dtksh: native mamake bootstrap failed" >&2; exit 1; }
++    cp -f "${KSHROOT}/bin/package" "${KSHROOT}/arch/${_NATARCH}/bin/package"
++    # lcgen is the one self-run generator outside iffe — pre-place a host
++    # build so mamake skips the cross compile and the ./lcgen run works
++    mkdir -p "${KSHROOT}/arch/linux.i386/src/lib/libast"
++    cc -O -w -o "${KSHROOT}/arch/linux.i386/src/lib/libast/lcgen" \
++        "${KSHROOT}/src/lib/libast/port/lcgen.c"
++    _SHOPTS=$(make -C programs/dtksh -pn 2>/dev/null | grep -m1 '^KSH93_SHOPTS = ' | sed 's/^KSH93_SHOPTS = //')
++    ( cd "${KSHROOT}" && \
++      PATH="$PWD/arch/${_NATARCH}/bin:${HOSTTOOLS}:$PWD/bin:${STAGE1_PREFIX}/bin:/usr/bin:${PATH}" \
++      IFFEFLAGS="-x linux.i386" \
++      bin/package flat make HOSTTYPE=linux.i386 "CCFLAGS=${_SHOPTS}" )
++    make -C programs/dtksh -j"${JOBS}" \
++        GENCPP="${HOSTTOOLS}/tradcpp" LIBS="-ldl -lm -lsys -lstdc++ -liconv"
++else
++    echo "==> no crossexec exec image (${EXEC_IMG}) — dtksh skipped (bake an image, re-run)"
++fi
++
+ # Stage the built desktop into dist-cde (CDE installs under /usr/dt).  -k keeps
+ # going past the install-exec-hook `chown root` steps that fail in a non-root
+ # build (the setuid bits are re-applied when the image is baked); without -k the
+@@ -280,6 +327,9 @@ if [ -x "${CDETOOLS}/pmaker" ]; then
+     make -k -C programs/dtdocbook install DESTDIR="${SUBSTRATE_TOP}/dist-cde" GENCPP="${HOSTTOOLS}/tradcpp" LIBS="${DOCLIBS}" || true
+     make -k -C programs/dtinfo    install DESTDIR="${SUBSTRATE_TOP}/dist-cde" GENCPP="${HOSTTOOLS}/tradcpp" CFLAGS="${DTINFO_CFLAGS}" LIBS="${DOCLIBS}" || true
+ fi
++if [ -x "${HOSTTOOLS}/crossexec" ] && [ -f "${EXEC_IMG}" ]; then
++    make -k -C programs/dtksh install DESTDIR="${SUBSTRATE_TOP}/dist-cde" GENCPP="${HOSTTOOLS}/tradcpp" LIBS="-ldl -lm -lsys -lstdc++ -liconv" || true
++fi
+ 
+ # CDE's configure bakes the build-host ksh path (the hosttools mksh-as-ksh it
+ # found at build time) into the `#!` line of every generated ksh script —
+diff --git a/contrib/cde/hosttools/build.sh b/contrib/cde/hosttools/build.sh
+index 2dec4090..6656f0cc 100755
+--- a/contrib/cde/hosttools/build.sh
++++ b/contrib/cde/hosttools/build.sh
+@@ -200,5 +200,26 @@ if [ ! -x "${PREFIX}/cde-tools/pmaker" ]; then
+     echo "==> cde-tools (pmaker dfiles msgsets mkdbd) ready"
+ fi
+ 
++# --- crossexec: run substrate binaries during builds (AST iffe probes) ------
++# Boots a private copy of the substrate root image headlessly in qemu and
++# relays the binary's stdout/exit status over a noise-proof serial protocol.
++# The dtksh/ksh93 cross build points iffe at it (IFFEFLAGS="-x linux.i386").
++# Needs a baked rootfs.img — on a fresh checkout run build.sh again after the
++# first image bake to pick dtksh up.
++install -m755 "${HERE}/crossexec.d/crossexec" "${PREFIX}/bin/crossexec"
++EXEC_IMG="${SUBSTRATE_EXEC_IMG:-/tmp/sub-exec.img}"
++if [ ! -f "${EXEC_IMG}" ] && [ -f "${SUBSTRATE_TOP}/rootfs.img" ]; then
++    echo "==> crossexec: preparing exec image at ${EXEC_IMG}"
++    cp --reflink=auto "${SUBSTRATE_TOP}/rootfs.img" "${EXEC_IMG}"
++fi
++if [ -f "${EXEC_IMG}" ]; then
++    debugfs -w -R "rm /root/iffe-run.sh" "${EXEC_IMG}" >/dev/null 2>&1 || true
++    debugfs -w -R "write ${HERE}/crossexec.d/iffe-run.sh /root/iffe-run.sh" "${EXEC_IMG}" >/dev/null 2>&1
++    debugfs -w -R "sif /root/iffe-run.sh mode 0100755" "${EXEC_IMG}" >/dev/null 2>&1
++    echo "==> crossexec ready (exec image: ${EXEC_IMG})"
++else
++    echo "hosttools: NOTE: no rootfs.img yet — crossexec installed but unusable until an image is baked (dtksh will be skipped)" >&2
++fi
++
+ echo "==> host tools ready in ${PREFIX}/bin:"
+ echo "    $(cd "${PREFIX}/bin" && ls | tr '\n' ' ')"
+diff --git a/contrib/cde/hosttools/crossexec.d/crossexec b/contrib/cde/hosttools/crossexec.d/crossexec
+new file mode 100755
+index 00000000..ba5ba96e
+--- /dev/null
++++ b/contrib/cde/hosttools/crossexec.d/crossexec
+@@ -0,0 +1,47 @@
++#!/bin/bash
++# crossexec for the substrate target: runs a cross-compiled binary inside a
++# headless qemu boot of a private copy of the substrate root image (read-only
++# via per-drive snapshot) and relays its stdout + exit status, which travel
++# via a scratch ext2 disk — NOT the serial line, which carries kernel noise.
++# Used by AST iffe (IFFEFLAGS="-x linux.i386") during the dtksh cross build.
++# Usage: crossexec <crosstype> <command> [arg...]
++set -u
++shift   # crosstype
++CMD="$1"; shift || true
++IMG="${SUBSTRATE_EXEC_IMG:-/tmp/sub-exec.img}"
++[ -f "$IMG" ] || { echo "crossexec: $IMG missing (cp rootfs.img there + inject /root/iffe-run.sh)" >&2; exit 125; }
++W=$(mktemp -d /tmp/crossexec.XXXXXX)
++trap 'rm -rf "$W"' EXIT
++dd if=/dev/zero of="$W/scratch.img" bs=1M count=32 status=none
++/usr/bin/mke2fs -q -F -b 1024 "$W/scratch.img"
++debugfs -w -R "write $CMD cmd" "$W/scratch.img" >/dev/null 2>&1
++{ printf '%s ' "$@"; } > "$W/args"
++debugfs -w -R "write $W/args args" "$W/scratch.img" >/dev/null 2>&1
++timeout 90 qemu-system-i386 -cpu qemu32,+sse,+sse2,+rdrand -accel kvm \
++  -kernel "${SUBSTRATE_KERNEL:-$(dirname "$0")/../../../../sys/kernel.multiboot}" -m 256M -display none -no-reboot \
++  -device ahci,id=ahci0 \
++  -drive file="$IMG",format=raw,if=none,id=rd,snapshot=on,file.locking=off \
++  -device ide-hd,drive=rd,bus=ahci0.0 \
++  -drive file="$W/scratch.img",format=raw,if=none,id=sd \
++  -device ide-hd,drive=sd,bus=ahci0.1 \
++  -serial file:"$W/ser.txt" \
++  -append "serial_debug root=/dev/storage/sata0 init=/root/iffe-run.sh" &
++QP=$!
++for i in $(seq 1 80); do
++  grep -qa '@@IFFE-RC@@' "$W/ser.txt" 2>/dev/null && break
++  sleep 1
++done
++sleep 1
++kill -9 $QP 2>/dev/null; wait $QP 2>/dev/null
++# results come back over serial: payload lines carry the @@IFFE@@ prefix,
++# the exit status rides @@IFFE-RC@@; kernel serial noise has neither.
++if ! grep -qa '@@IFFE-RC@@' "$W/ser.txt" 2>/dev/null; then
++    K=/tmp/crossexec-fail.$$
++    cp -a "$W" "$K" 2>/dev/null
++    cp -f "$CMD" "$K/cmd.host" 2>/dev/null
++    echo "crossexec: guest run failed (evidence: $K)" >&2
++    exit 124
++fi
++tr -d '\r' < "$W/ser.txt" | sed -n 's/^@@IFFE@@//p'
++RC=$(tr -d '\r' < "$W/ser.txt" | sed -n 's/^@@IFFE-RC@@\([0-9]*\).*/\1/p' | head -1)
++exit "${RC:-124}"
+diff --git a/contrib/cde/hosttools/crossexec.d/iffe-run.sh b/contrib/cde/hosttools/crossexec.d/iffe-run.sh
+new file mode 100644
+index 00000000..bf440c33
+--- /dev/null
++++ b/contrib/cde/hosttools/crossexec.d/iffe-run.sh
+@@ -0,0 +1,14 @@
++#!/bin/sh
++export PATH=/usr/sbin:/usr/bin:/sbin:/bin
++mkdir -p /mnt 2>/dev/null
++mount /dev/storage/sata1 /mnt ext2
++cd /tmp
++cp /mnt/cmd ./cmd 2>/dev/null
++chmod +x ./cmd 2>/dev/null
++./cmd $(cat /mnt/args 2>/dev/null) < /dev/null > /tmp/out.txt 2>/dev/null
++rc=$?
++while IFS= read -r line; do
++    echo "@@IFFE@@$line"
++done < /tmp/out.txt
++echo "@@IFFE-RC@@$rc"
++while :; do sleep 1000; done
+-- 
+2.54.0
+
diff --git a/patches/0028-AGENTS.md-dtksh-dtinfo-dtdocbook-now-build-ld.so-env.patch b/patches/0028-AGENTS.md-dtksh-dtinfo-dtdocbook-now-build-ld.so-env.patch
new file mode 100644
index 00000000..824dd7ae
--- /dev/null
+++ b/patches/0028-AGENTS.md-dtksh-dtinfo-dtdocbook-now-build-ld.so-env.patch
@@ -0,0 +1,55 @@
+From 1e82daa20714ec048f56954b56d70767d67d702b Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Tue, 9 Jun 2026 23:42:00 -0500
+Subject: [PATCH 28/83] AGENTS.md: dtksh/dtinfo/dtdocbook now build; ld.so
+ environ-before-ctors note Co-Authored-By: Claude Opus 4.8 (1M context)
+ <noreply@anthropic.com>
+
+---
+ AGENTS.md | 23 +++++++++++++++++------
+ 1 file changed, 17 insertions(+), 6 deletions(-)
+
+diff --git a/AGENTS.md b/AGENTS.md
+index 8280861a..49773daf 100644
+--- a/AGENTS.md
++++ b/AGENTS.md
+@@ -373,11 +373,18 @@ manifest, `README.SUBSTRATE.md`.  Current set:
+   set by configure), libABil's yacc globals renamed (collide with
+   Motif libUil.a's), ttsnoop's local `_tt_sigset` renamed (collides
+   with libtt.a's).  Without a host Motif both programs are skipped, as
+-  before.  Still deferred (each a separate host-tooling effort,
+-  documented in `build.sh`): dtksh (ksh93 AST mamake cross-build),
