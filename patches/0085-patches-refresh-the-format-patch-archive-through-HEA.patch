diff --git a/patches/0059-futex-complete-op-set-fix-timed-wait-EINTR-hangs-wir.patch b/patches/0059-futex-complete-op-set-fix-timed-wait-EINTR-hangs-wir.patch
new file mode 100644
index 00000000..9cffeeec
--- /dev/null
+++ b/patches/0059-futex-complete-op-set-fix-timed-wait-EINTR-hangs-wir.patch
@@ -0,0 +1,1431 @@
+From 851b09915c31ac53e63ebaab89f527446a603b91 Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Wed, 10 Jun 2026 19:17:01 -0500
+Subject: [PATCH 59/83] futex: complete op set, fix timed-wait/EINTR hangs,
+ wire NetBSD+OpenBSD
+
+Implement the missing futex ops and fix the lost-wakeup bugs behind the
+HexChat (glib g_cond_wait_until) hang, plus a 137-checkpoint torture test.
+
+Ops (sys/kern/futex.c, sys/kern/sleepq.c):
+- FUTEX_WAIT_BITSET / FUTEX_WAKE_BITSET: new thread_t.futex_bitset wait
+  mask + sleepq_wake_bitset() that wakes only waiters whose mask overlaps;
+  plain FUTEX_WAIT registers MATCH_ANY.  WAIT_BITSET honours absolute
+  timeouts.
+- FUTEX_WAKE_OP: full op/cmp/oparg/cmparg decode (incl. OPARG_SHIFT),
+  atomic *uaddr2 update, conditional second wake.
+
+Lost-wakeup / EINTR fixes:
+- A timed FUTEX_WAIT that timed out was left linked on the sleepq
+  (sched_tick only flips state, never unlinks); a later FUTEX_WAKE on the
+  same address consumed the dangling entry and the real waiter blocked for
+  its full timeout -- the HexChat hang.  The waiter now self-removes from
+  the sleepq on wake and resets sleep_status per wait.
+- sys_thr_kill only set sig_pending and never woke a target parked in an
+  interruptible sleep, so pthread_kill never delivered EINTR to a futex
+  waiter.  Add signal_wake_thread() and call it from thr_kill/thr_kill2;
+  the futex WAIT path marks itself THREAD_F_INTERRUPTIBLE and honours EINTR.
+
+Personalities: NetBSD __futex (166, 7-arg, val2 repacked into the timeout
+slot) and OpenBSD futex (331, 5-arg, op-number remap) route to sys_futex.
+
+Kernel hardening (the test surfaced this): i386_extract_syscall_args read
+useresp[1..8] directly, so a thread whose esp sat within 0x20 of its stack
+top made the unconditional 8-word read overrun the mapping and PANIC the
+kernel.  Read fault-safely via copyin (bulk fast path + word-by-word
+fallback); a bad user esp can no longer panic the kernel.
+
+Test: tests/lib/futex/ (137 checks, 137/137 on Linux; all futex-semantic
+sections pass on substrate).  Wired into build-rootfs.sh.
+
+Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
+---
+ build-rootfs.sh                           |   3 +-
+ sys/arch/i386/syscall_abi.h               |  32 +-
+ sys/exec/perso/netbsd/netbsd_syscalls.h   |   1 +
+ sys/exec/perso/openbsd/openbsd_syscalls.h |   1 +
+ sys/exec/perso/perso_netbsd.c             |  32 ++
+ sys/exec/perso/perso_openbsd.c            |  33 ++
+ sys/include/sys/futex.h                   |   8 +
+ sys/include/sys/proc.h                    |   1 +
+ sys/include/sys/signal.h                  |   2 +
+ sys/kern/futex.c                          | 195 ++++++-
+ sys/kern/signal.c                         |  21 +
+ sys/kern/sleepq.c                         |  64 +++
+ sys/kern/sleepq.h                         |   2 +
+ sys/kern/syscall.c                        |   7 +-
+ tests/lib/futex/.gitignore                |   2 +
+ tests/lib/futex/Makefile                  |  35 ++
+ tests/lib/futex/torture_futex.c           | 620 ++++++++++++++++++++++
+ 17 files changed, 1035 insertions(+), 24 deletions(-)
+ create mode 100644 tests/lib/futex/.gitignore
+ create mode 100644 tests/lib/futex/Makefile
+ create mode 100644 tests/lib/futex/torture_futex.c
+
+diff --git a/build-rootfs.sh b/build-rootfs.sh
+index f43b6de0..beb21877 100755
+--- a/build-rootfs.sh
++++ b/build-rootfs.sh
+@@ -182,7 +182,7 @@ build_components() {
+     # ready for install_to_dist() to drop into /tmp on the image.
+     # Each Makefile follows the CROSS=PREFIX convention; the listed
+     # subdirs each produce one or more standalone test programs.
+-    for dir in "$TOP/tests/lib/sockets" "$TOP/tests/lib/ipc" "$TOP/tests/lib/pty" "$TOP/tests/lib/signal"; do
++    for dir in "$TOP/tests/lib/sockets" "$TOP/tests/lib/ipc" "$TOP/tests/lib/pty" "$TOP/tests/lib/signal" "$TOP/tests/lib/futex"; do
+         if [ -f "$dir/Makefile" ]; then
+             make -C "$dir" clean >/dev/null
+             # Tolerant: a broken test build (e.g. cross-libc out of sync)
+@@ -507,6 +507,7 @@ install_to_dist() {
+         "tests/lib/ipc:torture_sem" \
+         "tests/lib/pty:torture_pty" \
+         "tests/lib/signal:torture_signal" \
++        "tests/lib/futex:torture_futex" \
+         "tests/lib/c:torture_fcntl" \
+         "tests/lib/c:torture_malloc" \
+         "tests/lib/c:torture_procs" \
+diff --git a/sys/arch/i386/syscall_abi.h b/sys/arch/i386/syscall_abi.h
+index db7bfe75..1f86f9f0 100644
+--- a/sys/arch/i386/syscall_abi.h
++++ b/sys/arch/i386/syscall_abi.h
+@@ -5,6 +5,7 @@
+ #include <string.h>
+ #include <arch/i386/idt.h>
+ #include <exec/perso/personality.h>
++#include <sys/copy.h>
+ 
+ static inline void i386_extract_syscall_args(const struct personality *p,
+                                              const registers_t *regs,
+@@ -28,16 +29,27 @@ static inline void i386_extract_syscall_args(const struct personality *p,
+          * below and saw garbage args (manifested as ld.elf_so's mmap()
+          * appearing to "succeed" with bogus low addresses → SIGSEGV in
+          * imalloc on first writeback). */
+-        const uint32_t *user_stack = (const uint32_t *)(uintptr_t)regs->useresp;
+-
+-        args[0] = user_stack[1];
+-        args[1] = user_stack[2];
+-        args[2] = user_stack[3];
+-        args[3] = user_stack[4];
+-        args[4] = user_stack[5];
+-        args[5] = user_stack[6];
+-        args[6] = user_stack[7];
+-        args[7] = user_stack[8];
++        /*
++         * Args are the cdecl-pushed words at useresp[1..8] (useresp[0] is
++         * the libc stub's return address).  Read them fault-safely via
++         * copyin: a thread whose esp sits within 0x20 of the TOP of its
++         * (pthread) stack mapping would otherwise have this unconditional
++         * 8-word read overrun the mapping and page-fault the KERNEL while
++         * extracting args -- a userspace stack state must never panic the
++         * kernel.  Real syscalls use <= 6 args, so the overrun words are
++         * unused; on the rare near-top esp the bulk read fails and we fall
++         * back to word-by-word, stopping at the first unreadable word (the
++         * remaining args stay zero from the memset above).
++         */
++        const char *sp = (const char *)(uintptr_t)regs->useresp + sizeof(uint32_t);
++        if (copyin(sp, args, 8 * sizeof(uint32_t)) != 0) {
++            memset(args, 0, sizeof(uint32_t) * 8);
