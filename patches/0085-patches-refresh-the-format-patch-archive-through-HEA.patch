+     int base = type & SOCK_TYPE_MASK;
+-    if (base != SOCK_STREAM) return -EPROTONOSUPPORT;
++    if (base != SOCK_STREAM && base != SOCK_DGRAM) return -EPROTONOSUPPORT;
+     afunix_sock_t *a = afunix_alloc(base);
+     afunix_sock_t *b = afunix_alloc(base);
+     if (!a || !b) {
