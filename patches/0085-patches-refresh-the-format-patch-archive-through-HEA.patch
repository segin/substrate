++                z -= pio2_2;
++                y[0] = z - pio2_2t;
++                y[1] = (z - y[0]) - pio2_2t;
++            }
++            return 1;
++        } else { /* negative x */
++            z = x + pio2_1;
++            if (ix != 0x3ff921fb) { /* 33+53 bit pi is enough */
++                y[0] = z + pio2_1t;
++                y[1] = (z - y[0]) + pio2_1t;
++            } else { /* near pi/2, use 33+33+53 bit pi */
++                z += pio2_2;
++                y[0] = z + pio2_2t;
++                y[1] = (z - y[0]) + pio2_2t;
++            }
