+diff --git a/contrib/cde/hosttools/build.sh b/contrib/cde/hosttools/build.sh
+index c3656a8e..2dec4090 100755
+--- a/contrib/cde/hosttools/build.sh
++++ b/contrib/cde/hosttools/build.sh
+@@ -137,36 +137,41 @@ fi
