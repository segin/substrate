diff --git a/patches/0070-userland-fix-audit-security-bugs-crypt-overflow-arch.patch b/patches/0070-userland-fix-audit-security-bugs-crypt-overflow-arch.patch
new file mode 100644
index 00000000..8fc0dfb7
--- /dev/null
+++ b/patches/0070-userland-fix-audit-security-bugs-crypt-overflow-arch.patch
@@ -0,0 +1,318 @@
+From 916d1ad5285bfb1d2668aa1f5d39a86d75bd68a8 Mon Sep 17 00:00:00 2001
+From: Kirn Gill II <segin2005@gmail.com>
+Date: Thu, 11 Jun 2026 15:59:50 -0500
+Subject: [PATCH 70/83] userland: fix audit security bugs (crypt overflow,
+ archive overflow/traversal, bc)
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+- libc crypt_sha256.c: __crypt_sha256 memcpy'd strlen(key) bytes into a
+  fixed uint8_t P[32] on the stack — a password >32 bytes smashed the stack
+  of every setuid authenticator (login/su/passwd).  P and S are now malloc'd
+  to the real key/salt length with a scrub+free cleanup path.  (No $6$/
+  crypt_sha512 exists in-tree.)
+- ar(1): a `#1/N` long-name member's name_len (atoi of the header) was
+  unvalidated; negative/oversized values wrapped malloc/read sizes and wrote
+  before the buffer.  Reject name_len < 0 || name_len > member size.
+- pax(1): the tar octal size field was parsed into an int; a large/wrapping
+  value undersized malloc(sz+1) then overflowed on read.  Parse as
+  unsigned long long (strtoull) and range-check before truncating to size_t.
+- tar/pax/cpio extraction: name `..`/absolute sanitization was already
+  present, but a symlink member could redirect a later regular-file write
+  outside the tree.  unlink the destination before creating each regular
+  file and symlink (+ O_NOFOLLOW belt-and-suspenders).
+- bc(1): get_arr_val/set_arr_val bounded idx<0 but not the upper end; the
+  (idx+1)*2 / capacity-doubling overflowed int to a small/negative capacity,
+  undersizing the allocation while array[idx] was written.  Cap idx at
+  BC_DIM_MAX (16M).
+
+Found by a security audit.
+
+Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
+---
+ bin/bc/bc.c              | 15 +++++++++++++--
+ bin/tar/tar.c            | 14 +++++++++++---
+ lib/c/src/crypt_sha256.c | 28 +++++++++++++++++++++-------
+ usr.bin/ar/ar.c          | 10 ++++++++++
+ usr.bin/cpio/cpio.c      |  6 +++++-
+ usr.bin/pax/pax.c        | 27 +++++++++++++++++++++------
+ 6 files changed, 81 insertions(+), 19 deletions(-)
+
+diff --git a/bin/bc/bc.c b/bin/bc/bc.c
+index ca330f4c..06a2d8e2 100644
+--- a/bin/bc/bc.c
++++ b/bin/bc/bc.c
+@@ -12,6 +12,17 @@
+ #include <unistd.h>
+ #include "num.h"
+ 
++/*
++ * Upper bound on an array index.  The capacity growth below computes
++ * (idx + 1) * 2 and repeatedly doubles new_cap as an int; an unbounded
++ * attacker-controlled idx overflows that arithmetic to a small or
++ * negative capacity, undersizing the allocation while array[idx] is
++ * still written — a heap out-of-bounds write.  POSIX guarantees
++ * BC_DIM_MAX >= 65535; capping well below INT_MAX keeps the doubling
++ * arithmetic from overflowing.
++ */
++#define BC_DIM_MAX 16777216  /* 2^24 elements */
++
+ // Configuration
+ int opt_s = 0; // POSIX strict mode
+ int opt_w = 0; // Warn on extensions
+@@ -1102,7 +1113,7 @@ bc_num *get_var_val(const char *name) {
+ }
+ 
+ bc_num *get_arr_val(const char *name, int idx) {
+-    if (idx < 0) lex_error("array index out of bounds");
++    if (idx < 0 || idx >= BC_DIM_MAX) lex_error("array index out of bounds");
+     local_var_t *l = get_local(name);
+     if (l) {
+         if (!l->array) {
+@@ -1185,7 +1196,7 @@ void set_var_val(const char *name, bc_num *val) {
+ }
+ 
+ void set_arr_val(const char *name, int idx, bc_num *val) {
+-    if (idx < 0) lex_error("array index out of bounds");
++    if (idx < 0 || idx >= BC_DIM_MAX) lex_error("array index out of bounds");
+     local_var_t *l = get_local(name);
+     if (l) {
+         if (!l->array) {
+diff --git a/bin/tar/tar.c b/bin/tar/tar.c
+index dd51573c..463e11e6 100644
+--- a/bin/tar/tar.c
++++ b/bin/tar/tar.c
+@@ -476,7 +476,13 @@ static int extract_reg(FILE *in, const char *path, off_t size) {
