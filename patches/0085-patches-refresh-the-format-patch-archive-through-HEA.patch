++/* fpatan: atan(y/x) at 80-bit width. */
++static inline long double x87_atan2l(long double y, long double x) {
++    long double res;
++    __asm__ __volatile__("fldt %1; fldt %2; fpatan; fstpt %0"
++                         : "=m"(res) : "m"(y), "m"(x));
++    return res;
++}
