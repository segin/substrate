+--- a/lib/c/src/crypt_sha256.c
++++ b/lib/c/src/crypt_sha256.c
+@@ -57,7 +57,8 @@ char *
+ __crypt_sha256(const char *key, const char *setting, char *out, size_t outsz)
+ {
+     sha256_ctx    ctxA, ctxB, ctxDP, ctxDS;
+-    uint8_t       altA[32], P[32], S[32], temp[32];
