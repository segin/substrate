+     /* `*count` is the array capacity on entry, the filled count on
+      * return — the kernel reads it, then overwrites it. */
+-    return syscall(SYS_VM_SLABS, slabs, count);
++    return (int)__sysret(syscall(SYS_VM_SLABS, slabs, count));
