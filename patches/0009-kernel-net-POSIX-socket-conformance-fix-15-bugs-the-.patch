+int afinet_set_reuseaddr(int fd, int on) {
+    afi_sock_t *s = afi_from_fd(fd);
+    if (!s) return -ENOTSOCK;
+    s->reuseaddr = on ? 1 : 0;
+    return 0;
+}
+int afinet_get_reuseaddr(int fd) {
+    afi_sock_t *s = afi_from_fd(fd);
+    if (!s) return -ENOTSOCK;
+    return s->reuseaddr;
+}
