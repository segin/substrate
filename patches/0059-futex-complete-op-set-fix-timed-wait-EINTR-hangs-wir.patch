@@ -375,14 +402,41 @@ int sys_futex(int *uaddr, int op, int val, void *timeout, int *uaddr2, int val3)
                 }
 
                 uint64_t hz = get_hz();
-                uint64_t ticks = (uint64_t)ts.tv_sec * hz;
-                ticks += ((uint64_t)ts.tv_nsec * hz) / 1000000000ULL;
