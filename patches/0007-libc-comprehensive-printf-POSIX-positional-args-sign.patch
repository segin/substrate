+    S("%5d", 42); S("%-5d", 42); S("%05d", 42); S("%+d", 42); S("% d", 42);
+    S("%8.4d", 42); S("%-8.4d", 42); S("%.0d", 0); S("%.5d", 123);
+    S("%+08d", -7); S("%x", 255); S("%X", 255); S("%#x", 255); S("%#X", 0);
+    S("%o", 64); S("%#o", 64); S("%u", 4000000000U); S("%10.6x", 0xab);
