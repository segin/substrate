+#define CK(strict, expr_sub, expr_ref) do {                                   \
+    char a[512], b[512];                                                      \
+    expr_sub; expr_ref;                                                       \
+    if (strcmp(a, b) == 0) pass++;                                            \
+    else if (strict) { fail++; printf("FAIL: got[%s] want[%s]\n", a, b); }    \
+    else { finfo++; }                                                         \
+} while (0)
