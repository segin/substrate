+#define S(fmt, ...) CK(1, sub_snprintf(a,sizeof a,fmt,##__VA_ARGS__), snprintf(b,sizeof b,fmt,##__VA_ARGS__))
+#define F(fmt, ...) CK(0, sub_snprintf(a,sizeof a,fmt,##__VA_ARGS__), snprintf(b,sizeof b,fmt,##__VA_ARGS__))
+
