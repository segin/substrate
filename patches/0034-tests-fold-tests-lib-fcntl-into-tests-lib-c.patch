From e1c27d6ec2d51717cb238c1e44635122d795c8be Mon Sep 17 00:00:00 2001
From: Kirn Gill II <segin2005@gmail.com>
Date: Wed, 10 Jun 2026 06:55:14 -0500
Subject: [PATCH 34/83] tests: fold tests/lib/fcntl into tests/lib/c

The fcntl/dup/dup2/dup3 stress is a libc test, so it belongs with its
siblings in tests/lib/c (per the tests/lib/<lib>/ convention).  Move
torture_fcntl.c there and its Makefile as Makefile.fcntl (parallel to
the existing Makefile.sockets), drop the empty tests/lib/fcntl/.

build-rootfs.sh now builds it via `make -C tests/lib/c -f Makefile.fcntl`
(tests/lib/c has per-target makefiles, not one default) and stages it
from tests/lib/c.

Also: the old tree had the COMPILED torture_fcntl ELF checked in.  Remove
it and add a .gitignore rule so the extensionless test binaries under
tests/lib/c (torture_*/test_*/repro_*) stay out while their .c/.h sources
remain tracked.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .gitignore                                     |  10 ++++++++++
 build-rootfs.sh                                |  10 ++++++++--
 tests/lib/{fcntl/Makefile => c/Makefile.fcntl} |   2 +-
 tests/lib/{fcntl => c}/torture_fcntl.c         |   0
 tests/lib/fcntl/torture_fcntl                  | Bin 37984 -> 0 bytes
 5 files changed, 19 insertions(+), 3 deletions(-)
 rename tests/lib/{fcntl/Makefile => c/Makefile.fcntl} (95%)
 rename tests/lib/{fcntl => c}/torture_fcntl.c (100%)
 delete mode 100755 tests/lib/fcntl/torture_fcntl

diff --git a/.gitignore b/.gitignore
index 0e02663a..234f1a08 100644
--- a/.gitignore
+++ b/.gitignore
@@ -457,3 +457,13 @@ rootfs.img.zst
 contrib/matwm2/build/
 contrib/matwm2/matwm2-master.tar.gz
 tests/sys/fb/fbmouse
+
+# tests/lib/c compiled test binaries (sources are torture_*.c / test_*.c /
+# repro_*.c; the extensionless build outputs alongside them are artifacts).
+tests/lib/c/torture_*
+!tests/lib/c/torture_*.c
+tests/lib/c/test_*
+!tests/lib/c/test_*.c
+!tests/lib/c/test_*.h
+tests/lib/c/repro_*
+!tests/lib/c/repro_*.c
diff --git a/build-rootfs.sh b/build-rootfs.sh
index b725e720..f43b6de0 100755
--- a/build-rootfs.sh
+++ b/build-rootfs.sh
@@ -182,7 +182,7 @@ build_components() {
     # ready for install_to_dist() to drop into /tmp on the image.
     # Each Makefile follows the CROSS=PREFIX convention; the listed
     # subdirs each produce one or more standalone test programs.
-    for dir in "$TOP/tests/lib/sockets" "$TOP/tests/lib/ipc" "$TOP/tests/lib/pty" "$TOP/tests/lib/signal" "$TOP/tests/lib/fcntl"; do
+    for dir in "$TOP/tests/lib/sockets" "$TOP/tests/lib/ipc" "$TOP/tests/lib/pty" "$TOP/tests/lib/signal"; do
         if [ -f "$dir/Makefile" ]; then
             make -C "$dir" clean >/dev/null
             # Tolerant: a broken test build (e.g. cross-libc out of sync)
@@ -193,6 +193,12 @@ build_components() {
                 || echo "build-rootfs: warning: failed to build $dir, skipping"
         fi
     done
+    # tests/lib/c is a grab-bag of libc tests with per-target makefiles
+    # (Makefile.fcntl, ...) rather than a single default Makefile.
+    make -C "$TOP/tests/lib/c" -f Makefile.fcntl clean >/dev/null 2>&1 || true
+    make -C "$TOP/tests/lib/c" -f Makefile.fcntl \
+        CROSS=/opt/substrate/bin/i386-unknown-substrate- -j4 \
+        || echo "build-rootfs: warning: failed to build tests/lib/c torture_fcntl, skipping"
 }
 
 finalize_x_fonts() {
@@ -501,7 +507,7 @@ install_to_dist() {
         "tests/lib/ipc:torture_sem" \
         "tests/lib/pty:torture_pty" \
         "tests/lib/signal:torture_signal" \
-        "tests/lib/fcntl:torture_fcntl" \
+        "tests/lib/c:torture_fcntl" \
         "tests/lib/c:torture_malloc" \
         "tests/lib/c:torture_procs" \
         "tests/lib/c:torture_evdev" \
diff --git a/tests/lib/fcntl/Makefile b/tests/lib/c/Makefile.fcntl
similarity index 95%
rename from tests/lib/fcntl/Makefile
rename to tests/lib/c/Makefile.fcntl
index cf930ec7..885ac06c 100644
--- a/tests/lib/fcntl/Makefile
+++ b/tests/lib/c/Makefile.fcntl
@@ -1,4 +1,4 @@
-# tests/lib/fcntl/Makefile
+# tests/lib/c/Makefile.fcntl
 #
 # Pure POSIX fcntl/dup/dup2/dup3 stress.  Same conventions as
 # tests/lib/ipc/Makefile.
diff --git a/tests/lib/fcntl/torture_fcntl.c b/tests/lib/c/torture_fcntl.c
similarity index 100%
rename from tests/lib/fcntl/torture_fcntl.c
rename to tests/lib/c/torture_fcntl.c
diff --git a/tests/lib/fcntl/torture_fcntl b/tests/lib/fcntl/torture_fcntl
deleted file mode 100755
index a4b7ede73760b3ac4e7fd1836750b59f399e038a..0000000000000000000000000000000000000000
