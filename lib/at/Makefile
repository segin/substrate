include ../../Makefile.inc

CFLAGS := $(CFLAGS) -I../../include
LDFLAGS := $(USER_LDFLAGS)

# Generated parser/lexer have a few unavoidable warnings under -Werror.
LOOSE_CFLAGS = -Wno-implicit-function-declaration -Wno-int-conversion -Wno-incompatible-pointer-types

SRCS = at_acl.c at_spool.c at_exec.c at_parse.c
OBJS = at_acl.o at_spool.o at_exec.o at_parse.o at_parse_y.o lex.yy.o
PIC_OBJS = at_acl.pic.o at_spool.pic.o at_exec.pic.o at_parse.pic.o at_parse_y.pic.o lex.yy.pic.o
CLEANFILES = $(OBJS) $(PIC_OBJS) libat.a libat.so libat.so.0 \
             at_parse.tab.c at_parse.tab.h
# at_parse_y.{c,h} and lex.yy.c are regenerated by the in-tree yacc/lex
# tools from at_parse.{y,l}, but those tools currently crash on the
# host.  The generated files are checked into git as a workaround so
# rebuilds don't need to re-run yacc/lex.  Do NOT add them to
# CLEANFILES — `make clean && make` would then break.

all: libat.a $(if $(NATIVE_BUILD),,libat.so.0)

at_parse_y.c at_parse_y.h: at_parse.y
	../../usr.bin/yacc/yacc -d -b at_parse at_parse.y
	mv at_parse.tab.c at_parse_y.c
	mv at_parse.tab.h at_parse_y.h

lex.yy.c: at_parse.l at_parse_y.h
	../../usr.bin/lex/lex at_parse.l

at_parse_y.o: at_parse_y.c
	$(CC) $(CFLAGS) $(LOOSE_CFLAGS) -c at_parse_y.c -o $@

lex.yy.o: lex.yy.c
	$(CC) $(CFLAGS) $(LOOSE_CFLAGS) -c lex.yy.c -o $@

at_parse_y.pic.o: at_parse_y.c
	$(CC) $(SHLIB_CFLAGS) -I../../include $(LOOSE_CFLAGS) -c at_parse_y.c -o $@

lex.yy.pic.o: lex.yy.c
	$(CC) $(SHLIB_CFLAGS) -I../../include $(LOOSE_CFLAGS) -c lex.yy.c -o $@

at_parse.o: at_parse.c
	$(CC) $(CFLAGS) -c at_parse.c -o $@

libat.a: $(OBJS)
	$(AR) rcs $@ $(OBJS)

# libat depends on libc.so.0 (uses string/file functions throughout).
libat.so.0: $(PIC_OBJS)
	$(CC) $(SHLIB_LDFLAGS) -Wl,-soname,libat.so.0 \
	      -L$(TOP)/lib/c -l:libc.so.0 \
	      -o $@ $(PIC_OBJS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

%.pic.o: %.c
	$(CC) $(SHLIB_CFLAGS) -I../../include -c $< -o $@

clean:
	rm -f $(CLEANFILES)

install: libat.a $(if $(NATIVE_BUILD),,libat.so.0)
	@mkdir -p $(DESTDIR)/usr/lib $(DESTDIR)/lib
	install -m 644 libat.a $(DESTDIR)/usr/lib/
ifndef NATIVE_BUILD
	install -m 755 libat.so.0 $(DESTDIR)/lib/
	@ln -sf libat.so.0 $(DESTDIR)/lib/libat.so
endif

.PHONY: all clean install
