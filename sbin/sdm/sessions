# /etc/sdm/sessions — X sessions offered by the sgreet login chooser.
#
# One session per line, in the form:
#
#     Label = command
#
# `Label` is the human-readable name shown in the greeter (press F1 to
# cycle through the list); `command` is the window manager / session
# leader that /etc/X11/Xsession execs after starting the default xterm.
# Blank lines and lines beginning with `#` are ignored.  The first entry
# is the default selection.  If this file is missing or empty, the
# greeter offers a single "Default" session and Xsession falls back to
# matwm2.
# CDE — the Common Desktop Environment.  dtsession is CDE's session manager:
# it starts the ToolTalk messaging server, the dtwm window manager + Front
# Panel, and restores the saved session.  CDE bakes its /usr/dt paths in at
# build time, so it finds its components by absolute path.
CDE    = /usr/dt/bin/dtsession
# TDE — the Trinity Desktop Environment.  starttde-substrate is a
# direct-launch session (see /etc/X11/starttde-substrate): it starts
# dcopserver, builds the sycoca, and launches twin (WM) + kdesktop +
# kicker directly, bypassing tdeinit's auto-launch cascade which does not
# yet come up cleanly on substrate.  The upstream /opt/trinity/bin/starttde
# is offered as "TDE (starttde)" for when that path is fixed.
TDE             = /etc/X11/starttde-substrate
TDE (starttde)  = /opt/trinity/bin/starttde
matwm2 = matwm2
twm    = twm
ctwm   = ctwm
xterm  = xterm -fn 9x15
