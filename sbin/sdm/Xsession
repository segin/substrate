#!/bin/sh
# /etc/X11/Xsession — substrate default X session, run as the logged-in
# user by sgreet after authentication.  Falls back to a bare xterm if
# the window manager is missing.
[ -x "$HOME/.xsession" ] && exec "$HOME/.xsession"

# Start a terminal as a background client, then exec the window manager in
# the foreground.  matwm2 is the session leader: when it exits, the session
# (and the X server) ends and sdm returns to the greeter.  A failing or
# exiting xterm just closes that one client and leaves the session up.
# xterm's default fonts are scalable Adobe families that aren't installed;
# pin the primary font to the misc bitmap font 9x15 (which the core X font
# path provides) or xterm exits without opening a window.  Don't set a bold
# font (-fb): the matching 9x15B isn't registered and a failed -fb is fatal,
# whereas with no -fb xterm just overstrikes for bold.
#
# +lc disables xterm's locale (luit) mode.  This build defaults locale mode
# ON even in the C locale, so xterm execs luit as the child that runs the
# shell.  luit allocates a SECOND pty for the shell, which currently fails
# on substrate (exit 1) — and when that child dies xterm exits cleanly, so
# the window flashes up and vanishes.  With +lc xterm runs the shell on its
# own (working) pty directly.  Re-enable locale mode once luit's pty setup
# works on substrate.
xterm +lc -fn 9x15 -geometry 80x24+20+20 > /var/log/xterm.txt 2>&1 &
exec matwm2 > /var/log/matwm2.txt 2>&1
