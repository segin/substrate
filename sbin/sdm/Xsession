#!/bin/sh
# /etc/X11/Xsession — substrate default X session, run as the logged-in
# user by sgreet after authentication.  Falls back to a bare xterm if
# the window manager is missing.
[ -x "$HOME/.xsession" ] && exec "$HOME/.xsession"

# The session leader is whatever sgreet's chooser selected, passed in
# $SDM_SESSION (configured in /etc/sdm/sessions); default to matwm2 when
# unset.  When the leader exits, the session (and the X server) ends and
# sdm returns to the greeter.
SESSION="${SDM_SESSION:-matwm2}"

# Start a terminal as a background client, then exec the session leader in
# the foreground.  A failing or exiting xterm just closes that one client
# and leaves the session up.
# xterm's default fonts are scalable Adobe families that aren't installed;
# pin the primary font to the misc bitmap font 9x15 (which the core X font
# path provides) or xterm exits without opening a window.  Don't set a bold
# font (-fb): the matching 9x15B isn't registered and a failed -fb is fatal,
# whereas with no -fb xterm just overstrikes for bold.
#
# Locale (luit) mode is ON: the session runs under LANG=en_US.UTF-8 (set by
# sgreet), so xterm execs luit as the child that runs the shell and filters
# the byte stream through luit's UTF-8/ISO-2022 conversion.  luit allocates a
# second pty for the shell; its setsid'd child claims that pty as its
# controlling terminal via TIOCSCTTY.  (Both the kernel pty controlling-
# terminal path and a UTF-8-aware libc setlocale/nl_langinfo had to land
# first — see the tty auto-attach fix and lib/c locale support.)
xterm -fn 9x15 -geometry 80x24+20+20 > /var/log/xterm.txt 2>&1 &
exec $SESSION > /var/log/xsession.txt 2>&1
