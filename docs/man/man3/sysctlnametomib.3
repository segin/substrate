.\" sysctlnametomib.3 - sysctlnametomib library function
.TH SYSCTLNAMETOMIB 3 "March 2026" "Substrate" "Library Functions Manual"
.SH NAME
sysctlnametomib \- convert sysctl name to MIB path
.SH LIBRARY
.B libc
.SH SYNOPSIS
.B #include <sys/sysctl.h>
.PP
.BI "int sysctlnametomib(const char *" name ", int *" mibp ", size_t *" sizep ");"
.SH DESCRIPTION
.BR sysctlnametomib ()
translates an ASCII dotted sysctl name (e.g.,
.IR """kern.hostname""" )
into the corresponding numeric MIB (Management Information Base) path
suitable for passing to
.BR sysctl (3).
.PP
On entry,
.I *sizep
should contain the size (in bytes) of the buffer pointed to by
.IR mibp .
On return,
.I *sizep
is updated with the actual size of the MIB.
.PP
If
.I mibp
is NULL, only the required size is returned in
.IR *sizep ,
allowing the caller to allocate a correctly-sized buffer.
.SH RETURN VALUE
Returns 0 on success, or \-1 with
.I errno
set on error.
.SH ERRORS
.TP
.B EINVAL
.I name
or
.I sizep
is NULL.
.TP
.B ENOENT
The specified name was not found.
.SH EXAMPLES
.nf
int mib[CTL_MAXNAME];
size_t miblen = sizeof(mib);

if (sysctlnametomib("kern.hostname", mib, &miblen) == -1)
    err(1, "sysctlnametomib");

char hostname[256];
size_t len = sizeof(hostname);
sysctl(mib, miblen / sizeof(int), hostname, &len, NULL, 0);
printf("hostname: %s\\n", hostname);
.fi
.SH NOTES
Thread-safe and reentrant.
The function uses
.BR sysctl (3)
internally with the
.B CTL_SYSCTL / CTL_SYSCTL_NAME2OID
meta-MIB.
.SH SEE ALSO
.BR sysctl (3),
.BR sysctlbyname (3),
.BR sysctl (2)
