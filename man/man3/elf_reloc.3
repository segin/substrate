.Dd February 27, 2026
.Dt ELF_RELOC 3
.Os Substrate
.Sh NAME
.Nm elf_add_relocation ,
.Nm elf_section_reloc_count ,
.Nm elf_section_reloc_at ,
.Nm elf_reloc_at ,
.Nm elf_reloc_offset ,
.Nm elf_reloc_type ,
.Nm elf_reloc_addend ,
.Nm elf_reloc_has_addend ,
