.TH SYS_PROC_LIST 2 "January 2026" "Substrate Kernel" "System Calls Manual"
.SH NAME
sys_proc_list \- get list of all process IDs
.SH LIBRARY
System library (libsys, \-lsys)
.SH SYNOPSIS
.B #include <sys/types.h>
.br
.B #include <sys/syscall.h>
.PP
.BI "int sys_proc_list(pid_t *" pids ", size_t " max_count ");"
.SH DESCRIPTION
The
.B sys_proc_list()
system call retrieves a list of all process IDs in the system and stores
them in the array pointed to by
.IR pids .
At most
.I max_count
PIDs are written to the array.
.PP
Zombie processes are excluded from the returned list.
.PP
This system call is typically used in conjunction with
.BR sys_proc_info (2)
to enumerate all processes and retrieve their attributes.
.SH RETURN VALUE
On success, returns the actual number of PIDs written to the array.
If the number of active processes exceeds
.IR max_count ,
only
.I max_count
PIDs are returned.
.PP
On error, returns \-1.
.SH ERRORS
.TP
.B EFAULT
.I pids
points to an invalid address.
.SH EXAMPLE
.nf
#include <sys/syscall.h>
#include <sys/sysinfo.h>
#include <stdio.h>

int main(void) {
    pid_t pids[256];
    int count = sys_proc_list(pids, 256);
    
    for (int i = 0; i < count; i++) {
        sys_procinfo_t info;
        if (sys_proc_info(pids[i], &info) == 0) {
            printf("PID %d: %s\en", info.pid, info.name);
        }
    }
    return 0;
}
.fi
.SH SEE ALSO
.BR sys_proc_info (2),
.BR sys_proc_count (2),
.BR intro (2)
