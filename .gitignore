# Generic objects, libraries, and binaries
*.a
*.d
# `*.d` accidentally caught etc/rc.d/ (the rc service-script tree),
# leaving rc.d entries untrackable — un-ignore the directory.
!etc/rc.d/
# ...and etc/ld.so.conf.d/ (the ld.so search-path drop-ins).
!etc/ld.so.conf.d/
*.dll
*.elf
*.exe
*.gcda
*.gcno
*.img
*.lst
*.o
*.obj
*.out
*.profdata
*.profraw
**/*.pyc
*.so
*.so.[0-9]*
*.pic.o
*.su
*.tmp
*.com

