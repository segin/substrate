# Object files
*.o
*.obj

# Libraries
*.a
*.so
*.dll

# Binaries and executables
*.exe
*.com
*.out
substrate.iso

# System Kernel
sys/kernel.bin

# Temporary files
*.swp
*.swo
*~
*.bak
*.tmp

# Logs
*.log

# Userland binaries — ignore everything inside bin/ and sbin/ subdirs
# except source files.  bin/* hides the directory entries, !bin/*/
# re-includes subdirs, then bin/*/* hides the FILES inside them,
# and the negation patterns re-include only source artifacts.
bin/*
!bin/*/
bin/*/*
!bin/*/Makefile
!bin/*/*.c
!bin/*/*.h
!bin/*/*.S
!bin/*/src/

sbin/*
!sbin/*/
sbin/*/*
!sbin/*/Makefile
!sbin/*/*.c
!sbin/*/*.h
!sbin/*/*.S

!usr.bin/*/Makefile
!usr.bin/*/*.c
!usr.bin/*/*.h
!usr.bin/*/*.S
!usr.bin/
!usr.bin/**/
!usr.bin/**/*.md

!tests/usr.bin/
!tests/usr.bin/**/
!tests/usr.bin/**/Makefile
!tests/usr.bin/**/*.ir

# In-tree host tool binaries (generated, never source-controlled)
/usr.bin/ar/ar
/usr.bin/as/as
/usr.bin/as/as.x86
/usr.bin/as/as.x64
/usr.bin/brandelf/brandelf
/usr.bin/cc/cc
/usr.bin/cc/cpp
/usr.bin/cc/ir-verifier
/usr.bin/cc/ir-normalize
/usr.bin/cc/ir-diff
/usr.bin/compress/uncompress
/usr.bin/cpio/cpio
/usr.bin/elfedit/elfedit
/usr.bin/ld/ld
/usr.bin/ld/ld.x86
/usr.bin/ld/ld.x64
/usr.bin/lex/lex
/usr.bin/lex/out.txt
/usr.bin/pax/pax
/usr.bin/pr/pr
/usr.bin/uudecode/uudecode
/usr.bin/yacc/yacc
/bin/cp/cp
/bin/sh/sh

# Ignore the compiled output in bin subdirs that matches the dir name
# (This is tricky with gitignore patterns, relying on extensions is safer)

