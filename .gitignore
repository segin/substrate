test_libc_stdlib
test_libc_ctype
test_libc_assert
bench_ext2_readdir
udf_test
stat_verify
host_test_*
tests/sys/host_test_*
*.img

# Keep source trees under usr.bin/tests tracked even with *.bin rules.
!usr.bin/
!usr.bin/**/
!usr.bin/*/Makefile
!usr.bin/*/*.c
!usr.bin/*/*.h
!usr.bin/*/*.S
!usr.bin/**/*.md

!tests/usr.bin/
!tests/usr.bin/**/
!tests/usr.bin/**/Makefile
!tests/usr.bin/**/*.ir
# Specific userland binaries
bin/cat/cat
bin/chmod/chmod
bin/cp/cp
bin/ls/ls
