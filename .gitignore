# Keep source trees under usr.bin/tests tracked even with broad ignore rules.
!usr.bin/
!usr.bin/**/
!usr.bin/*/Makefile
!usr.bin/*/*.S
!usr.bin/*/*.c
!usr.bin/*/*.h
!usr.bin/**/*.md

!tests/usr.bin/
!tests/usr.bin/**/
!tests/usr.bin/**/Makefile
!tests/usr.bin/**/*.ir

# Userland binaries: ignore generated files inside bin/ and sbin/ while keeping sources
bin/*
!bin/*/
bin/*/*
!bin/*/Makefile
!bin/*/*.S
!bin/*/*.awk
!bin/*/*.c
!bin/*/*.h
!bin/*/*.l
!bin/*/*.md
!bin/*/*.pl
!bin/*/*.py
!bin/*/*.sh
!bin/*/*.txt
!bin/*/*.y
!bin/*/docs/
!bin/*/docs/**
!bin/*/src/
!bin/*/tests/
!bin/*/tests/**

sbin/*
!sbin/*/
sbin/*/*
!sbin/*/Makefile
!sbin/*/*.S
!sbin/*/*.awk
!sbin/*/*.c
!sbin/*/*.h
!sbin/*/*.l
!sbin/*/*.md
!sbin/*/*.pl
!sbin/*/*.py
!sbin/*/*.sh
!sbin/*/*.txt
!sbin/*/*.y
!sbin/*/docs/
!sbin/*/docs/**

