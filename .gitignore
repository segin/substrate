*.img

# Keep source trees under usr.bin/tests tracked even with *.bin rules.
!usr.bin/
!usr.bin/**/
!usr.bin/*/Makefile
!usr.bin/*/*.c
!usr.bin/*/*.h
!usr.bin/*/*.S
!usr.bin/**/*.md

!tests/usr.bin/
!tests/usr.bin/**/
!tests/usr.bin/**/Makefile
!tests/usr.bin/**/*.ir
