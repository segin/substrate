last_boot.txt
.gitignore
uname_linux
uname-freebsd
uname-freebsd.S
uname-linux.S
sys/symbols_end.txt
sys/symbols_start.txt

# Distribution root filesystem
dist/
host_dist/
/.agents/
pr_list.txt
klog
klog.notrace
qemu.out
qemu.pid
boot_output.txt
bin_dirs.txt
debug_tls.gdb

