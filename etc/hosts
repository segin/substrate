# /etc/hosts — substrate static host table
#
# The machine's own hostname is mapped to 127.0.0.1 (not the Debian-style
# 127.0.1.1 alias).  CDE's ToolTalk messaging system rpc-pings ttsession at
# the local hostname, and substrate's loopback only fully round-trips
# 127.0.0.1 — a hostname pointing at any other 127/8 address makes tt_open()
# fail ("The desktop messaging system could not be started") and the desktop
# never comes up.  Keep the hostname on 127.0.0.1.
127.0.0.1       localhost localhost.localdomain agar agar.localdomain
::1             localhost localhost.localdomain ip6-localhost ip6-loopback
ff02::1         ip6-allnodes
ff02::2         ip6-allrouters
