# Substrate default shell profile

PATH=/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin
export PATH

# System locale.  Substrate's libc is UTF-8 throughout; en_US.UTF-8 is
# the default so interactive programs (zsh, less, ncurses apps, vi,
# xterm/luit) run in UTF-8 mode.  Override per-category with LC_* in a
# per-user ~/.profile / ~/.zshrc if you need something else.
LANG=en_US.UTF-8
export LANG

PAGER=less
export PAGER

# Make every native GNU ./configure source /etc/config.site, which
# pre-seeds the build tuple so config.guess is never run.
CONFIG_SITE=/etc/config.site
export CONFIG_SITE

prompt='%n@%m[%T]:{%~}%% '

