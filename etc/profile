# Substrate default shell profile

PATH=/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin
export PATH

PAGER=less
export PAGER

# Make every native GNU ./configure source /etc/config.site, which
# pre-seeds the build tuple so config.guess is never run.
CONFIG_SITE=/etc/config.site
export CONFIG_SITE

prompt='%n@%m[%T]:{%~}%% '

