# /etc/config.site — site defaults sourced by every GNU configure
# run natively on Substrate.
#
# Stock configure scripts run config.guess to determine the build
# system.  config.guess does not recognise Substrate, so a native
# ./configure aborts with:
#
#     configure: error: cannot guess build type; you must specify one
#
# Pre-seeding the ac_cv_build / ac_cv_host / ac_cv_target cache
# variables makes AC_CANONICAL_BUILD/HOST/TARGET treat the value as
# already-cached and skip config.guess (and config.sub) entirely.
#
# This file is consulted because /etc/profile exports
# CONFIG_SITE=/etc/config.site; configure honours $CONFIG_SITE.
#
# The ': "${var=value}"' form assigns only when the variable is
# unset, so an explicit --build=/--host= argument, or a caller-set
# environment value, still takes precedence.

#
# The tuple is the machine's own: both images install this file, and the
# 64-bit one's gcc is x86_64-unknown-substrate.  Telling configure it is
# building on i386 there makes it describe a machine its compiler does not
# target.

case "$(uname -m 2>/dev/null)" in
    x86_64|amd64) _substrate_tuple=x86_64-unknown-substrate ;;
    *)            _substrate_tuple=i386-unknown-substrate ;;
esac
: "${ac_cv_build=$_substrate_tuple}"
: "${ac_cv_host=$_substrate_tuple}"
: "${ac_cv_target=$_substrate_tuple}"
unset _substrate_tuple
