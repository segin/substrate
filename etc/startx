#!/usr/bin/zsh
# Init=/etc/startx variant designed to survive a hard qemu power-off
# AND clean up stale X locks unconditionally.
mkdir -p /var/log

# Unconditionally remove any leftover server lock from a prior boot.
# /tmp on substrate persists across boots (it's a real ext2 directory,
# not tmpfs), so stale .X0-lock files survive and block a fresh start.
rm -f /tmp/.X0-lock /tmp/.tX0-lock
rm -rf /tmp/.X11-unix

: >/var/log/xlog.txt

# Periodic syncer — survives the exec below since it's a forked process.
( while true; do /bin/sync; sleep 2; done ) &

exec /usr/bin/Xfbdev vt1 \
    -retro \
    -ac \
    -mouse evdev,,device=/dev/input/event0 \
    -keybd evdev,,device=/dev/input/event0 \
    2>/var/log/xlog.txt
# -ac disables host-based access control.  Substrate doesn't run an
# xauth or xdm-style cookie service, so without -ac every client
# connect goes through ClientAuthorized -> CheckAuthorization,
# hits no matching MIT-MAGIC-COOKIE-1 entry, and the server slams
# the socket shut before the failure reply lands cleanly at the
# client — Xlib reads 0 bytes and exits with "X IO ERROR: display
# closed (server died?)".  Symptom prior to this flag: clients
# insta-die on connect, X server hangs in the main dispatch loop
# accepting and rejecting forever.
