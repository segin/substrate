#!/bin/sh
# /etc/rc.d/40-telnetd — start inetd, which in turn launches telnetd
# per-connection per /etc/inetd.conf.  Naming kept for compatibility
# (renamed-to-inetd would re-order against later hooks).

PROG=/usr/libexec/inetd
PIDFILE=/var/run/inetd.pid

is_running() {
    [ -r "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE") || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

case "${1:-start}" in
    start)
        if is_running; then
            echo "inetd: already running (pid $(cat $PIDFILE))"
            exit 0
        fi
        # inetd daemonizes itself and writes /var/run/inetd.pid
        "$PROG"
        ;;
    stop)
        if is_running; then
            pid=$(cat "$PIDFILE")
            kill "$pid" 2>/dev/null
            rm -f "$PIDFILE"
            echo "inetd: stopped (was pid $pid)"
        else
            echo "inetd: not running"
        fi
        ;;
    status)
        if is_running; then
            echo "inetd: running (pid $(cat $PIDFILE))"
        else
            echo "inetd: stopped"
        fi
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    reload)
        if is_running; then
            kill -HUP "$(cat $PIDFILE)"
            echo "inetd: reloaded inetd.conf"
        else
            echo "inetd: not running"
            exit 1
        fi
        ;;
    *)
        echo "usage: $0 {start|stop|status|restart|reload}"
        exit 2
        ;;
esac
