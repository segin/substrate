#!/bin/sh
# /etc/rc.d/30-atd — start the at(1) batch-job daemon.
#
# atd watches /var/spool/at for `at` / `batch` jobs and runs them
# when their scheduled time elapses.  Sits between network bring-up
# (20-network) and the inetd hook (40-telnetd) so jobs scheduled
# from telnet sessions have somewhere to land by the time the first
# user logs in.
#
# atd self-daemonizes by default (fork + setsid).  -f / -d forces
# foreground.  We don't pass them — the kernel's job-control IPC
# is fine with detached daemons.  atd doesn't write a pidfile, so
# is_running() falls back to pgrep.

PROG=/usr/sbin/atd

is_running() {
    pgrep -x atd >/dev/null 2>&1
}

case "${1:-start}" in
    start)
        if is_running; then
            echo "atd: already running"
            exit 0
        fi
        if [ ! -x "$PROG" ]; then
            echo "atd: $PROG not installed; skipping"
            exit 0
        fi
        mkdir -p /var/spool/at
        "$PROG"
        ;;
    stop)
        if ! is_running; then
            echo "atd: not running"
            exit 0
        fi
        pkill -TERM -x atd 2>/dev/null
        ;;
    status)
        if is_running; then
            echo "atd: running"
        else
            echo "atd: stopped"
            exit 1
        fi
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "usage: $0 {start|stop|status|restart}"
        exit 1
        ;;
esac
