#!/bin/sh
# /etc/rc.d/30-atd — start the at(1) batch-job daemon.
#
# atd watches /var/spool/at for `at` / `batch` jobs and runs them
# when their scheduled time elapses.  Sits between network bring-up
# (20-network) and the inetd hook (40-telnetd) so jobs scheduled
# from telnet sessions have somewhere to land by the time the first
# user logs in.
#
# atd's default mode forks + setsid and doesn't write a pidfile.
# substrate's pgrep is a printf stub and there's no pkill, so we
# can't rely on either for liveness.  Instead, run atd in
# foreground (`-f`) backgrounded by the shell and capture $! into
# our own pidfile — same shape as 05-syslogd.

PROG=/usr/sbin/atd
PIDFILE=/var/run/atd.pid

is_running() {
    [ -r "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE") || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

case "${1:-start}" in
    start)
        if is_running; then
            echo "atd: already running (pid $(cat $PIDFILE))"
            exit 0
        fi
        if [ ! -x "$PROG" ]; then
            echo "atd: $PROG not installed; skipping"
            exit 0
        fi
        mkdir -p /var/spool/at /var/run
        "$PROG" -f >/dev/null 2>&1 &
        echo $! > "$PIDFILE"
        ;;
    stop)
        if ! is_running; then
            echo "atd: not running"
            exit 0
        fi
        pid=$(cat "$PIDFILE")
        kill -TERM "$pid" 2>/dev/null
        rm -f "$PIDFILE"
        ;;
    status)
        if is_running; then
            echo "atd: running (pid $(cat $PIDFILE))"
        else
            echo "atd: stopped"
            exit 1
        fi
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "usage: $0 {start|stop|status|restart}"
        exit 1
        ;;
esac
