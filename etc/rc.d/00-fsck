#!/bin/sh
# /etc/rc.d/00-fsck — check the root filesystem, then bring it read-write.
#
# Every GRUB entry boots with "ro" (see substrate_boot in build-rootfs.sh),
# which is the whole point of this script: a filesystem can only be repaired
# safely while nothing is writing to it, and once init starts services that
# window is gone.  So the order is fixed — fsck first, remount second, and
# every later rc.d script can assume a writable root.
#
# Sorts before 00-hostname because "f" < "h", and 01-run-clean immediately
# after wants to unlink stale pidfiles, which needs the root writable.
#
# If the root was booted rw (a direct kernel boot passing nothing), there is
# nothing to do: checking a mounted-writable filesystem is worse than not
# checking it, since e2fsck would be reading blocks that are actively
# changing underneath it.

case "${1:-start}" in
    start)
        # Ask the kernel whether / is really read-only rather than trusting
        # the command line: the two disagree once someone has remounted.
        if ! grep -q ' / .*[ ,]ro[ ,]' /proc/mounts 2>/dev/null; then
            echo "fsck: / is already read-write, skipping check"
            exit 0
        fi

        rootdev=$(awk '$2 == "/" { print $1; exit }' /proc/mounts 2>/dev/null)
        if [ -n "$rootdev" ] && [ -x /usr/sbin/e2fsck ]; then
            echo "fsck: checking $rootdev"
            # -p: preen, fix only what is unambiguously safe without asking.
            #
            # The status is a BITMASK (e2fsck/e2fsck.h), not a scale:
            #   1  FSCK_NONDESTRUCT  errors corrected
            #   2  FSCK_REBOOT       corrected, SYSTEM SHOULD BE REBOOTED
            #   4  FSCK_UNCORRECTED  errors left uncorrected
            # so it must be tested bit by bit -- rc can be 3 (1|2) or 6 (2|4).
            /usr/sbin/e2fsck -p "$rootdev"
            rc=$?
            if [ "$rc" -ge 4 ]; then
                echo "fsck: $rootdev has uncorrected errors (status $rc)"
                echo "fsck: leaving / read-only -- repair it, then:"
                echo "        mount -o remount,rw /"
                exit 1
            fi
            if [ "$((rc & 2))" -ne 0 ]; then
                # e2fsck sets this bit only when it MODIFIED the root
                # filesystem (EXT2_MF_ISROOT in e2fsck/unix.c), and prints
                # "***** REBOOT SYSTEM *****".  It means: the on-disk
                # metadata no longer matches what this kernel cached when it
                # mounted the volume -- superblock, group descriptors,
                # bitmaps, inodes, all read before the repair.
                #
                # Continuing here is what corrupts the filesystem.  The
                # remount below would bring / read-write with that stale
                # cache still authoritative, and the kernel would then write
                # it back over everything e2fsck just fixed.  The symptom is
                # files that plainly exist becoming unreachable a boot or two
                # later ("ld.so: main-program needs libz.so.1 - not found")
                # and the damage compounding on every subsequent boot.
                #
                # So reboot instead, WITHOUT remounting: / is still read-only,
                # nothing has written to it, and the fresh boot re-reads the
                # repaired metadata and finds the volume clean.  This is what
                # every other init does with this status.
                echo "fsck: $rootdev was repaired and the kernel's cached"
                echo "fsck: metadata is now stale -- rebooting (status $rc)"
                sync
                /sbin/reboot -f
                # Not reached.  If reboot(2) somehow fails, do NOT fall
                # through to the remount.
                echo "fsck: reboot failed; leaving / read-only" >&2
                exit 1
            fi
        else
            echo "fsck: no e2fsck or no root device in /proc/mounts, skipping check"
        fi

        echo "fsck: remounting / read-write"
        mount -o remount,rw /
        ;;
    stop)
        ;;
esac
