.TH CLOCK_GETTIME 2 "January 2026" "Substrate Kernel" "System Calls Manual"
.SH NAME
clock_gettime \- retrieve the time of the specified clock
.SH LIBRARY
Standard C library (libc, -lc)
.SH SYNOPSIS
.B #include <time.h>
.PP
.BI "int clock_gettime(clockid_t " clk_id ", struct timespec *" tp ");"
.SH DESCRIPTION
.B clock_gettime
() retrieves the time of the specified clock
.IR clk_id .
The
.I clk_id
argument is the identifier of the particular clock on which to act.
A clock may be system-wide to all processes or per-process.
.SH RETURN VALUE
On success, 0 is returned. On error, -1 is returned.
.SH ERRORS
.TP
.B EINVAL
The 
.I clk_id
specified is not supported on this system.
.SH EXAMPLES
.B Program source
.nf

#include <time.h>
#include <stdio.h>

int main(void) {
    struct timespec ts;
    // Get the current time from the system-wide real-time clock
    if (clock_gettime(CLOCK_REALTIME, &ts) == 0) {
        printf("Current time: %ld seconds, %ld nanoseconds\\n",
               (long)ts.tv_sec, ts.tv_nsec);
    } else {
        perror("clock_gettime");
        return 1;
    }
    return 0;
}
.fi

.SH SEE ALSO
