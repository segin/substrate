.Dd March 2, 2026
.Dt ELF_LINK_PLAN_ADD_INPUT 3
.Os
.Sh NAME
.Nm elf_link_plan_add_input
.Nd append one input object to a link plan
.Sh LIBRARY
libelfobj
.Sh SYNOPSIS
.In elfobj.h
.Ft elf_err_t
.Fn elf_link_plan_add_input "elf_link_plan_t *plan" "elfobj_t *obj" "const char *name"
.Sh DESCRIPTION
.Fn elf_link_plan_add_input
adds
.Fa obj
to
.Fa plan
with optional display name
.Fa name
for diagnostics/map entries.
.Sh RETURN VALUES
Returns
.Dv ELF_OK
on success; otherwise an
.Vt elf_err_t
code.
.Sh ERRORS
Typically
.Dv ELF_ERR_STATE
for invalid arguments and
.Dv ELF_ERR_OOM
for allocation failure.
.Sh EXAMPLES
Add two named inputs to a plan and confirm the input count.
.Bd -literal -offset indent
#include <elfobj.h>
#include <stdio.h>

int
main(void)
{
    elf_link_plan_t *plan = elf_link_plan_create();
    elfobj_t *a, *b;

    elf_open("a.o", &a);
    elf_open("b.o", &b);
    elf_link_plan_add_input(plan, a, "a.o");
    elf_link_plan_add_input(plan, b, "b.o");
    printf("%zu inputs\en", elf_link_plan_input_count(plan));
    elf_link_plan_destroy(plan);
    return 0;
}
.Ed
.Sh SEE ALSO
.Xr elf_link_plan_input_count 3 ,
.Xr elf_link_plan_link 3
