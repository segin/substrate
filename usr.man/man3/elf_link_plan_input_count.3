.Dd March 2, 2026
.Dt ELF_LINK_PLAN_INPUT_COUNT 3
.Os
.Sh NAME
.Nm elf_link_plan_input_count
.Nd return number of inputs currently in a link plan
.Sh LIBRARY
libelfobj
.Sh SYNOPSIS
.In elfobj.h
.Ft size_t
.Fn elf_link_plan_input_count "const elf_link_plan_t *plan"
.Sh DESCRIPTION
.Fn elf_link_plan_input_count
returns how many input objects were added to
.Fa plan .
.Sh RETURN VALUES
Returns the input count, or 0 if
.Fa plan
is NULL.
.Sh EXAMPLES
Report how many inputs a plan holds after adding objects.
.Bd -literal -offset indent
#include <elfobj.h>
#include <stdio.h>

int
main(void)
{
    elf_link_plan_t *plan = elf_link_plan_create();
    elfobj_t *obj;

    elf_open("a.o", &obj);
    elf_link_plan_add_input(plan, obj, "a.o");
    printf("inputs = %zu\en", elf_link_plan_input_count(plan));
    elf_link_plan_destroy(plan);
    return 0;
}
.Ed
.Sh SEE ALSO
.Xr elf_link_plan_add_input 3
