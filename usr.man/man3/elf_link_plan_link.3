.Dd March 2, 2026
.Dt ELF_LINK_PLAN_LINK 3
.Os
.Sh NAME
.Nm elf_link_plan_link
.Nd execute a prepared link plan and produce merged output
.Sh LIBRARY
libelfobj
.Sh SYNOPSIS
.In elfobj.h
.Ft elf_err_t
.Fn elf_link_plan_link "elf_link_plan_t *plan" "elfobj_t **output"
.Sh DESCRIPTION
.Fn elf_link_plan_link
validates plan state, merges plan inputs in order, and emits a new object in
.Fa *output .
Inputs must be ABI-compatible (machine/class/endian).
.Sh RETURN VALUES
Returns
.Dv ELF_OK
on success.
On failure returns an
.Vt elf_err_t
code and leaves
.Fa *output
unchanged.
.Sh ERRORS
Common failures include
.Dv ELF_ERR_STATE ,
.Dv ELF_ERR_OOM ,
.Dv ELF_ERR_UNSUPPORTED ,
and relocation/merge errors.
.Sh EXAMPLES
Execute a prepared plan and write the merged object to disk.
.Bd -literal -offset indent
#include <elfobj.h>
#include <stdio.h>

int
main(void)
{
    elf_link_plan_t *plan = elf_link_plan_create();
    elfobj_t *obj, *out = NULL;

    elf_open("a.o", &obj);
    elf_link_plan_add_input(plan, obj, "a.o");
    if (elf_link_plan_link(plan, &out) != ELF_OK) {
        fprintf(stderr, "link failed\en");
        elf_link_plan_destroy(plan);
        return 1;
    }
    elf_write_file(out, "out.o");
    elf_close(out);
    elf_link_plan_destroy(plan);
    return 0;
}
.Ed
.Sh SEE ALSO
.Xr elf_link 3 ,
