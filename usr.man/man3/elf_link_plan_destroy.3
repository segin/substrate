.Dd March 2, 2026
.Dt ELF_LINK_PLAN_DESTROY 3
.Os
.Sh NAME
.Nm elf_link_plan_destroy
.Nd free a link plan and all plan-owned storage
.Sh LIBRARY
libelfobj
.Sh SYNOPSIS
.In elfobj.h
.Ft void
.Fn elf_link_plan_destroy "elf_link_plan_t *plan"
.Sh DESCRIPTION
.Fn elf_link_plan_destroy
releases
.Fa plan
and all internal arrays/strings owned by the plan.
Passing
.Dv NULL
is safe.
.Sh EXAMPLES
Release a plan once linking is complete.
.Bd -literal -offset indent
#include <elfobj.h>

int
main(void)
{
    elf_link_plan_t *plan = elf_link_plan_create();
    elfobj_t *obj, *out = NULL;

    elf_open("a.o", &obj);
    elf_link_plan_add_input(plan, obj, "a.o");
    elf_link_plan_link(plan, &out);
    elf_close(out);
    elf_link_plan_destroy(plan);
    return 0;
}
.Ed
.Sh SEE ALSO
.Xr elf_link_plan_create 3
