.Dd March 2, 2026
.Dt ELF_LINK_PLAN_SET_VERSION_HOOK 3
.Os
.Sh NAME
.Nm elf_link_plan_set_version_hook
.Nd install symbol-version policy callback for a link plan
.Sh LIBRARY
libelfobj
.Sh SYNOPSIS
.In elfobj.h
.Ft elf_err_t
.Fn elf_link_plan_set_version_hook "elf_link_plan_t *plan" "elf_link_version_hook_t hook" "void *user"
.Sh DESCRIPTION
Associates version policy callback and user context with
.Fa plan .
.Sh RETURN VALUES
Returns
.Dv ELF_OK
on success, otherwise
.Dv ELF_ERR_STATE .
.Sh EXAMPLES
Install a symbol-version policy that accepts every version.
.Bd -literal -offset indent
#include <elfobj.h>

static int
accept(const char *symbol, const char *version, void *user)
{
    (void)symbol; (void)version; (void)user;
    return 1; /* keep this versioned symbol */
}

int
main(void)
{
    elf_link_plan_t *plan = elf_link_plan_create();

    elf_link_plan_set_version_hook(plan, accept, NULL);
    elf_link_plan_destroy(plan);
    return 0;
}
.Ed
.Sh SEE ALSO
.Xr elf_link_plan_link 3
