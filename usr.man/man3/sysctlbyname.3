.\" sysctlbyname.3 - sysctlbyname library function
.TH SYSCTLBYNAME 3 "March 2026" "Substrate" "Library Functions Manual"
.SH NAME
sysctlbyname, sysctlbyname_int, sysctlbyname_uint, sysctlbyname_quad, sysctlbyname_string, sysctlbyname_get_buf \- get or set system information by name
.SH LIBRARY
.B libc
.SH SYNOPSIS
.B #include <sys/sysctl.h>
.PP
.BI "int sysctlbyname(const char *" name ", void *" oldp ", size_t *" oldlenp ", void *" newp ", size_t " newlen ");"
.PP
.BI "int sysctlbyname_int(const char *" name ", int *" oldp ", int *" newp ");"
.PP
.BI "int sysctlbyname_uint(const char *" name ", unsigned int *" oldp ", unsigned int *" newp ");"
.PP
.BI "int sysctlbyname_quad(const char *" name ", uint64_t *" oldp ", uint64_t *" newp ");"
.PP
.BI "int sysctlbyname_string(const char *" name ", char *" oldp ", size_t *" oldlenp ", const char *" newp ");"
.PP
.BI "void *sysctlbyname_get_buf(const char *" name ", size_t *" lenp ");"
.SH DESCRIPTION
.BR sysctlbyname ()
is identical to
.BR sysctl (3)
except the parameter is identified by an ASCII dotted name string
(e.g.,
.IR """kern.hostname""" )
instead of a numeric MIB path.
.PP
Internally it calls
.BR sysctlnametomib (3)
to translate the name, allocates the resulting MIB on the heap, and then
calls
.BR sysctl (3).
The MIB buffer is freed before returning.
.PP
The typed convenience helpers behave identically to their
.BR sysctl_int ()
counterparts but accept string names.
.PP
.BR sysctlbyname_get_buf ()
combines name translation with the dynamic sizing/retry loop of
.BR sysctl_get_buf ().
.SH RETURN VALUE
Returns 0 on success, or \-1 with
.I errno
set on error.
.BR sysctlbyname_get_buf ()
returns a heap-allocated buffer or NULL.
.SH ERRORS
.TP
.B EINVAL
NULL name, or type size mismatch for typed helpers.
.TP
.B ENOMEM
Allocation failure.
.TP
.B ENOENT
Named parameter not found.
.SH EXAMPLES
.nf
int hz;
sysctlbyname_int("kern.clockrate", &hz, NULL);
printf("clock rate: %d\\n", hz);
.fi
.SH NOTES
Thread-safe and reentrant.
.SH SEE ALSO
.BR sysctl (3),
.BR sysctlnametomib (3),
.BR sysctl (2)
