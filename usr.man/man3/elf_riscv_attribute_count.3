.Dd March 2, 2026
.Dt ELF_RISCV_ATTRIBUTE_COUNT 3
.Os Substrate
.Sh NAME
.Nm elf_riscv_attribute_count
.Nd count parsed entries from .riscv.attributes
.Sh LIBRARY
.Lb libelfobj
.Sh SYNOPSIS
.In elfobj.h
.Ft size_t
.Fn elf_riscv_attribute_count "const elfobj_t *obj"
.Sh DESCRIPTION
The
.Fn elf_riscv_attribute_count
function parses the
.Pa .riscv.attributes
section in
.Fa obj
and returns the number of attribute entries discovered.
.Pp
If the section is absent, malformed, or the object is not RISC-V,
no entries are reported.
.Sh RETURN VALUES
The
.Fn elf_riscv_attribute_count
function returns the number of parsed attributes.
It returns 0 if no attributes are available or
.Fa obj
is
.Dv NULL .
.Sh EXAMPLES
Open a RISC-V object and iterate its parsed attributes.
.Bd -literal -offset indent
#include <elfobj.h>
#include <stdio.h>

elfobj_t *obj;

if (elf_open("a.out", &obj) != ELF_OK)
    errx(1, "elf_open failed");
size_t n = elf_riscv_attribute_count(obj);
for (size_t i = 0; i < n; i++)
    printf("tag %u = %llu\en",
        elf_riscv_attribute_tag_at(obj, i),
        (unsigned long long)elf_riscv_attribute_value_at(obj, i));
elf_close(obj);
.Ed
.Sh SEE ALSO
.Xr elf_riscv_attribute_tag_at 3 ,
.Xr elf_riscv_attribute_value_at 3 ,
.Xr elfobj 3
