.Dd March 2, 2026
.Dt ELF_SECTION_ADDR 3
.Os Substrate
.Sh NAME
.Nm elf_section_addr
.Nd return the section virtual address field
.Sh LIBRARY
.Lb libelfobj
.Sh SYNOPSIS
.In elfobj.h
.Ft uint64_t
.Fn elf_section_addr "const elf_section_t *section"
.Sh DESCRIPTION
The
.Fn elf_section_addr
function returns the section address field stored in
.Fa section
(the value corresponding to
.Dv sh_addr
in the ELF section header).
.Pp
For relocatable objects, this value is commonly zero until final layout or
linking assigns addresses.
.Sh RETURN VALUES
The
.Fn elf_section_addr
function returns the section address.
It returns 0 if
.Fa section
is
.Dv NULL .
.Sh CAVEATS
A return value of 0 may represent either a null input or a legitimate section
address value.
.Sh EXAMPLES
Print the virtual address of each section in an opened object.
.Bd -literal -offset indent
#include <elfobj.h>
#include <stdio.h>

int
main(int argc, char **argv)
{
    elfobj_t *obj = NULL;
    size_t i, n;

    if (elf_open(argv[1], &obj) != ELF_OK)
        return 1;

    n = elf_section_count(obj);
    for (i = 0; i < n; i++) {
        elf_section_t *s = elf_section_get(obj, i);

        printf("%s: addr=%#llx\en", elf_section_name(s),
            (unsigned long long)elf_section_addr(s));
    }

    elf_close(obj);
    return 0;
}
.Ed
.Sh SEE ALSO
.Xr elf_section_get 3 ,
