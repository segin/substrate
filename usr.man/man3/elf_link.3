.Dd March 2, 2026
.Dt ELF_LINK 3
.Os
.Sh NAME
.Nm elf_link
.Nd merge multiple ELF objects into one output object
.Sh LIBRARY
libelfobj
.Sh SYNOPSIS
.In elfobj.h
.Ft elf_err_t
.Fn elf_link "elfobj_t **inputs" "size_t count" "elfobj_t **output"
.Sh DESCRIPTION
.Fn elf_link
performs a direct merge/link operation over
.Fa count
input objects.
The resulting linked object is returned in
.Fa *output
on success.
.Pp
This entry point is intended for straightforward static merge flows.
For policy-driven linking (archive extraction, merge hooks, map introspection),
use the link-plan family documented in
.Xr elf_link_plan 3 .
For helper routines used by linker frontends, see
.Xr elf_link_utils 3 .
.Sh RETURN VALUES
Returns
.Dv ELF_OK
on success.
On failure, returns an
.Vt elf_err_t
code and does not modify
.Fa *output .
.Sh ERRORS
Common failure classes include invalid arguments, incompatible input objects,
allocation failure, and unresolved merge state.
.Sh EXAMPLES
Merge two relocatable objects into a single output object.
.Bd -literal -offset indent
#include <elfobj.h>
#include <stdio.h>

int
main(void)
{
    elfobj_t *inputs[2], *output = NULL;

    if (elf_open("a.o", &inputs[0]) != ELF_OK ||
        elf_open("b.o", &inputs[1]) != ELF_OK)
        return 1;
    if (elf_link(inputs, 2, &output) != ELF_OK) {
        fprintf(stderr, "link failed\en");
        return 1;
    }
    elf_write_file(output, "merged.o");
    elf_close(output);
    elf_close(inputs[0]);
    elf_close(inputs[1]);
    return 0;
}
.Ed
