.Dd March 2, 2026
.Dt ELF_HASH_GNU 3
.Os
.Sh NAME
.Nm elf_hash_gnu
.Nd compute the GNU ELF symbol hash value
.Sh LIBRARY
libelfobj
.Sh SYNOPSIS
.In elfobj.h
.Ft uint32_t
.Fn elf_hash_gnu "const char *name"
.Sh DESCRIPTION
.Fn elf_hash_gnu
computes the GNU hash used by
.Pa .gnu.hash
lookup tables.
.Sh RETURN VALUES
Returns the hash value for
.Fa name .
.Sh EXAMPLES
Compute and print the GNU hash of a symbol name.
.Bd -literal -offset indent
#include <elfobj.h>
#include <stdio.h>

int
main(void)
{
    uint32_t h = elf_hash_gnu("printf");
    printf("gnu hash = 0x%08x\en", h);
    return 0;
}
.Ed
.Sh SEE ALSO
.Xr elf_hash_sysv 3
