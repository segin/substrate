.TH REGEX 3 "February 2026" "Substrate" "Library Functions Manual"
.SH NAME
regex \- Substrate regular expression library
.SH LIBRARY
Regex library (libregex, -lregex)
.SH SYNOPSIS
.B #include <regex.h>
.PP
.B typedef struct regex_t regex_t;
.br
.B typedef struct regex_iter_t regex_iter_t;
.PP
.B typedef struct regex_limits_t {
.br
.BR "    size_t max_states;" "    size_t max_captures;"
.br
.BR "    size_t match_steps;" "    size_t max_matches;"
.br
.BR "    size_t max_stream_buffer;"
.br
.B } regex_limits_t;
.PP
.BI "regex_limits_t regex_default_limits(void);"
.br
.BI "regex_t *regex_compile(const char *pattern, unsigned flags, regex_err_t *out_err);"
.br
.BI "regex_err_t regex_set_limits(regex_t *re, const regex_limits_t *limits);"
.br
.BI "void regex_free(regex_t *re);"
.br
.BI "size_t regex_capture_count(const regex_t *re);"
.PP
.BI "ssize_t regex_match(const regex_t *re, const char *text, size_t text_len,"
.br
.BI "    size_t *capture_offsets, size_t max_captures, regex_err_t *out_err);"
.PP
.BI "typedef int (*regex_match_cb)(void *user, size_t start, size_t end,"
.br
.BI "    const size_t *capture_offsets, size_t capture_count);"
.br
.BI "regex_err_t regex_find_all(const regex_t *re, const char *text, size_t text_len,"
.br
.BI "    regex_match_cb cb, void *user, size_t max_matches);"
.PP
.BI "regex_err_t regex_replace(const regex_t *re, const char *text, size_t text_len,"
.br
.BI "    const char *replacement, int global, char **out_buf, size_t *out_len);"
.PP
.BI "typedef struct regex_split_result_t {"
.br
.BR "    char **items;" "    size_t count;"
.br
.B } regex_split_result_t;
.br
.BI "regex_err_t regex_split(const regex_t *re, const char *text, size_t text_len,"
.br
.BI "    regex_split_result_t *out, size_t max_splits);"
.br
.BI "void regex_split_free(regex_split_result_t *result);"
.PP
.BI "regex_iter_t *regex_iter_create(const regex_t *re, unsigned options, regex_err_t *out_err);"
.br
.BI "regex_err_t regex_iter_feed(regex_iter_t *it, const char *chunk, size_t len);"
.br
.BI "regex_err_t regex_iter_finish(regex_iter_t *it);"
.br
.BI "ssize_t regex_iter_next(regex_iter_t *it, size_t *start, size_t *end,"
.br
.BI "    size_t *capture_offsets, size_t max_captures, size_t *out_cap_count);"
.br
.BI "regex_err_t regex_iter_last_error(const regex_iter_t *it);"
.br
.BI "void regex_iter_destroy(regex_iter_t *it);"
.PP
.BI "char *regex_escape_literal(const char *s, size_t len);"
.SH DESCRIPTION
The
.B regex
library provides a compact, thread-safe regular expression engine with predictable,
non-backtracking matching by default. It exposes opaque objects for compiled patterns
and streaming match iterators.
.PP
The default engine is safe against catastrophic backtracking. An optional PCRE2 adapter
may be enabled at build time with
.BR USE_PCRE2=1 .
.PP
The match API returns the number of capture groups on success, -1 on no match, or
a negative error code on failure. Capture offsets are expressed as byte offsets into
.I text
and are returned as pairs (start, end).
.PP
Replacement supports $0..$9 expansion. The streaming interface accepts chunks and
returns matches as they become available.
.SH FLAGS
Flags are defined in
.BR <regex/flags.h> .
.SH ERRORS
These functions return a
.B regex_err_t
value or a negative error indicator. The following errors are possible:
.TP
.B REGEX_ERR_SYNTAX
Invalid pattern syntax.
.TP
.B REGEX_ERR_NOMEM
Memory allocation failed.
.TP
.B REGEX_ERR_COMPILE_LIMIT
Compilation exceeded configured limits.
.TP
.B REGEX_ERR_MATCH_TIMEOUT
Match exceeded configured time or match limits.
.TP
.B REGEX_ERR_INVALID_ARGUMENT
Invalid argument or NULL pointer.
.TP
.B REGEX_ERR_UNSUPPORTED
Requested feature requires an optional backend.
.TP
.B REGEX_ERR_INTERNAL
Unexpected internal error.
.SH EXAMPLES
Compile and match:
.PP
.nf
regex_err_t err;
regex_t *re = regex_compile("[a-z]+", REGEX_FLAG_EXTENDED, &err);
if (re) {
    size_t caps[2];
    if (regex_match(re, "hello", 5, caps, 2, &err) >= 0) {
        /* caps[0]..caps[1] is the match */
    }
    regex_free(re);
}
.fi
