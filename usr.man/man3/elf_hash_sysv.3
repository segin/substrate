.Dd March 2, 2026
.Dt ELF_HASH_SYSV 3
.Os
.Sh NAME
.Nm elf_hash_sysv
.Nd compute the System V ELF symbol hash value
.Sh LIBRARY
libelfobj
.Sh SYNOPSIS
.In elfobj.h
.Ft uint32_t
.Fn elf_hash_sysv "const char *name"
.Sh DESCRIPTION
.Fn elf_hash_sysv
computes the classic SysV ELF hash used by
.Dv SHT_HASH
symbol lookup tables.
.Sh RETURN VALUES
Returns the hash value for
.Fa name .
.Sh EXAMPLES
Compute and print the System V hash of a symbol name.
.Bd -literal -offset indent
#include <elfobj.h>
#include <stdio.h>

int
main(void)
{
    uint32_t h = elf_hash_sysv("printf");
    printf("sysv hash = 0x%08x\en", h);
    return 0;
}
.Ed
.Sh SEE ALSO
.Xr elf_hash_gnu 3
