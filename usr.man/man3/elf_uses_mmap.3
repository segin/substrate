.Dd March 2, 2026
.Dt ELF_USES_MMAP 3
.Os
.Sh NAME
.Nm elf_uses_mmap
.Nd query whether an opened object is backed by mmap
.Sh LIBRARY
libelfobj
.Sh SYNOPSIS
.In elfobj.h
.Ft int
.Fn elf_uses_mmap "const elfobj_t *obj"
.Sh DESCRIPTION
.Fn elf_uses_mmap
returns whether
.Fa obj
is backed by a memory-mapped input image.
.Sh RETURN VALUES
Returns non-zero when mmap-backed, 0 otherwise.
.Sh EXAMPLES
Report whether an opened object is backed by a memory map.
.Bd -literal -offset indent
#include <elfobj.h>
#include <stdio.h>

int
main(int argc, char **argv)
{
    elfobj_t *obj = NULL;

    if (elf_open_with_options(argv[1],
        ELFOBJ_OPEN_USE_MMAP, &obj) != ELF_OK)
        return 1;

    printf("mmap-backed: %s\en",
        elf_uses_mmap(obj) ? "yes" : "no");

    elf_close(obj);
    return 0;
}
.Ed
.Sh SEE ALSO
.Xr elf_open_with_options 3
