.TH STRSTR 3 2026-02-06 "Substrate LibC" "Substrate Library Functions"
.SH NAME
strstr \- locate a substring
.SH SYNOPSIS
.B #include <string.h>
.sp
.BI "char *strstr(const char *" haystack ", const char *" needle ");"
.SH DESCRIPTION
The
.BR strstr ()
function finds the first occurrence of the substring
.I needle
in the string
.IR haystack .
The terminating null bytes ('\\0') are not compared.
.SH RETURN VALUE
These functions return a pointer to the beginning of the located substring, or
NULL if the substring is not found.
.SH EXAMPLES
.EX
#include <string.h>
#include <stdio.h>

int main() {
    char *p = strstr("Hello World", "World");
    if (p) printf("%s\\n", p);
    return 0;
}
.EE
.SH SEE ALSO
.BR strchr (3),
.BR strtok (3)
