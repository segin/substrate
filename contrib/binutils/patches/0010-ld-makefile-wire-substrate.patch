Subject: ld: register substrate emuls in build

Hooks the two new emulations into ALL_EMULATION_SOURCES / ALL_64_EMULATION_SOURCES (Makefile.am) plus the autotools-regenerated Makefile.in.  Without this the .em files are present but ld doesn't build them.

---
diff --git a/ld/Makefile.am b/ld/Makefile.am
--- a/ld/Makefile.am	2026-05-11 21:33:54.230827404 -0500
+++ b/ld/Makefile.am	2026-05-11 21:37:46.138246752 -0500
@@ -280,6 +280,7 @@
 	eelf_i386_fbsd.c \
 	eelf_i386_haiku.c \
 	eelf_i386_sol2.c \
+	eelf_i386_substrate.c \
 	eelf_i386_vxworks.c \
 	eelf_iamcu.c \
 	eelf_s390.c \
@@ -458,6 +459,7 @@
 	eelf_x86_64_fbsd.c \
 	eelf_x86_64_haiku.c \
 	eelf_x86_64_sol2.c \
+	eelf_x86_64_substrate.c \
 	ehppa64linux.c \
 	ei386pep.c \
 	emmo.c
diff --git a/ld/Makefile.in b/ld/Makefile.in
--- a/ld/Makefile.in	2026-05-11 21:33:54.230844553 -0500
+++ b/ld/Makefile.in	2026-05-11 21:38:36.926243420 -0500
@@ -795,6 +795,7 @@
 	eelf_i386_fbsd.c \
 	eelf_i386_haiku.c \
 	eelf_i386_sol2.c \
+	eelf_i386_substrate.c \
 	eelf_i386_vxworks.c \
 	eelf_iamcu.c \
 	eelf_s390.c \
@@ -972,6 +973,7 @@
 	eelf_x86_64_fbsd.c \
 	eelf_x86_64_haiku.c \
 	eelf_x86_64_sol2.c \
+	eelf_x86_64_substrate.c \
 	ehppa64linux.c \
 	ei386pep.c \
 	emmo.c
@@ -1475,6 +1477,7 @@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_i386_fbsd.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_i386_haiku.Po@am__quote@
 @AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/eelf_i386_sol2.Po@am__quote@
