Subject: bfd: add i386/x86_64-substrate target stanzas

Substrate emits plain SysV ELF, so we route through the existing i386_elf32_vec / x86_64_elf64_vec defvecs.  A dedicated elf32-i386-substrate BFD output target (which would stamp ELFOSABI_SUBSTRATE in the e_ident byte) is deferred — needs C-side work in elf32-i386.c / elf64-x86-64.c.  Today the substrate kernel doesn't enforce the OSABI byte on exec, so this is good enough to bring up the toolchain.

---
diff --git a/bfd/config.bfd b/bfd/config.bfd
--- a/bfd/config.bfd	2026-05-11 21:33:53.970193864 -0500
+++ b/bfd/config.bfd	2026-05-11 21:35:13.101256793 -0500
@@ -666,6 +666,13 @@
     targ_selvecs=
     targ64_selvecs=x86_64_elf64_vec
     ;;
+  i[3-7]86-*-substrate*)
+    # Substrate emits standard SysV i386 ELF; the substrate OSABI tag
+    # is stamped by the linker emulation, not a BFD vector of its own.
+    targ_defvec=i386_elf32_vec
+    targ_selvecs="iamcu_elf32_vec"
+    targ64_selvecs="x86_64_elf64_vec x86_64_elf32_vec"
+    ;;
 #ifdef BFD64
   x86_64-*-darwin*)
     targ_defvec=x86_64_mach_o_vec
@@ -727,6 +734,11 @@
     targ_selvecs=i386_elf32_vec
     want64=true
     ;;
+  x86_64-*-substrate*)
+    targ_defvec=x86_64_elf64_vec
+    targ_selvecs="i386_elf32_vec iamcu_elf32_vec x86_64_elf32_vec"
+    want64=true
+    ;;
   x86_64-*-solaris2*)
     targ_defvec=x86_64_elf64_sol2_vec
     targ_selvecs="i386_elf32_sol2_vec x86_64_elf64_vec i386_elf32_vec"
