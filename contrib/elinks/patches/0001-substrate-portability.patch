 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+
+/* substrate's <stdio.h> does not define the XSI P_tmpdir macro. */
+#ifndef P_tmpdir
+#define P_tmpdir "/tmp"
+#endif
 #ifdef HAVE_SYS_IOCTL_H
 #include <sys/ioctl.h>
 #endif
