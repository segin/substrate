# Cross-compile answers for pkg-config's bundled (internal) glib subconfigure.
# glib probes these with AC_TRY_RUN, which can't execute an i386-substrate
# binary on the build host, so seed them here.  Values match substrate's
# i386 SysV ABI (downward-growing stack, no symbol underscore prefix, glibc-
# shaped POSIX *_r reentrant functions, C99 printf).
glib_cv_long_long_format=${glib_cv_long_long_format=ll}
glib_cv_stack_grows=${glib_cv_stack_grows=no}
glib_cv_uscore=${glib_cv_uscore=no}
glib_cv_have_strlcpy=${glib_cv_have_strlcpy=no}
glib_cv_va_val_copy=${glib_cv_va_val_copy=yes}
glib_cv_rtldglobal_broken=${glib_cv_rtldglobal_broken=no}
glib_cv_sane_realloc=${glib_cv_sane_realloc=yes}
glib_cv_have_qsort_r=${glib_cv_have_qsort_r=no}
glib_cv_hasinline=${glib_cv_hasinline=yes}
glib_cv_func_printf_unix98=${glib_cv_func_printf_unix98=yes}
glib_cv_func_vsnprintf_c99=${glib_cv_func_vsnprintf_c99=yes}
ac_cv_func_posix_getpwuid_r=${ac_cv_func_posix_getpwuid_r=yes}
ac_cv_func_posix_getgrgid_r=${ac_cv_func_posix_getgrgid_r=yes}
ac_cv_func_nonposix_getpwuid_r=${ac_cv_func_nonposix_getpwuid_r=no}
ac_cv_func_nonposix_getgrgid_r=${ac_cv_func_nonposix_getgrgid_r=no}
