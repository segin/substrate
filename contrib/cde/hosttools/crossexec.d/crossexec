#!/bin/bash
# crossexec for the substrate target: runs a cross-compiled binary inside a
# headless qemu boot of a private copy of the substrate root image (read-only
# via per-drive snapshot) and relays its stdout + exit status, which travel
# via a scratch ext2 disk — NOT the serial line, which carries kernel noise.
# Used by AST iffe (IFFEFLAGS="-x linux.i386") during the dtksh cross build.
# Usage: crossexec <crosstype> <command> [arg...]
set -u
shift   # crosstype
CMD="$1"; shift || true
IMG="${SUBSTRATE_EXEC_IMG:-/tmp/sub-exec.img}"
[ -f "$IMG" ] || { echo "crossexec: $IMG missing (cp rootfs.img there + inject /root/iffe-run.sh)" >&2; exit 125; }
W=$(mktemp -d /tmp/crossexec.XXXXXX)
trap 'rm -rf "$W"' EXIT
dd if=/dev/zero of="$W/scratch.img" bs=1M count=32 status=none
/usr/bin/mke2fs -q -F -b 1024 "$W/scratch.img"
debugfs -w -R "write $CMD cmd" "$W/scratch.img" >/dev/null 2>&1
{ printf '%s ' "$@"; } > "$W/args"
debugfs -w -R "write $W/args args" "$W/scratch.img" >/dev/null 2>&1
timeout 90 qemu-system-i386 -cpu qemu32,+sse,+sse2,+rdrand -accel kvm \
  -kernel "${SUBSTRATE_KERNEL:-$(dirname "$0")/../../../../sys/kernel.multiboot}" -m 256M -display none -no-reboot \
  -device ahci,id=ahci0 \
  -drive file="$IMG",format=raw,if=none,id=rd,snapshot=on,file.locking=off \
  -device ide-hd,drive=rd,bus=ahci0.0 \
  -drive file="$W/scratch.img",format=raw,if=none,id=sd \
  -device ide-hd,drive=sd,bus=ahci0.1 \
  -serial file:"$W/ser.txt" \
  -append "serial_debug root=/dev/storage/sata0 init=/root/iffe-run.sh" &
QP=$!
for i in $(seq 1 80); do
  grep -qa '@@IFFE-RC@@' "$W/ser.txt" 2>/dev/null && break
  sleep 1
done
sleep 1
kill -9 $QP 2>/dev/null; wait $QP 2>/dev/null
# results come back over serial: payload lines carry the @@IFFE@@ prefix,
# the exit status rides @@IFFE-RC@@; kernel serial noise has neither.
if ! grep -qa '@@IFFE-RC@@' "$W/ser.txt" 2>/dev/null; then
    K=/tmp/crossexec-fail.$$
    cp -a "$W" "$K" 2>/dev/null
    cp -f "$CMD" "$K/cmd.host" 2>/dev/null
    echo "crossexec: guest run failed (evidence: $K)" >&2
    exit 124
fi
tr -d '\r' < "$W/ser.txt" | sed -n 's/^@@IFFE@@//p'
RC=$(tr -d '\r' < "$W/ser.txt" | sed -n 's/^@@IFFE-RC@@\([0-9]*\).*/\1/p' | head -1)
exit "${RC:-124}"
