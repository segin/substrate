Subject: drop sbrk(2) use — substrate has no sbrk

e2fsprogs's resource-tracking (init/print_resource_track) calls
sbrk(0) unconditionally to estimate memory use.  Substrate's libc
provides no sbrk(2).  Replace sbrk(0) with a null pointer; the only
effect is that the diagnostic "Memory used" figure reads 0.  Check
and resize functionality is unaffected.

--- a/e2fsck/util.c
+++ b/e2fsck/util.c
@@ -375,7 +375,7 @@
 #endif
 	io_stats io_start = 0;
 
-	track->brk_start = sbrk(0);
+	track->brk_start = ((void *)0);
 	gettimeofday(&track->time_start, 0);
 #ifdef HAVE_GETRUSAGE
 #ifdef sun
@@ -441,7 +441,7 @@
 	} else
 #elif defined HAVE_MALLINFO
 	/* don't use mallinfo() if over 2GB used, since it returns "int" */
-	if ((unsigned long)((char *)sbrk(0) - (char *)track->brk_start) <
+	if ((unsigned long)((char *)((void *)0) - (char *)track->brk_start) <
 	    2UL << 30) {
 		struct mallinfo	malloc_info = mallinfo();
 
@@ -452,7 +452,7 @@
 	} else
 #endif
 	log_out(ctx, _("Memory used: %lluk, "),
-		kbytes(((char *)sbrk(0)) - ((char *)track->brk_start)));
+		kbytes(((char *)((void *)0)) - ((char *)track->brk_start)));
 
 #ifdef HAVE_GETRUSAGE
 	getrusage(RUSAGE_SELF, &r);
