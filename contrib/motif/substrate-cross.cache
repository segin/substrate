# Cross-compile AC_TRY_RUN seeds for OpenMotif 2.3.8 on substrate (i386 SysV).
# Add entries as configure reports "cannot check X when cross compiling".
ac_cv_func_setpgrp_void=${ac_cv_func_setpgrp_void=yes}
ac_cv_func_malloc_0_nonnull=${ac_cv_func_malloc_0_nonnull=yes}
ac_cv_func_realloc_0_nonnull=${ac_cv_func_realloc_0_nonnull=yes}
ac_cv_func_memcmp_working=${ac_cv_func_memcmp_working=yes}
ac_cv_func_mmap_fixed_mapped=${ac_cv_func_mmap_fixed_mapped=yes}
ac_cv_sys_restartable_syscalls=${ac_cv_sys_restartable_syscalls=yes}
ac_cv_func_getpgrp_void=${ac_cv_func_getpgrp_void=yes}
ac_cv_c_bigendian=${ac_cv_c_bigendian=no}
xorg_cv_malloc0_returns_null=${xorg_cv_malloc0_returns_null=no}
