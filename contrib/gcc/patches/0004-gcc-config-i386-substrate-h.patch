Subject: gcc/config/i386/substrate.h: new i386-specific header

Per-arch glue: GLIBC_DYNAMIC_LINKER points at /sbin/ld.so (where the substrate kernel finds the dynamic linker), LINK_EMULATION is elf_i386_substrate (matching the binutils ld emulation), and STARTFILE_SPEC / ENDFILE_SPEC pull crt0.o + crti.o/crtn.o + crtbegin/crtend from the standard /usr/lib paths.

---
diff --git a/gcc/config/i386/substrate.h b/gcc/config/i386/substrate.h
new file mode 100644
--- /dev/null
+++ b/gcc/config/i386/substrate.h
@@ -0,0 +1,54 @@
+/* Substrate OS — i386-specific specs (link, startfile, dynamic linker).
+   Layered on top of i386/unix.h, i386/att.h, elfos.h, glibc-stdint.h,
+   and the common substrate.h header (see gcc/config.gcc).  */
+
+#ifndef GCC_I386_SUBSTRATE_H
+#define GCC_I386_SUBSTRATE_H
+
+/* Dynamic linker.  This is the path stamped into PT_INTERP for every
+   non-static binary; it must match the install location of
+   sbin/ld.so in the substrate rootfs.  */
+#define GLIBC_DYNAMIC_LINKER "/sbin/ld.so"
+
+#undef  LINK_EMULATION
+#define LINK_EMULATION "elf_i386_substrate"
+
+#undef  ASM_SPEC
+#define ASM_SPEC "--32 %{msse2avx:-msse2avx}"
+
+#undef  LINK_SPEC
+#define LINK_SPEC                                                       \
+  "-m " LINK_EMULATION " "                                              \
+  "%{shared:-shared} "                                                  \
+  "%{!shared:                                                           \
+    %{!static:                                                          \
+      %{rdynamic:-export-dynamic}                                       \
+      -dynamic-linker " GLIBC_DYNAMIC_LINKER "}                         \
+    %{static:-static}}"
+
+/* startfile / endfile specs — mirror the substrate userland layout.
+   Substrate's crt0.o + crt1.o live in lib/c/ at build time and are
+   installed as /usr/lib/crt0.o (the entry point) and the standard
+   crti.o / crtn.o sandwich (we install plain init/fini stubs as
+   crti.o and crtn.o for now).  */
+#undef  STARTFILE_SPEC
+#define STARTFILE_SPEC                                                  \
+  "%{!shared:                                                           \
+     %{!nostartfiles:                                                   \
+       %{pg:gcrt0.o%s;:crt0.o%s}                                        \
+       crti.o%s                                                         \
+       %{static:crtbeginT.o%s;shared|pie:crtbeginS.o%s;:crtbegin.o%s}}}"
+
+#undef  ENDFILE_SPEC
+#define ENDFILE_SPEC                                                    \
+  "%{!nostartfiles:                                                     \
+     %{shared|pie:crtendS.o%s;:crtend.o%s}                              \
+     crtn.o%s}"
+
+/* Don't emit a no-execute-stack section by default — substrate's
+   exec path doesn't read GNU_STACK yet, and emitting it would just
+   bloat every object. */
+#undef  TARGET_ASM_FILE_END
+#define TARGET_ASM_FILE_END file_end_indicate_exec_stack
+
+#endif /* GCC_I386_SUBSTRATE_H */
