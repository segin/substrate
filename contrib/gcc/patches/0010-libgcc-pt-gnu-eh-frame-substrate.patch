Subject: libgcc/gcc: enable PT_GNU_EH_FRAME unwinding + shared libgcc for substrate

C++ exceptions could not unwind across shared-library boundaries on
substrate: each module statically linked libgcc with its own
__register_frame_info registry, and libgcc never used dl_iterate_phdr to
find another DSO's .eh_frame.  A throw inside a .so therefore reached
std::terminate -> abort instead of the caller's catch.

Four changes mirror what a stock GNU/Linux toolchain does:

 * libgcc/unwind-dw2-fde-dip.c, libgcc/crtstuff.c: define
   USE_PT_GNU_EH_FRAME for __substrate__ so the DWARF unwinder locates
   each loaded object's PT_GNU_EH_FRAME via dl_iterate_phdr(3) (provided
   by substrate's ld.so + libc) and crtbegin stops using the per-module
   frame registry.
 * gcc/config/i386/substrate.h: pass --eh-frame-hdr so ld emits the
   PT_GNU_EH_FRAME segment the unwinder reads.
 * gcc/config.gcc: add t-slibgcc to the driver tmake_file so g++ links
   the shared libgcc_s.so (one unwinder/registry across all modules) and
   honours -shared-libgcc.

--- a/gcc/config/i386/substrate.h
+++ b/gcc/config/i386/substrate.h
@@ -19,6 +19,7 @@
 #undef  LINK_SPEC
 #define LINK_SPEC                                                       \
   "-m " LINK_EMULATION " "                                              \
+  "--eh-frame-hdr "                                                     \
   "%{shared:-shared} "                                                  \
   "%{!shared:                                                           \
     %{!static:                                                          \
--- a/libgcc/unwind-dw2-fde-dip.c
+++ b/libgcc/unwind-dw2-fde-dip.c
@@ -83,6 +83,10 @@
 # define USE_PT_GNU_EH_FRAME
 #endif
 
+#if !defined(inhibit_libc) && defined(__substrate__)
+# define USE_PT_GNU_EH_FRAME
+#endif
+
 #if defined(USE_PT_GNU_EH_FRAME)
 
 #include <link.h>
--- a/libgcc/crtstuff.c
+++ b/libgcc/crtstuff.c
@@ -85,6 +85,10 @@
 #define BSD_DL_ITERATE_PHDR_AVAILABLE
 #endif
 
+#if !defined(inhibit_libc) && defined(__substrate__)
+# define USE_PT_GNU_EH_FRAME
+#endif
+
 #if defined(OBJECT_FORMAT_ELF) \
     && !defined(OBJECT_FORMAT_FLAT) \
     && defined(HAVE_LD_EH_FRAME_HDR) \
--- a/gcc/config.gcc
+++ b/gcc/config.gcc
@@ -2040,7 +2040,7 @@
 	# i386/substrate.h carries the i386-specific link/specs glue
 	# (dynamic linker is /sbin/ld.so, crt0 is in /usr/lib).
 	tm_file="${tm_file} i386/unix.h i386/att.h elfos.h glibc-stdint.h substrate.h i386/substrate.h"
-	tmake_file="${tmake_file} i386/t-crtstuff"
+	tmake_file="${tmake_file} i386/t-crtstuff t-slibgcc"
 	gas=yes
 	gnu_ld=yes
 	;;
