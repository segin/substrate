From: substrate
Subject: fb: widen NULL guards to also reject low-memory junk pointers

Patches 0013 and 0015 guard against literally-NULL src/dst pointers,
but the actual crash hits with src/dst at 0x00001000 — a non-NULL but
manifestly-junk address (the first 64 KiB are never legitimate
pixmap storage on substrate; every PixmapRec.devPrivate.ptr comes
from malloc and lives well above that).

Widen the guards in fbBlt / fbCopyNtoN / fbFill / fbSolidBoxClipped
to reject anything below 0x10000.  Trap details for the bug this
fixes:
    TRAP: pid=44 (Xfbdev) exception 14 -> signal 11 code 1
          addr 0x00001000 eip=0x080C1471
which resolved to fb/fbblt.c:99 MEMCPY_WRAPPED in the inlined memcpy
that writes through dst_byte.

--- a/fb/fbblt.c
+++ b/fb/fbblt.c
@@ -57,15 +57,22 @@ fbBlt(FbBits * srcLine,
     Bool destInvarient;
     int startbyte, endbyte;

-    if (!srcLine || !dstLine) {
+    /* Reject NULL and low-memory junk pointers (< 64 KiB).  All legit
+     * pixmap backings come from malloc and live above that. */
+#define FBBLT_VALID_PTR(p) ((uintptr_t)(p) >= 0x10000)
+    if (!FBBLT_VALID_PTR(srcLine) || !FBBLT_VALID_PTR(dstLine)) {
         static int warned = 0;
         if (!warned) {
             warned = 1;
-            ErrorF("fbBlt: NULL %s drawable (src=%p dst=%p w=%d h=%d bpp=%d) "
-                   ...
+            ErrorF("fbBlt: bogus %s drawable (src=%p dst=%p w=%d h=%d bpp=%d) "
+                   "— likely a font/pixmap with no bits; skipping.\n",
+                   !FBBLT_VALID_PTR(srcLine) ? "src" : "dst",
+                   (void *)srcLine, (void *)dstLine, width, height, bpp);
         }
         return;
     }
+#undef FBBLT_VALID_PTR

--- a/fb/fbcopy.c
+++ b/fb/fbcopy.c
@@ -55,11 +55,12 @@ fbCopyNtoN(...)
-    if (!src || !dst) {
+    if ((uintptr_t)src < 0x10000 || (uintptr_t)dst < 0x10000) {
         ...
     }

--- a/fb/fbfill.c
+++ b/fb/fbfill.c
@@ -37,7 +37,7 @@ fbFill(...)
-    if (!dst) {
+    if ((uintptr_t)dst < 0x10000) {
         ...
     }
@@ -178,7 +178,7 @@ fbSolidBoxClipped(...)
-    if (!dst) {
+    if ((uintptr_t)dst < 0x10000) {
         ...
     }
