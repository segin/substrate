From: substrate
Subject: kdrive: wire up -zap to the XKB terminate option

Upstream kdrive sets `kdAllowZap = TRUE` when `-zap` is on the
command line but no code path ever reads it.  Ctrl+Alt+Backspace
therefore does nothing.

For the chord to actually trigger XkbSA_Terminate → GiveUp(), the
XKB keymap has to have the `terminate:ctrl_alt_bksp` option enabled.
xfree86 does it through xorg.conf's ServerFlags or implicit defaults;
kdrive needs an explicit hookup.

Patch KdNewKeyboard: when kdAllowZap is set, append
"terminate:ctrl_alt_bksp" to the keyboard's xkbOptions (preserving
any existing default).  Auto-applies to substrate's default
evdev-keyboard fallback (0012) and any user-supplied -keybd line.

--- a/hw/kdrive/src/kinput.c
+++ b/hw/kdrive/src/kinput.c
@@ -889,7 +889,28 @@ KdNewKeyboard(void)
     ki->xkbModel = strdup(XKB_DFLT_MODEL);
     ki->xkbLayout = strdup(XKB_DFLT_LAYOUT);
     ki->xkbVariant = strdup(XKB_DFLT_VARIANT);
-    ki->xkbOptions = strdup(XKB_DFLT_OPTIONS);
+    /* If -zap was passed on the command line, wire up the XKB
+     * `terminate:ctrl_alt_bksp` option so Ctrl+Alt+Backspace actually
+     * binds to XkbSA_Terminate and reaches XkbDDXTerminateServer.
+     * Upstream kdrive sets kdAllowZap but never reads it — this is
+     * the missing piece. */
+    if (kdAllowZap) {
+        const char *base = XKB_DFLT_OPTIONS ? XKB_DFLT_OPTIONS : "";
+        size_t blen = strlen(base);
+        const char *sep = (blen > 0) ? "," : "";
+        const char *zap_opt = "terminate:ctrl_alt_bksp";
+        size_t total = blen + strlen(sep) + strlen(zap_opt) + 1;
+        char *opts = malloc(total);
+        if (opts) {
+            snprintf(opts, total, "%s%s%s", base, sep, zap_opt);
+            ki->xkbOptions = opts;
+        } else {
+            ki->xkbOptions = strdup(XKB_DFLT_OPTIONS);
+        }
+    } else {
+        ki->xkbOptions = strdup(XKB_DFLT_OPTIONS);
+    }

     return ki;
 }
