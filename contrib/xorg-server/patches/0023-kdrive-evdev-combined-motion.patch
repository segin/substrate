+        int wf = flags | (wheel > 0 ? KD_BUTTON_4 : KD_BUTTON_5);
+        KdEnqueuePointerEvent(pi, wf, 0, 0, 0);
+        KdEnqueuePointerEvent(pi, flags, 0, 0, 0);
+    }
 
     for (i = 0; i <= ke->max_rel; i++)
-        if (ke->rel[i]) {
-            int a;
+        ke->rel[i] = 0;
 
-            for (a = 0; a <= ke->max_rel; a++) {
-                if (ISBITSET(ke->relbits, a)) {
