From: substrate
Subject: kdrive: auto-probe /dev/input/event[0-7] and classify by event-type bitmap

Plain `Xfbdev vt1 -retro` launched with no -mouse/-keybd leaves
kdConfigPointers and kdConfigKeyboards empty, so KdInitInput's loops
add no devices and the X server runs without input.

Previously this fell back to hardcoding /dev/input/event0 for BOTH
pointer and keyboard.  That worked when substrate's input subsystem
multiplexed every device through a single shared event0 queue, but
it had a fatal bug: mouse BTN_LEFT events (code 0x110) reached the
keyboard fd, where KdEnqueueKeyboardEvent truncated the code field
to `unsigned char scan_code` -- turning mouse button presses into
q/w/e keypresses.

Substrate's kernel gives each input device its own /dev/input/eventN
with a per-device event-type bitmap.  Probe event0..event7, read the
EVIOCGBIT(0, ...) bitmap on each, and assign:

  - First device whose caps include EV_REL  -> pointer
  - First device whose caps include EV_KEY but NOT EV_REL  -> keyboard

If no probe matches (no devices, or all fail), fall through to
/dev/input/event0 for both -- harmless on a sane kernel.

Anyone who *does* pass -mouse/-keybd keeps full control: the
auto-probe only fires when the config-device lists are empty.

substrate isn't Linux, so the patch uses substrate's <sys/input.h>
for EV_* / BTN_* / REL_* / EVIOCGBIT and never reaches for
<linux/input.h>.

--- a/hw/kdrive/src/kinput.c
+++ b/hw/kdrive/src/kinput.c
@@ -34,6 +34,9 @@
 #endif
 #include <signal.h>
 #include <stdio.h>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/input.h>
 #ifdef sun
 #include <sys/file.h>           /* needed for FNONBLOCK & FASYNC */
 #endif
@@ -1264,6 +1267,52 @@
 
     kdInputEnabled = TRUE;
 
+    /* substrate default: if the user didn't pass -mouse / -keybd,
+     * probe /dev/input/event[0-7] and route the first EV_REL device
+     * to the pointer side and the first EV_KEY-only device to the
+     * keyboard side.  The kernel's input subsystem gives each device
+     * its own evdev node with a per-device capability bitmap, so
+     * classification by capability is reliable.
+     *
+     * Without this, kdConfigPointers and kdConfigKeyboards are empty
+     * and the X server runs deviceless. */
+    if (!kdConfigPointers || !kdConfigKeyboards) {
+        char ptr_path[64] = { 0 };
+        char kbd_path[64] = { 0 };
+        int ev;
+        for (ev = 0; ev < 8; ev++) {
+            char path[64];
+            snprintf(path, sizeof(path), "/dev/input/event%d", ev);
+            int fd = open(path, O_RDONLY | O_NONBLOCK);
+            if (fd < 0)
+                continue;
+            unsigned char evbits[4] = { 0 };
+            int n = ioctl(fd, EVIOCGBIT(0, sizeof(evbits)), evbits);
+            close(fd);
+            if (n < 0)
+                continue;
+            int has_rel = (evbits[0] >> EV_REL) & 1;
+            int has_key = (evbits[0] >> EV_KEY) & 1;
+            if (has_rel && !ptr_path[0]) {
+                strncpy(ptr_path, path, sizeof(ptr_path) - 1);
+            } else if (has_key && !has_rel && !kbd_path[0]) {
+                strncpy(kbd_path, path, sizeof(kbd_path) - 1);
+            }
+        }
+        if (!kdConfigPointers) {
+            char line[96];
+            const char *p = ptr_path[0] ? ptr_path : "/dev/input/event0";
+            snprintf(line, sizeof(line), "evdev,,device=%s", p);
+            KdAddConfigPointer(line);
+        }
+        if (!kdConfigKeyboards) {
+            char line[96];
+            const char *p = kbd_path[0] ? kbd_path : "/dev/input/event0";
+            snprintf(line, sizeof(line), "evdev,,device=%s", p);
+            KdAddConfigKeyboard(line);
+        }
+    }
+
     for (dev = kdConfigPointers; dev; dev = dev->next) {
         pi = KdParsePointer(dev->line);
         if (!pi)
