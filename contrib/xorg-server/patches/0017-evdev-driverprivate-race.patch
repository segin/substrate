From: substrate
Subject: kdrive/evdev: fix driverPrivate race between RegisterFd + assignment

First-client-connect SIGSEGV pinned to evdev.c's
`ke->rel[events[i].code] += events[i].value;` at CR2=0x00000000 --
`ke = pi->driverPrivate` came in NULL.

EvdevPtrEnable installs in the wrong order:

    if (!KdRegisterFd(fd, EvdevPtrRead, pi))   /* fd live NOW */
        ...;
    pi->driverPrivate = ke;                    /* set LATER */

The moment KdRegisterFd returns the fd is in the X server's select
set.  If a mouse event has already been queued (substrate's poll()
repolls every ~10 ms during boot), KdWakeupHandler can dispatch
EvdevPtrRead with closure=pi BEFORE the `pi->driverPrivate = ke`
store completes.  EvdevPtrRead dereferences pi->driverPrivate ->
0x0 and the server dies.

Two fixes:

1. Install pi->driverPrivate BEFORE KdRegisterFd in EvdevPtrEnable.

2. NULL-guard EvdevPtrRead defensively -- even with the ordering
   fix, EvdevPtrDisable clears driverPrivate, and a wakeup already
   in flight at that point can still arrive at EvdevPtrRead with a
   stale closure.  Also reject low-junk pointers (< 0x10000) which
   have shown up after failed grab/ungrab cycles.  Drain the read
   so the fd is at least quiesced.

--- a/hw/kdrive/linux/evdev.c
+++ b/hw/kdrive/linux/evdev.c
@@ -154,11 +154,27 @@
 EvdevPtrRead(int evdevPort, void *closure)
 {
     KdPointerInfo *pi = closure;
-    Kevdev *ke = pi->driverPrivate;
+    Kevdev *ke;
     int i;
     struct input_event events[NUM_EVENTS];
     int n;
 
+    /* Defensive -- see EvdevPtrEnable's note about install ordering.
+     * Even with the ordering fix, EvdevPtrDisable may have cleared
+     * driverPrivate while a pending wakeup was still in flight.
+     *
+     * Substrate-specific: pi->driverPrivate has been observed coming
+     * back as a low-junk pointer (e.g. 0x343E) after the X server's
+     * evdev grab/ungrab dance fails.  Treat any pointer below 0x10000
+     * the same as NULL -- there's nothing user-mappable in the first
+     * 64 KiB of the address space, so anything that small is junk. */
+    ke = pi ? pi->driverPrivate : NULL;
+    if (!pi || (uintptr_t)ke < 0x10000) {
+        char drain[64];
+        (void)read(evdevPort, drain, sizeof(drain));
+        return;
+    }
+
     n = read(evdevPort, &events, NUM_EVENTS * sizeof(struct input_event));
     if (n <= 0) {
         if (errno == ENODEV)
@@ -297,13 +313,20 @@
             return BadValue;
         }
     }
+    /* IMPORTANT: install driverPrivate BEFORE KdRegisterFd.  The fd
+     * is in the select set the moment KdRegisterFd returns, so an
+     * input event arriving in the window between RegisterFd and
+     * pi->driverPrivate = ke (a handful of instructions, but real
+     * on a busy boot) lands in EvdevPtrRead with driverPrivate==NULL
+     * and crashes the server at `ke->rel[...]`. */
+    ke->fd = fd;
+    pi->driverPrivate = ke;
     if (!KdRegisterFd(fd, EvdevPtrRead, pi)) {
+        pi->driverPrivate = NULL;
         free(ke);
         close(fd);
         return BadAlloc;
     }
-    pi->driverPrivate = ke;
-    ke->fd = fd;
 
     return Success;
 }
