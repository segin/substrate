%% array of lines, skel_NAME, in skel.h; codegen.c writes them out in
%% order around the parts it generates.  Lines starting with "%%" are
%% comments or section headers and are not copied.
%%
%% section prologue
/* Generated by lex */
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

/* Prototypes */
int yylex(void);
int yywrap(void);
int yy_do_action(int rule);

#define ECHO fwrite(yytext, yyleng, 1, yyout)
#define BEGIN yy_start =

/* Start Conditions */
#define INITIAL 0
%%
%% [generated] #define for each start condition, then the definitions
%% section's C code.
%%
%% section runtime_head
/* lex runtime */
#define YY_BUF_SIZE 65536
%%
%% [generated] yytext: an array (%array) or a pointer into the buffer.
%%
%% section runtime
int yyleng;
FILE *yyin = NULL;
FILE *yyout = NULL;
static int yy_start = 0;
static int yy_at_bol = 1;
static int yy_more_flag = 0;
static char yy_buf[YY_BUF_SIZE + 2];
static char *yy_cp = NULL, *yy_bp = NULL;
static int yy_buf_len = 0;
static char yy_hold_char;
static char *yy_c_buf_p;

static int yy_get_next_buffer(void) {
  if (yy_buf_len >= YY_BUF_SIZE) return 0;
  int c = getc(yyin);
  if (c == EOF) return 0;
  yy_buf[yy_buf_len++] = (char)c;
  yy_buf[yy_buf_len] = '\0';
  return 1;
}

void yymore(void) { yy_more_flag = 1; }

#define yyless(n) do { \
  *yy_c_buf_p = yy_hold_char; \
  yyleng = (n); \
  yy_cp = yy_bp + yyleng; \
  yy_c_buf_p = yy_cp; \
  yy_hold_char = *yy_c_buf_p; \
  *yy_c_buf_p = '\0'; \
} while(0)

int input(void) {
  if (yy_cp && yy_cp < yy_buf + yy_buf_len) return (unsigned char)*yy_cp++;
  if (yy_get_next_buffer()) {
    if (!yy_cp) yy_cp = yy_buf + yy_buf_len - 1;
    return (unsigned char)*yy_cp++;
  }
  return EOF;
}

void unput(int c) {
  if (yy_cp && yy_cp > yy_buf) {
    *--yy_cp = (char)c;
  } else {
    ungetc(c, yyin);
  }
}

%%
%% [generated] The DFA: start states, transitions and accepting rules,
%% then yy_do_action() with one case per rule.
%%
%% section yylex_head
int yylex(void) {
    int c, state;
    struct { int rule, len; } matches[1024];
    int match_ptr = 0;
    int current_match = 0;

    if (!yyin) yyin = stdin;
    if (!yyout) yyout = stdout;

    if (!yy_cp) {
        yy_cp = yy_bp = yy_buf;
        yy_buf_len = 0;
        yy_at_bol = 1;
    }

yy_restart:
    state = yy_start_state[yy_start << 1 | yy_at_bol];

    if (yy_more_flag) {
        yy_more_flag = 0;
    } else {
        yy_bp = yy_cp;
        yyleng = 0;
    }
    match_ptr = 0;

    while (1) {
        if (yy_cp < yy_buf + yy_buf_len) {
            c = (unsigned char)*yy_cp++;
        } else if (yy_get_next_buffer()) {
            c = (unsigned char)*yy_cp++;
        } else {
            c = EOF;
            break;
        }

        int next = yy_nxt[state][(unsigned char)c];
        if (next < 0) {
            yy_cp--;
            break;
        }

        state = next;
        yyleng++;

        for (int k = yy_accept_cnt[state] - 1; k >= 0; k--) {
            if (match_ptr < 1024) {
                matches[match_ptr].rule = yy_accept_rules[yy_accept_idx[state] + k];
                matches[match_ptr].len = yyleng;
                match_ptr++;
            }
        }
    }

    if (match_ptr > 0) {
        current_match = match_ptr - 1;
    yy_try_match:
        {
            int rule = matches[current_match].rule;
            int len = matches[current_match].len;
            while (yyleng > len) {
                yy_cp--;
                yyleng--;
            }

            yy_c_buf_p = yy_cp;
            yy_hold_char = *yy_c_buf_p;
            *yy_c_buf_p = '\0';
%%
%% [generated] Point yytext at the match, or copy it for %array.
%%
%% section yylex_tail
            if (yy_do_action(rule) == 1) {
                *yy_c_buf_p = yy_hold_char;
                current_match--;
                if (current_match >= 0) goto yy_try_match;
                else goto yy_no_match;
            }
            *yy_c_buf_p = yy_hold_char;
            yy_at_bol = (yy_cp > yy_bp && yy_cp[-1] == '\n') ? 1 : 0;
            goto yy_restart;
        }
    }

yy_no_match:
    if (yyleng == 0 && c == EOF) {
        if (yywrap()) return 0;
        yy_cp = yy_bp = yy_buf;
        yy_buf_len = 0;
        yy_at_bol = 1;
        goto yy_restart;
    }
    if (yy_bp < yy_buf + yy_buf_len) {
        c = (unsigned char)*yy_bp;
        putc(c, yyout);
        yy_bp++;
        yy_cp = yy_bp;
        yy_at_bol = (c == '\n');
        goto yy_restart;
    }
    return 0;
}

int yywrap(void) {
  return 1;
}
