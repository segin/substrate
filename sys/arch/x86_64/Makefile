# arch/x86_64/Makefile - the 64-bit kernel
#
# Invoked by `make -C sys ARCH=x86_64`.  Same source tree as the i386
# kernel; every object goes under obj/ here so the two builds never share
# an object file (the i386 build compiles in place).  Output:
#
#   sys/kernel-x86_64.elf   ELF64 with symbols; GRUB `multiboot2` loads it
#   sys/kernel-x86_64.bin   flat image for multiboot 1 loaders (QEMU
#                           -kernel, GRUB `multiboot`); installed as
#                           /vmunix64
#
# The machine-independent kernel is built by the subdirectory Makefiles
# with ARCH=x86_64, which Makefile.inc points at obj/<subdir>/; this
# Makefile builds the machine-dependent part and links the lot.

SYS     := $(abspath ../..)
TOP     := $(abspath $(SYS)/..)
OBJDIR  := $(SYS)/arch/x86_64/obj
KERNEL  := $(SYS)/kernel-x86_64

CC      ?= cc
LD      ?= ld
OBJCOPY ?= objcopy
GCCINC  := $(shell $(CC) -print-file-name=include)

WARNFLAGS ?= -Wall -Wextra
ifneq ($(NO_WERROR),1)
WARNFLAGS += -Werror
endif

CFLAGS64 := -m64 -march=x86-64 -mcmodel=kernel -mno-red-zone \
	-mgeneral-regs-only -ffreestanding -fno-builtin -fno-stack-protector \
	-fno-pie -fno-pic -fno-asynchronous-unwind-tables \
	-fno-omit-frame-pointer -ffunction-sections -fdata-sections \
	-std=c2x $(WARNFLAGS) -g -nostdinc \
	-I$(SYS)/include -I$(TOP)/include -I$(SYS) -isystem $(GCCINC) \
	-DSUBSTRATE_ARCH_X86_64 -MMD -MP
ASFLAGS64 := -m64 -D__ASSEMBLER__ -nostdinc -I$(SYS)/include -I$(SYS) \
	-DSUBSTRATE_ARCH_X86_64 -MMD -MP
LDFLAGS64 := -m elf_x86_64 -nostdlib -z max-page-size=0x1000 -T linker.ld

# Machine-dependent sources, relative to sys/arch/x86_64.  The arch/i386
# ones are the i386 user ABI -- system-call entry, signal frames, sysarch,
# the LDT -- which 32-bit processes get unchanged on this kernel
# (docs/specs/abi-amd64.md, section 10).
ARCH_SRCS := boot/boot.S isr.S kmain.c cons.c early_boot.c gdt.c idt.c \
	pmap.c sched.c smp.c vm86.c \
	../x86-common/trap.c ../x86-common/cpu.c ../x86-common/pci.c \
	../x86-common/pmm.c ../x86-common/percpu.c ../x86-common/fpu.c \
	../x86-common/lapic.c ../x86-common/ioapic.c ../x86-common/rtc.c \
	../i386/syscall.c ../i386/signal.c ../i386/sysarch.c \
	../i386/sig_trampoline.c ../i386/ldt.c

ARCH_OBJS := $(patsubst %,$(OBJDIR)/arch/%.o,$(basename $(subst ../,,$(ARCH_SRCS))))

# Machine-independent subsystems: directory and the aggregate object its
# Makefile links (the same list sys/Makefile links for i386).
MI_DIRS := kern pm lib vm vfs fs net exec/formats exec/perso \
	drivers/video drivers/input drivers/console drivers/console/uart \
	drivers/storage drivers/usb drivers/audio drivers/devices \
	drivers/virtio drivers/net
MI_OBJS := kern/kern.o pm/pm.o lib/lib.o vm/vm.o vfs/vfs_subsys.o fs/fs.o \
	net/net.o exec/formats/exec.o exec/perso/perso.o \
	drivers/video/video.o drivers/input/input.o \
	drivers/console/console_subsys.o drivers/console/uart/uart_drv.o \
	drivers/storage/storage.o drivers/usb/usb_drv.o drivers/audio/audio_drv.o \
	drivers/devices/devices.o drivers/virtio/virtio_drv.o drivers/net/net_drv.o
MI_OBJS := $(addprefix $(OBJDIR)/,$(MI_OBJS))

# Built here rather than by a subdirectory: the build stamp and the
# no-tests stub sys/Makefile links directly.
EXTRA_OBJS := $(OBJDIR)/vers.o $(OBJDIR)/kern/tests_stub.o

.PHONY: all clean mi FORCE

all: $(KERNEL).elf $(KERNEL).bin

# The subdirectory builds decide for themselves what is out of date.
mi:
	@for d in $(MI_DIRS); do \
		$(MAKE) -C $(SYS)/$$d ARCH=x86_64 || exit 1; \
	done

$(MI_OBJS): mi

# Two passes, as for i386: the first link's symbols become the kernel's own
# symbol table (kern/ksyms.c, for stack traces), linked into the second.
$(KERNEL).elf: $(ARCH_OBJS) $(MI_OBJS) $(EXTRA_OBJS) linker.ld $(SYS)/mkksyms.py
	$(LD) $(LDFLAGS64) -o $(OBJDIR)/kernel.tmp $(ARCH_OBJS) $(MI_OBJS) $(EXTRA_OBJS)
	nm $(OBJDIR)/kernel.tmp | python3 $(SYS)/mkksyms.py > $(OBJDIR)/ksyms_table.c
	$(CC) $(CFLAGS64) -c $(OBJDIR)/ksyms_table.c -o $(OBJDIR)/ksyms_table.o
	$(LD) $(LDFLAGS64) -o $@ $(ARCH_OBJS) $(MI_OBJS) $(EXTRA_OBJS) $(OBJDIR)/ksyms_table.o

$(KERNEL).bin: $(KERNEL).elf
	$(OBJCOPY) -O binary $< $@
	@echo "Linked $(notdir $(KERNEL)).elf and $(notdir $(KERNEL)).bin"

$(OBJDIR)/arch/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS64) -c $< -o $@

$(OBJDIR)/arch/%.o: %.S
	@mkdir -p $(dir $@)
	$(CC) $(ASFLAGS64) -c $< -o $@

$(OBJDIR)/arch/x86-common/%.o: ../x86-common/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS64) -c $< -o $@

$(OBJDIR)/arch/i386/%.o: ../i386/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS64) -c $< -o $@

# The build identity for sysctl kern.version, as sys/Makefile writes it for
# i386, regenerated on every build into this kernel's own object tree.
BUILD_DATE := $(shell LC_ALL=C date -u '+%a %b %e %H:%M:%S UTC %Y')

$(OBJDIR)/vers.c: FORCE
	@mkdir -p $(dir $@)
	printf '/* Generated by sys/arch/x86_64/Makefile on every build -- do not edit. */\n#include <kern/osversion.h>\n\nchar kernel_version_long[] =\n    "Substrate " OS_OSRELEASE " (GENERIC) #0: $(BUILD_DATE)";\n' > $@

$(OBJDIR)/vers.o: $(OBJDIR)/vers.c
	$(CC) $(CFLAGS64) -c $< -o $@

$(OBJDIR)/kern/tests_stub.o: $(SYS)/kern/tests_stub.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS64) -c $< -o $@

clean:
	rm -rf $(OBJDIR) $(KERNEL).elf $(KERNEL).bin

-include $(shell find $(OBJDIR)/arch -name '*.d' 2>/dev/null)
