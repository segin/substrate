# Bochs Configuration File
# Generated by Gemini

# BIOS and VGA BIOS
romimage: file=/usr/share/bochs/BIOS-bochs-latest
vgaromimage: file=/usr/share/bochs/VGABIOS-lgpl-latest

# CPU Configuration used by Bochs
# Enable 32-bit (or 64-bit) CPU.
cpu: model=core2_penryn_t9600, count=1, ips=50000000, reset_on_triple_fault=0

# Memory
memory: guest=128, host=128

# Display
display_library: x, options="gui_debug"

# Storage
ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
# Primary Master: The Root Disk
ata0-master: type=disk, path="../root.img", mode=flat
# Primary Slave: The Kernel ISO (Bochs cannot boot plain binaries directly like QEMU)
ata0-slave: type=cdrom, path="kernel.iso", status=inserted

# Boot from CD (ISO)
boot: cdrom

# Serial Port (for kernel logs)
com1: enabled=1, mode=file, dev="/home/segin/klog_bochs"

# Logging
log: bochsout.txt
panic: action=ask
error: action=report
info: action=report
debug: action=ignore

# Debugging
magic_break: enabled=1
