+ =OUTPUT=GJ                  \s           Blank for non breaking space
+ =OUTPUT=GK                  >            Right field delimeter
+ =OUTPUT=GL                  <            Left field delimeter
+ =OUTPUT=GM                  +            Elevator character
+ =OUTPUT=GN                  !            New line character
+ =OUTPUT=GP                  #            Paragraph mark
+ =OUTPUT=GR                  .            Ruler character
+ =OUTPUT=GT                  >            Visible Tab character
+ =OUTPUT=GU                  ^            Up-tick character
